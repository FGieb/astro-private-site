---
const year = new Date().getFullYear();
---

<section class="trip-shell">
  <section class="trip-year-card">
    <div class="trip-year-header">
      <button id="tripPrevYear" type="button" class="trip-nav-btn" aria-label="Previous year">◀</button>
      <div class="trip-year-title">
        <h2 id="tripYearLabel">{year}</h2>
        <div id="tripYearStats" class="trip-year-stats"></div>
        <div id="tripLegend" class="trip-legend"></div>
      </div>
      <button id="tripNextYear" type="button" class="trip-nav-btn" aria-label="Next year">▶</button>
    </div>

    <div class="trip-month-grid" id="tripMonthGrid"></div>
  </section>

  <aside class="trip-side-card">
    <h3 id="tripFormHeading">✈️ Add a trip</h3>
    <p class="trip-hint">Tip: click a day in the calendar to set the start date, then another day for the end date.</p>

    <form class="trip-form" id="tripForm">
      <input id="tripTitle" type="text" placeholder="Trip name (e.g. Weekend in Lisbon)" required />
      <input id="tripLocation" type="text" placeholder="📍 Where (optional)" />

      <div class="trip-date-row">
        <label>
          <span>From</span>
          <input id="tripStart" type="date" required />
        </label>
        <label>
          <span>To</span>
          <input id="tripEnd" type="date" required />
        </label>
      </div>

      <div class="trip-who-row" id="tripWhoRow" role="radiogroup" aria-label="Whose trip"></div>

      <textarea id="tripNote" placeholder="Notes (optional)"></textarea>

      <div class="trip-form-actions">
        <button type="submit" class="trip-save-btn" id="tripSaveBtn">Save trip</button>
        <button type="button" class="trip-secondary-btn" id="tripCancelBtn" hidden>Cancel</button>
        <button type="button" class="trip-delete-btn" id="tripDeleteBtn" hidden>Delete</button>
      </div>
    </form>

    <h3 class="trip-list-heading" id="tripListHeading">Trips</h3>
    <div class="trip-list" id="tripList"></div>
  </aside>
</section>

<section class="trip-map-card">
  <div class="trip-map-header">
    <div>
      <h3>🗺️ Where we've been</h3>
      <div class="trip-map-stats" id="tripMapStats"></div>
    </div>
    <div class="trip-map-toggle" role="tablist">
      <button type="button" class="active" data-scope="year" id="tripMapYearBtn">This year</button>
      <button type="button" data-scope="all">All years</button>
    </div>
  </div>
  <div class="trip-map" id="tripMap"></div>
  <div class="trip-map-note" id="tripMapNote"></div>
</section>

<style is:global>
  .trip-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .trip-year-card,
  .trip-side-card {
    background: #0f0f0f;
    border: 1px solid #1f1f1f;
    border-radius: 1.25rem;
    padding: 1.5rem;
  }

  .trip-year-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .trip-year-title { text-align: center; }
  .trip-year-title h2 { margin: 0; font-size: 1.8rem; }
  .trip-year-stats { font-size: 0.85rem; opacity: 0.65; margin-top: 0.2rem; }

  .trip-month-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }

  .trip-month h4 {
    margin: 0 0 0.4rem 0;
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.85;
  }

  .trip-mini-weekdays,
  .trip-mini-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }

  .trip-mini-weekdays div {
    font-size: 0.65rem;
    opacity: 0.45;
    text-align: center;
  }

  .trip-day {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    border-radius: 0.35rem;
    background: #181818;
    color: rgba(255,255,255,0.8);
    border: none;
    padding: 0;
    cursor: pointer;
    position: relative;
  }

  .trip-day:hover { background: #2a2a2a; }
  .trip-day.empty { background: transparent; cursor: default; }
  .trip-day.today { outline: 2px solid rgba(255,255,255,0.85); outline-offset: 1px; z-index: 1; }
  .trip-day.in-trip { color: white; font-weight: 700; text-shadow: 0 1px 2px rgba(0,0,0,0.35); }
  .trip-day .trip-start-icon { font-size: 0.95rem; line-height: 1; text-shadow: none; }

  /* Shared trips: champagne metal with a slow light sweep. The sweep layer is
     fixed to the viewport so one band of light glides across all shared days. */
  .trip-metal { background: linear-gradient(145deg, #efe2c2 0%, #cdb98f 45%, #b29c6a 100%); }

  .trip-day.shared {
    color: #2a2010;
    font-weight: 800;
    text-shadow: none;
    background:
      linear-gradient(110deg, transparent 46%, rgba(255, 250, 235, 0.85) 50%, transparent 54%),
      linear-gradient(145deg, #efe2c2 0%, #cdb98f 45%, #b29c6a 100%);
    background-attachment: fixed, scroll;
    background-size: 300% 100%, 100% 100%;
    background-position: 100% 0, 0 0;
    animation: trip-shimmer 3.5s ease-in-out infinite;
  }

  .trip-day.shared:hover { filter: brightness(1.08); }

  @keyframes trip-shimmer {
    0% { background-position: 100% 0, 0 0; }
    45%, 100% { background-position: 0% 0, 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .trip-day.shared { animation: none; }
  }

  .trip-day.multi::after {
    content: "";
    position: absolute;
    top: 2px; right: 2px;
    width: 5px; height: 5px;
    border-radius: 999px;
    background: white;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.5);
  }
  .trip-day.pending {
    outline: 2px dashed white;
    outline-offset: 1px;
    z-index: 1;
  }
  .trip-day.focused { box-shadow: inset 0 0 0 2px white, inset 0 0 0 3px rgba(0,0,0,0.55); }

  .trip-hint { font-size: 0.8rem; opacity: 0.6; margin: 0 0 1rem 0; }

  .trip-form { display: flex; flex-direction: column; gap: 0.75rem; }

  .trip-form input,
  .trip-form textarea {
    padding: 0.55rem 0.7rem;
    font-size: 0.95rem;
  }

  .trip-form textarea { min-height: 70px; resize: vertical; }

  .trip-date-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .trip-date-row label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8rem;
    opacity: 0.85;
  }

  .trip-legend {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    opacity: 0.85;
  }

  .trip-legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .trip-legend i {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 3px;
  }

  .trip-who-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem;
  }

  .trip-who {
    padding: 0.5rem 0.4rem;
    border-radius: 0.6rem;
    border: 2px solid transparent;
    background: #1a1a1a;
    color: white;
    font-size: 0.85rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .trip-who i {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 999px;
  }

  .trip-who.selected { border-color: white; background: #262626; font-weight: 700; }

  .trip-item-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    margin-left: 0.35rem;
    vertical-align: middle;
    color: white;
  }

  .trip-item-tag.trip-metal { color: #2a2010; }

  .trip-form-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .trip-delete-btn { margin-left: auto; color: #ff8a8a; }

  .trip-list-heading { margin: 1.5rem 0 0.75rem 0; }

  .trip-item {
    display: flex;
    gap: 0.7rem;
    padding: 0.7rem;
    border: 1px solid #242424;
    border-radius: 0.75rem;
    background: #141414;
    margin-bottom: 0.5rem;
    cursor: pointer;
  }

  .trip-item:hover { border-color: #3a3a3a; }
  .trip-item.active { border-color: white; }

  .trip-swatch {
    width: 6px;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .trip-item-title { font-weight: 700; }
  .trip-item-meta { font-size: 0.82rem; opacity: 0.7; margin-top: 0.15rem; }
  .trip-item-note { font-size: 0.85rem; margin-top: 0.35rem; opacity: 0.9; white-space: pre-wrap; }

  .trip-memories {
    margin-top: 0.6rem;
    padding-top: 0.55rem;
    border-top: 1px solid #262626;
    font-size: 0.83rem;
  }
  .trip-memories-title { font-weight: 700; opacity: 0.85; margin-bottom: 0.35rem; }
  .trip-memory { margin-bottom: 0.3rem; line-height: 1.35; }
  .trip-memory-date { opacity: 0.55; margin-right: 0.35rem; white-space: nowrap; }
  .trip-memory-note { opacity: 0.7; }
  .trip-memories-empty { opacity: 0.55; }

  @media (max-width: 1000px) {
    .trip-shell { grid-template-columns: 1fr; }
  }

  .trip-map-card {
    margin-top: 2rem;
    background: #0f0f0f;
    border: 1px solid #1f1f1f;
    border-radius: 1.25rem;
    padding: 1.5rem;
  }
  .trip-map-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .trip-map-header h3 { margin: 0; }
  .trip-map-stats { font-size: 0.85rem; opacity: 0.7; margin-top: 0.25rem; }
  .trip-map-toggle {
    display: inline-flex;
    gap: 0.2rem;
    padding: 0.25rem;
    background: #1a1a1a;
    border-radius: 999px;
  }
  .trip-map-toggle button {
    background: transparent;
    border: none;
    color: white;
    opacity: 0.7;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .trip-map-toggle button.active { background: #2e2e2e; opacity: 1; font-weight: 600; }
  .trip-map {
    height: 420px;
    border-radius: 0.9rem;
    overflow: hidden;
    background: #111;
  }
  .trip-map.leaflet-container { background: #0d0f12; }
  /* Turn the light OpenStreetMap tiles into a dark map; pins are unaffected */
  .trip-map .leaflet-tile-pane {
    filter: invert(1) hue-rotate(180deg) brightness(0.85) contrast(0.9) saturate(0.35);
  }
  .trip-map-note { font-size: 0.8rem; opacity: 0.6; margin-top: 0.6rem; min-height: 1em; }
  .trip-map .leaflet-popup-content-wrapper,
  .trip-map .leaflet-popup-tip { background: #161616; color: white; }
  .trip-map .leaflet-popup-content { margin: 0.6rem 0.8rem; font-size: 0.85rem; }
  .trip-map .leaflet-container a { color: #9cc7ff; }

  @media (max-width: 600px) {
    .trip-map { height: 320px; }
  }

  @media (max-width: 600px) {
    .trip-month-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script type="module" is:inline>
(async () => {
  // Whose trip it is decides its colour. Rename the labels here if you like.
  const WHO = {
    shared: { label: "Shared", icon: "🖤", color: "#cdb98f" },
    LM: { label: "LM solo", icon: "🐝", color: "#2f9e6e" },
    BM: { label: "BM solo", icon: "🐙", color: "#2e7fb8" },
    // Someone came to stay with us: not a trip away, so it doesn't count as days away
    visitors: { label: "Visitors", icon: "🏡", color: "#8a63c9", atHome: true },
  };
  // Trips saved before "who" existed count as shared
  const whoOf = (t) => (WHO[t.who] ? t.who : "shared");
  const colorOf = (t) => WHO[whoOf(t)].color;
  // Swatch markup: shared gets the metallic class, solo trips a flat colour
  const swatchAttrs = (key) => key === "shared"
    ? `class="trip-metal"` : `style="background:${WHO[key].color}"`;
  const MONTHS = Array.from({ length: 12 }, (_, m) =>
    new Date(2000, m, 1).toLocaleString("default", { month: "long" }));

  const $ = (id) => document.getElementById(id);
  const monthGrid = $("tripMonthGrid");
  const yearLabel = $("tripYearLabel");
  const yearStats = $("tripYearStats");
  const form = $("tripForm");
  const titleInput = $("tripTitle");
  const locationInput = $("tripLocation");
  const startInput = $("tripStart");
  const endInput = $("tripEnd");
  const noteInput = $("tripNote");
  const whoRow = $("tripWhoRow");
  const legend = $("tripLegend");
  const formHeading = $("tripFormHeading");
  const saveBtn = $("tripSaveBtn");
  const cancelBtn = $("tripCancelBtn");
  const deleteBtn = $("tripDeleteBtn");
  const listHeading = $("tripListHeading");
  const list = $("tripList");

  const today = new Date();
  let year = today.getFullYear();
  let trips = [];
  let memories = {}; // Memories tab entries, keyed "MM-DD" (no year)
  let editingId = null;
  let selectedWho = "shared";
  let pickingEnd = false;

  const pad = (n) => String(n).padStart(2, "0");
  const iso = (y, m, d) => `${y}-${pad(m + 1)}-${pad(d)}`;
  const todayIso = iso(today.getFullYear(), today.getMonth(), today.getDate());

  const escapeHtml = (s) => String(s ?? "").replace(/[&<>"']/g, (c) =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  const parseIso = (s) => {
    const [y, m, d] = s.split("-").map(Number);
    return new Date(y, m - 1, d);
  };

  const dayCount = (t) =>
    Math.round((parseIso(t.end) - parseIso(t.start)) / 86400000) + 1;

  const formatRange = (t) => {
    const s = parseIso(t.start);
    const e = parseIso(t.end);
    const opts = { day: "numeric", month: "short" };
    const sameYear = s.getFullYear() === e.getFullYear();
    const startStr = s.toLocaleDateString(undefined, sameYear ? opts : { ...opts, year: "numeric" });
    const endStr = e.toLocaleDateString(undefined, { ...opts, year: "numeric" });
    return t.start === t.end ? endStr : `${startStr} – ${endStr}`;
  };

  const tripsInYear = (y) =>
    trips
      .filter((t) => t.start <= `${y}-12-31` && t.end >= `${y}-01-01`)
      .sort((a, b) => a.start.localeCompare(b.start));

  const tripsOn = (dateIso, yearTrips) =>
    yearTrips.filter((t) => t.start <= dateIso && t.end >= dateIso);

  const loadTrips = async () => {
    const res = await fetch("/.netlify/functions/trips-load");
    const data = await res.json();
    trips = Array.isArray(data) ? data : [];
  };

  const loadMemories = async () => {
    const res = await fetch("/.netlify/functions/calendar-load");
    const data = await res.json();
    memories = res.ok && data && typeof data === "object" && !Array.isArray(data) ? data : {};
  };

  const MEMORY_ICONS = { note: "📝", plan: "📍", memory: "🧠", occasion: "🌟" };

  // Memories-tab entries on the days of a trip. Those entries have no year,
  // so this matches on day and month only.
  const memoriesFor = (t) => {
    const found = [];
    const end = parseIso(t.end);
    for (let d = parseIso(t.start), n = 0; d <= end && n < 366; d.setDate(d.getDate() + 1), n++) {
      const key = `${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      for (const e of Array.isArray(memories[key]) ? memories[key] : []) {
        found.push({ ...e, date: new Date(d) });
      }
    }
    return found;
  };

  const memoriesHtml = (t) => {
    const found = memoriesFor(t);
    if (!found.length) {
      return `<div class="trip-memories"><div class="trip-memories-empty">🧠 No memories on these days yet.</div></div>`;
    }
    return `
      <div class="trip-memories">
        <div class="trip-memories-title">🧠 Memories from these days</div>
        ${found.map((e) => `
          <div class="trip-memory">
            <span class="trip-memory-date">${e.date.toLocaleDateString(undefined, { day: "numeric", month: "short" })}</span>
            ${MEMORY_ICONS[e.type] || "📝"} ${escapeHtml(e.title)}
            ${e.note ? `<span class="trip-memory-note">· ${escapeHtml(e.note)}</span>` : ""}
          </div>`).join("")}
      </div>`;
  };

  // Same rule as netlify/functions/_shared/places.mjs
  const placesKey = (t) => `${t.title || ""}|${t.location || ""}`.trim().toLowerCase();
  const needsPlaces = (t) => !Array.isArray(t.places) || t.placesKey !== placesKey(t);

  // Ask the server to work out places (with AI) for trips that don't have them.
  // Runs in the background; the map picks the results up when they arrive.
  let placesRequestedAt = 0;
  const requestPlaces = () => {
    if (!trips.some(needsPlaces) || Date.now() - placesRequestedAt < 60000) return;
    placesRequestedAt = Date.now();
    fetch("/.netlify/functions/trips-places-background", { method: "POST" })
      .catch((err) => console.warn("Could not start place lookup:", err));
    watchForPlaces();
  };

  let placesTimer = null;
  const watchForPlaces = (tries = 0) => {
    clearTimeout(placesTimer);
    if (tries >= 12 || !trips.some(needsPlaces)) return;
    placesTimer = setTimeout(async () => {
      try {
        const res = await fetch("/.netlify/functions/trips-load");
        const fresh = await res.json();
        if (Array.isArray(fresh)) {
          const byId = new Map(fresh.map((t) => [t.id, t]));
          // Only take over the places, so edits made meanwhile are kept
          trips = trips.map((t) => {
            const f = byId.get(t.id);
            return f && !needsPlaces(f) && f.placesKey === placesKey(t)
              ? { ...t, places: f.places, placesKey: f.placesKey }
              : t;
          });
          renderMap();
        }
      } catch (err) {
        console.warn("Could not refresh places:", err);
      }
      watchForPlaces(tries + 1);
    }, 6000);
  };

  const saveTrips = async () => {
    const res = await fetch("/.netlify/functions/trips-save", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(trips),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data?.error || `trips-save failed with ${res.status}`);
  };

  const renderWho = () => {
    whoRow.innerHTML = Object.entries(WHO).map(([key, w]) => `
      <button type="button" class="trip-who${key === selectedWho ? " selected" : ""}"
        data-who="${key}" role="radio" aria-checked="${key === selectedWho}">
        <i ${swatchAttrs(key)}></i>${w.label}
      </button>
    `).join("");
    whoRow.querySelectorAll(".trip-who").forEach((btn) => {
      btn.onclick = () => { selectedWho = btn.dataset.who; renderWho(); };
    });
  };

  legend.innerHTML = Object.entries(WHO).map(([key, w]) =>
    `<span><i ${swatchAttrs(key)}></i>${w.label}</span>`).join("");

  // One colour per day, or a split when e.g. a shared and a solo trip overlap
  const dayBackground = (onDay) => {
    const colors = [...new Set(onDay.map(colorOf))];
    if (colors.length === 1) return colors[0];
    const step = 100 / colors.length;
    return `linear-gradient(135deg, ${colors.map((c, i) =>
      `${c} ${i * step}% ${(i + 1) * step}%`).join(", ")})`;
  };

  const renderYear = () => {
    yearLabel.textContent = year;
    const yearTrips = tripsInYear(year);

    let daysAway = 0;
    const html = MONTHS.map((name, m) => {
      const first = new Date(year, m, 1);
      const offset = (first.getDay() + 6) % 7;
      const days = new Date(year, m + 1, 0).getDate();

      let cells = "";
      for (let i = 0; i < offset; i++) cells += `<div class="trip-day empty"></div>`;

      for (let d = 1; d <= days; d++) {
        const dateIso = iso(year, m, d);
        const onDay = tripsOn(dateIso, yearTrips);
        // The first day of a trip shows its symbol instead of the date
        const starting = onDay.find((t) => t.start === dateIso);
        const label = starting
          ? `<span class="trip-start-icon">${WHO[whoOf(starting)].icon}</span>`
          : d;
        const classes = ["trip-day"];
        let style = "";
        let title = "";

        if (onDay.length) {
          if (onDay.some((t) => !WHO[whoOf(t)].atHome)) daysAway++;
          classes.push("in-trip");
          if (onDay.length > 1) classes.push("multi");
          if (onDay.some((t) => t.id === editingId)) classes.push("focused");
          if (onDay.every((t) => whoOf(t) === "shared")) classes.push("shared");
          else style = `background:${dayBackground(onDay)}`;
          title = onDay.map((t) => `${t.title} (${WHO[whoOf(t)].label})`).join(", ");
        }
        if (dateIso === todayIso) classes.push("today");
        if (pickingEnd && dateIso === startInput.value) classes.push("pending");

        cells += `<button type="button" class="${classes.join(" ")}" data-date="${dateIso}"
          style="${style}" title="${escapeHtml(title)}"
          aria-label="${dateIso}${title ? `: ${escapeHtml(title)}` : ""}">${label}</button>`;
      }

      return `
        <div class="trip-month">
          <h4>${name}</h4>
          <div class="trip-mini-weekdays">
            <div>M</div><div>T</div><div>W</div><div>T</div><div>F</div><div>S</div><div>S</div>
          </div>
          <div class="trip-mini-days">${cells}</div>
        </div>`;
    }).join("");

    monthGrid.innerHTML = html;

    const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
    const away = yearTrips.filter((t) => !WHO[whoOf(t)].atHome);
    const visits = yearTrips.length - away.length;
    const counts = Object.keys(WHO)
      .filter((k) => !WHO[k].atHome)
      .map((k) => [k, away.filter((t) => whoOf(t) === k).length])
      .filter(([, n]) => n)
      .map(([k, n]) => `${n} ${WHO[k].label}`);
    const parts = [];
    if (away.length) parts.push(`${plural(away.length, "trip")} (${counts.join(", ")})`);
    if (visits) parts.push(plural(visits, "visit"));
    if (away.length) parts.push(`${plural(daysAway, "day")} away`);
    yearStats.textContent = parts.length ? parts.join(" · ") : "No trips yet";

    monthGrid.querySelectorAll(".trip-day[data-date]").forEach((btn) => {
      btn.onclick = () => handleDayClick(btn.dataset.date);
    });
  };

  const renderList = () => {
    const yearTrips = tripsInYear(year);
    listHeading.textContent = `Trips in ${year}`;

    list.innerHTML = yearTrips.length
      ? yearTrips.map((t) => `
          <div class="trip-item${t.id === editingId ? " active" : ""}" data-id="${escapeHtml(t.id)}"
            role="button" tabindex="0">
            <div class="trip-swatch${whoOf(t) === "shared" ? " trip-metal" : ""}"
              style="${whoOf(t) === "shared" ? "" : `background:${colorOf(t)}`}"></div>
            <div>
              <div class="trip-item-title">${escapeHtml(t.title)}<span class="trip-item-tag${whoOf(t) === "shared" ? " trip-metal" : ""}"
                style="${whoOf(t) === "shared" ? "" : `background:${colorOf(t)}`}">${WHO[whoOf(t)].icon} ${WHO[whoOf(t)].label}</span></div>
              <div class="trip-item-meta">
                ${t.location ? `📍 ${escapeHtml(t.location)} · ` : ""}${formatRange(t)} · ${dayCount(t)} day${dayCount(t) === 1 ? "" : "s"}${(() => {
                  const n = memoriesFor(t).length;
                  return n ? ` · 🧠 ${n}` : "";
                })()}
              </div>
              ${t.note ? `<div class="trip-item-note">${escapeHtml(t.note)}</div>` : ""}
              ${t.id === editingId ? memoriesHtml(t) : ""}
            </div>
          </div>`).join("")
      : `<div class="trip-item" style="cursor:default">Nothing planned yet for ${year}.</div>`;

    list.querySelectorAll(".trip-item[data-id]").forEach((el) => {
      const open = () => startEditing(el.dataset.id);
      el.onclick = open;
      el.onkeydown = (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(); }
      };
    });
  };

  const render = () => { renderYear(); renderList(); renderMap(); };

  // ---------- Map ----------
  const mapEl = $("tripMap");
  const mapStats = $("tripMapStats");
  const mapNote = $("tripMapNote");
  let mapScope = "year";
  let map = null;
  let markerLayer = null;
  let lastFit = ""; // only re-zoom when the set of pins changes

  const loadLeaflet = () => new Promise((resolve, reject) => {
    if (window.L) return resolve(window.L);
    const css = document.createElement("link");
    css.rel = "stylesheet";
    css.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
    document.head.appendChild(css);
    const js = document.createElement("script");
    js.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
    js.onload = () => resolve(window.L);
    js.onerror = reject;
    document.head.appendChild(js);
  });

  const ensureMap = async () => {
    if (map) return map;
    const L = await loadLeaflet();
    map = L.map(mapEl, { worldCopyJump: true, zoomControl: true }).setView([48, 10], 3);
    // Standard OpenStreetMap tiles (no key needed), darkened with CSS below
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 18,
    }).addTo(map);
    markerLayer = L.layerGroup().addTo(map);
    return map;
  };

  const renderMap = async () => {
    const scoped = mapScope === "year" ? tripsInYear(year) : trips.slice();
    const located = scoped.filter((t) => Array.isArray(t.places) && t.places.length);
    const waiting = scoped.filter(needsPlaces).length;

    // Countries and places count trips away only (visits happen at home)
    const away = located.filter((t) => !WHO[whoOf(t)].atHome);
    const countries = new Set(away.flatMap((t) => t.places.map((p) => p.country_code || p.country)));
    const places = new Set(away.flatMap((t) => t.places.map((p) => `${p.name}|${p.country}`)));
    const plural = (n, word, many = `${word}s`) => `${n} ${n === 1 ? word : many}`;
    const label = mapScope === "year" ? `in ${year}` : "so far";
    mapStats.textContent = places.size
      ? `${plural(countries.size, "country", "countries")} · ${plural(places.size, "place")} ${label}`
      : `No places on the map ${label} yet`;
    mapNote.textContent = waiting
      ? `📍 Working out where ${plural(waiting, "trip")} ${waiting === 1 ? "was" : "were"}…`
      : "";

    let L;
    try {
      await ensureMap();
      L = window.L;
    } catch (err) {
      mapNote.textContent = "The map could not be loaded.";
      return;
    }

    markerLayer.clearLayers();
    const bounds = [];
    for (const t of located) {
      const w = WHO[whoOf(t)];
      for (const p of t.places) {
        const marker = L.circleMarker([p.lat, p.lng], {
          radius: 7,
          color: "#0b0b0b",
          weight: 1.5,
          fillColor: w.color,
          fillOpacity: 0.95,
        }).bindPopup(`
          <strong>${w.icon} ${escapeHtml(t.title)}</strong><br>
          📍 ${escapeHtml(p.name)}, ${escapeHtml(p.country)}<br>
          <span style="opacity:.7">${formatRange(t)}</span>`);
        marker.addTo(markerLayer);
        bounds.push([p.lat, p.lng]);
      }
    }
    map.invalidateSize();
    const fitKey = JSON.stringify(bounds);
    if (fitKey !== lastFit && mapEl.offsetWidth) {
      lastFit = fitKey;
      if (bounds.length === 1) map.setView(bounds[0], 6);
      else if (bounds.length > 1) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 6 });
    }
  };

  // The Trips tab starts hidden, so the map has no size until it's opened
  window.addEventListener("trips-tab-shown", () => renderMap());

  document.querySelectorAll(".trip-map-toggle button").forEach((btn) => {
    btn.onclick = () => {
      mapScope = btn.dataset.scope;
      document.querySelectorAll(".trip-map-toggle button")
        .forEach((b) => b.classList.toggle("active", b === btn));
      renderMap();
    };
  });

  const resetForm = () => {
    editingId = null;
    pickingEnd = false;
    form.reset();
    selectedWho = "shared";
    formHeading.textContent = "✈️ Add a trip";
    saveBtn.textContent = "Save trip";
    cancelBtn.hidden = true;
    deleteBtn.hidden = true;
    renderWho();
  };

  const startEditing = (id) => {
    const t = trips.find((x) => x.id === id);
    if (!t) return;
    editingId = id;
    pickingEnd = false;
    titleInput.value = t.title;
    locationInput.value = t.location || "";
    startInput.value = t.start;
    endInput.value = t.end;
    noteInput.value = t.note || "";
    selectedWho = whoOf(t);
    formHeading.textContent = "✏️ Edit trip";
    saveBtn.textContent = "Update trip";
    cancelBtn.hidden = false;
    deleteBtn.hidden = false;
    renderWho();
    render();
  };

  const handleDayClick = (dateIso) => {
    // Clicking a day that belongs to a trip opens it (unless we're mid-selection)
    const onDay = tripsOn(dateIso, trips);
    if (!pickingEnd && onDay.length && !editingId) {
      startEditing(onDay[0].id);
      return;
    }

    if (!pickingEnd) {
      startInput.value = dateIso;
      endInput.value = dateIso;
      pickingEnd = true;
    } else {
      if (dateIso < startInput.value) {
        endInput.value = startInput.value;
        startInput.value = dateIso;
      } else {
        endInput.value = dateIso;
      }
      pickingEnd = false;
      if (!editingId) titleInput.focus();
    }
    renderYear();
  };

  startInput.addEventListener("change", () => {
    if (!endInput.value || endInput.value < startInput.value) endInput.value = startInput.value;
  });

  form.onsubmit = async (e) => {
    e.preventDefault();
    let start = startInput.value;
    let end = endInput.value || start;
    if (end < start) [start, end] = [end, start];

    const data = {
      title: titleInput.value.trim(),
      location: locationInput.value.trim(),
      start,
      end,
      who: selectedWho,
      note: noteInput.value.trim(),
    };

    const backup = trips.slice();
    if (editingId) {
      trips = trips.map((t) => t.id === editingId ? { ...t, ...data, updatedAt: new Date().toISOString() } : t);
    } else {
      const id = (crypto.randomUUID && crypto.randomUUID()) || `${Date.now()}-${Math.random().toString(36).slice(2)}`;
      trips.push({ id, ...data, createdAt: new Date().toISOString() });
    }

    try {
      await saveTrips();
      year = parseIso(start).getFullYear();
      resetForm();
      requestPlaces();
    } catch (err) {
      console.error("Failed to save trip:", err);
      alert("Could not save the trip.");
      trips = backup;
    }
    render();
  };

  cancelBtn.onclick = () => { resetForm(); render(); };

  deleteBtn.onclick = async () => {
    const t = trips.find((x) => x.id === editingId);
    if (!t || !confirm(`Delete "${t.title}"?`)) return;
    const backup = trips.slice();
    trips = trips.filter((x) => x.id !== editingId);
    try {
      await saveTrips();
      resetForm();
    } catch (err) {
      console.error("Failed to delete trip:", err);
      alert("Could not delete the trip.");
      trips = backup;
    }
    render();
  };

  $("tripPrevYear").onclick = () => { year--; render(); };
  $("tripNextYear").onclick = () => { year++; render(); };

  try {
    await loadTrips();
  } catch (err) {
    console.warn("Trips could not be loaded, continuing empty.", err);
    trips = [];
  }

  try {
    await loadMemories();
  } catch (err) {
    console.warn("Memories could not be loaded; trips will show without them.", err);
    memories = {};
  }

  resetForm();
  render();
  requestPlaces();
})();
</script>
