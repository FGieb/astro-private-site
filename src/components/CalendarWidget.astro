---
const today = new Date();
let displayYear = today.getFullYear();
let displayMonth = today.getMonth();

const getMonthLabel = (month: number, year: number) =>
  new Date(year, month, 1).toLocaleString("default", { month: "long" });
---

<section class="calendar-shell">
  <section class="calendar-card">
    <div class="calendar-header">
      <button id="prevMonth" type="button" class="nav-btn">◀</button>
      <h2 id="monthLabel">{getMonthLabel(displayMonth, displayYear)}</h2>
      <button id="nextMonth" type="button" class="nav-btn">▶</button>
    </div>

    <div class="weekday-row">
      <div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div>
      <div>Fri</div><div>Sat</div><div>Sun</div>
    </div>

    <div class="day-grid" id="dayGrid"></div>
  </section>

  <aside class="event-card">
    <h3 id="eventHeading">Events</h3>

    <form class="event-form" id="eventForm">
      <input id="eventTitle" type="text" placeholder="Event title" required />

      <label class="event-type-label">🏷️ Entry type</label>
      <select id="eventType" class="event-type">
        <option value="note">📝 Note</option>
        <option value="plan">📍 Plan</option>
        <option value="memory">🧠 Memory</option>
        <option value="occasion">🌟 Occasion</option>
      </select>

      <textarea id="eventNote" rows="3" placeholder="Add a note (optional)"></textarea>
      <button type="submit" class="save-btn">Save Event</button>
    </form>

    <div class="event-list" id="eventList"></div>
  </aside>
</section>

<style is:global>
  :root { color-scheme: dark; }

  .calendar-shell {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 2rem;
  }

  .calendar-card,
  .event-card {
    background: #0f0f0f;
    border: 1px solid #1f1f1f;
    border-radius: 1.25rem;
    padding: 1.5rem;
  }

  .calendar-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .weekday-row,
  .day-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.5rem;
  }

  .day-button {
    background: #0a74c9;
    border-radius: 0.75rem;
    min-height: 64px;
    color: white;
    font-weight: 600;
    position: relative;
    cursor: pointer;
    border: none;
  }

  .day-button.inactive {
    opacity: 0.25;
    cursor: default;
  }

  .day-button.today {
    outline: 2px solid rgba(255,255,255,0.6);
    outline-offset: -2px;
  }

  .day-button.selected {
    background: #111;
    border: 1px solid white;
  }

  .day-button.has-event::after {
    content: attr(data-count);
    position: absolute;
    top: 6px;
    right: 6px;
    background: white;
    color: black;
    border-radius: 999px;
    padding: 0 6px;
    font-size: 12px;
    font-weight: 800;
  }

  .event-item {
    padding: 0.75rem;
    border: 1px solid #242424;
    border-radius: 0.75rem;
    background: #141414;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 900px) {
    .calendar-shell {
      grid-template-columns: 1fr;
    }
  }
</style>

<script type="module" is:inline>
(async () => {
  const dayGrid = document.getElementById("dayGrid");
  const monthLabel = document.getElementById("monthLabel");
  const eventHeading = document.getElementById("eventHeading");
  const eventList = document.getElementById("eventList");
  const eventForm = document.getElementById("eventForm");
  const eventTitle = document.getElementById("eventTitle");
  const eventNote = document.getElementById("eventNote");
  const eventType = document.getElementById("eventType");
  const prevMonth = document.getElementById("prevMonth");
  const nextMonth = document.getElementById("nextMonth");

  const today = new Date();
  let displayYear = today.getFullYear();
  let displayMonth = today.getMonth();
  let selectedDate = { month: displayMonth, day: today.getDate() };

  let cachedEvents = {};

  const typeIcon = (type) =>
    ({ note:"📝", plan:"📍", memory:"🧠", occasion:"🌟" }[type] || "📝");

  const keyForDate = (m, d) =>
    `${String(m + 1).padStart(2,"0")}-${String(d).padStart(2,"0")}`;

  const loadEvents = async () => {
    const res = await fetch("/.netlify/functions/calendar-load");
    cachedEvents = await res.json();
  };

  const saveEvents = async () => {
    await fetch("/.netlify/functions/calendar-save", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(cachedEvents)
    });
  };

  const renderEvents = () => {
    const key = keyForDate(selectedDate.month, selectedDate.day);
    const list = cachedEvents[key] || [];

    eventHeading.textContent =
      `Events for ${new Date(displayYear, selectedDate.month, selectedDate.day)
        .toLocaleDateString(undefined, { month: "long", day: "numeric" })}`;

    eventList.innerHTML = list.length
      ? list.map(e => `
          <div class="event-item">
            <strong>${typeIcon(e.type)} ${e.title}</strong>
            ${e.note ? `<div>${e.note}</div>` : ""}
          </div>
        `).join("")
      : `<div class="event-item">No events yet.</div>`;
  };

  const renderCalendar = () => {
    monthLabel.textContent =
      new Date(displayYear, displayMonth, 1)
        .toLocaleString("default", { month: "long" });

    dayGrid.innerHTML = "";

    const firstDay = new Date(displayYear, displayMonth, 1);
    const start = (firstDay.getDay() + 6) % 7;
    const days = new Date(displayYear, displayMonth + 1, 0).getDate();

    for (let i = 0; i < start; i++) {
      const spacer = document.createElement("div");
      spacer.className = "day-button inactive";
      dayGrid.appendChild(spacer);
    }

    for (let d = 1; d <= days; d++) {
      const btn = document.createElement("button");
      btn.className = "day-button";
      btn.textContent = d;

      if (
        d === today.getDate() &&
        displayMonth === today.getMonth() &&
        displayYear === today.getFullYear()
      ) btn.classList.add("today");

      if (d === selectedDate.day && displayMonth === selectedDate.month) {
        btn.classList.add("selected");
      }

      const key = keyForDate(displayMonth, d);
      if (cachedEvents[key]?.length) {
        btn.classList.add("has-event");
        btn.dataset.count = cachedEvents[key].length;
      }

      btn.onclick = () => {
        selectedDate = { month: displayMonth, day: d };
        renderCalendar();
        renderEvents();
      };

      dayGrid.appendChild(btn);
    }
  };

  eventForm.onsubmit = async (e) => {
    e.preventDefault();

    const key = keyForDate(selectedDate.month, selectedDate.day);
    cachedEvents[key] = cachedEvents[key] || [];

    cachedEvents[key].push({
      title: eventTitle.value,
      note: eventNote.value,
      type: eventType.value,
      createdAt: new Date().toISOString()
    });

    await saveEvents();
    eventForm.reset();
    renderCalendar();
    renderEvents();
  };

  prevMonth.onclick = () => {
    displayMonth--;
    if (displayMonth < 0) { displayMonth = 11; displayYear--; }
    selectedDate.day = 1;
    renderCalendar(); renderEvents();
  };

  nextMonth.onclick = () => {
    displayMonth++;
    if (displayMonth > 11) { displayMonth = 0; displayYear++; }
    selectedDate.day = 1;
    renderCalendar(); renderEvents();
  };

  await loadEvents();
  renderCalendar();
  renderEvents();
})();
</script>
