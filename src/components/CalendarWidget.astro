---
const today = new Date();
let displayYear = today.getFullYear();
let displayMonth = today.getMonth();

const getMonthLabel = (month: number, year: number) =>
  new Date(year, month, 1).toLocaleString("default", { month: "long" });
---

<section class="calendar-shell">
  <section class="calendar-card">
    <div class="calendar-header">
      <button id="prevMonth" type="button" class="nav-btn">◀</button>
      <h2 id="monthLabel">{getMonthLabel(displayMonth, displayYear)}</h2>
      <button id="nextMonth" type="button" class="nav-btn">▶</button>
    </div>

    <div class="weekday-row">
      <div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div>
      <div>Fri</div><div>Sat</div><div>Sun</div>
    </div>

    <div class="day-grid" id="dayGrid"></div>
  </section>

  <aside class="event-card">
    <h3 id="eventHeading">Events</h3>

    <form class="event-form" id="eventForm">
      <input id="eventTitle" type="text" placeholder="Event title" required />

    <label class="event-type-label" for="eventType">
      🏷️ Entry type
    </label>

    <select id="eventType" class="event-type">
      <option value="note">Note</option>
      <option value="plan">Plan</option>
      <option value="memory">Memory</option>
    </select>

      <textarea id="eventNote" rows="3" placeholder="Add a note (optional)"></textarea>

      <button type="submit" class="save-btn">Save Event</button>
    </form>

    <div class="event-list" id="eventList"></div>
  </aside>
</section>

<style is:global>
  :root { color-scheme: dark; }

  .calendar-shell {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 2rem;
  }

  .calendar-card,
  .event-card {
    background: #0f0f0f;
    border: 1px solid #1f1f1f;
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .calendar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .calendar-header h2 {
    margin: 0;
    font-size: 1.5rem;
  }

  .nav-btn {
    background: #1b1b1b;
    border: 1px solid #2f2f2f;
    color: #f5f5f5;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
  }
  .nav-btn:hover { background: #2a2a2a; }

  .weekday-row,
  .day-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .weekday-row div {
    text-align: center;
    font-size: 0.85rem;
    color: #a5a5a5;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .event-type-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cfcfcf;
    margin-top: 0.75rem;
  }

  .event-type {
    background: #181818;
    border: 1px solid #3a3a3a;
    border-radius: 0.75rem;
    padding: 0.6rem 1rem;
    color: #ffffff;
    font-weight: 600;
  } 

  .event-type:focus {
    outline: none;
    border-color: #ffffff;
    box-shadow: 0 0 0 1px #ffffff;
  }
  .event-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .event-icon {
    font-size: 1.1rem;
  }

  .event-note {
    margin-top: 0.25rem;
    color: #bdbdbd;
    font-size: 0.85rem;
  }


  /* === DAY BUTTONS === */
  .day-button {
    position: relative;
    background: #0a74c9;
    border: 1px solid transparent;
    color: #ffffff;
    border-radius: 0.75rem;
    min-height: 64px;
    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }

  .day-button:hover { filter: brightness(1.05); }

  .day-button.inactive {
    opacity: 0.25;
    cursor: default;
  }

  /* === TODAY === */
  .day-button.today {
    outline: 2px solid rgba(255,255,255,0.6);
    outline-offset: -2px;
  }

  /* === EVENT INDICATOR (COUNT BADGE) === */
  .day-button.has-event {
    border-color: rgba(255,255,255,0.55);
    box-shadow:
      0 0 0 2px rgba(255,255,255,0.40),
      0 0 14px rgba(255,255,255,0.18);
  }

  .day-button.has-event::after {
    content: attr(data-count);
    position: absolute;
    top: 6px;
    right: 6px;

    min-width: 18px;
    height: 18px;
    padding: 0 6px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;

    background: #ffffff;
    color: #0f0f0f;
  }

  /* === SELECTED DAY === */
  .day-button.selected {
    background: #111;
    border-color: #ffffff;
  }

  /* === EVENTS PANEL === */
  .event-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .event-form input,
  .event-form textarea,
  .event-form select {
    background: #121212;
    border: 1px solid #2a2a2a;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    color: #f5f5f5;
  }

  .save-btn {
    background: #f5f5f5;
    color: #050505;
    border: none;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  .event-item {
    padding: 0.75rem 1rem;
    background: #141414;
    border-radius: 0.75rem;
    border: 1px solid #242424;
  }

  .event-item .type {
    font-size: 0.75rem;
    color: #9a9a9a;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  @media (max-width: 900px) {
    .calendar-shell { grid-template-columns: 1fr; }
  }
</style>

<script type="module" is:inline>
  const monthLabel = document.getElementById("monthLabel");
  const dayGrid = document.getElementById("dayGrid");
  const eventHeading = document.getElementById("eventHeading");
  const eventList = document.getElementById("eventList");
  const eventForm = document.getElementById("eventForm");
  const eventTitle = document.getElementById("eventTitle");
  const eventNote = document.getElementById("eventNote");
  const eventType = document.getElementById("eventType");
  const prevMonth = document.getElementById("prevMonth");
  const nextMonth = document.getElementById("nextMonth");

  const today = new Date();
  let displayYear = today.getFullYear();
  let displayMonth = today.getMonth();
  let selectedDate = { month: displayMonth, day: today.getDate() };

  const typeIcon = (type) => {
    switch (type) {
      case "memory": return "🧠";
      case "plan": return "📍";
      case "note":
      default: return "📝";
    }
  };

  const loadEvents = () =>
    JSON.parse(localStorage.getItem("calendarEvents") || "{}");

  const saveEvents = (events) =>
    localStorage.setItem("calendarEvents", JSON.stringify(events));

  const keyForDate = (month, day) =>
    `${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;

  const renderEvents = () => {
    const events = loadEvents();
    const key = keyForDate(selectedDate.month, selectedDate.day);
    const list = events[key] || [];

    eventHeading.textContent =
      `Events for ${new Date(displayYear, selectedDate.month, selectedDate.day)
        .toLocaleDateString(undefined, { month: "long", day: "numeric" })}`;

    eventList.innerHTML = "";

    if (!list.length) {
      eventList.innerHTML = `<div class="event-item">No events yet.</div>`;
      return;
    }

    list.forEach(evt => {
      const item = document.createElement("div");
      item.className = "event-item";

      const icon = typeIcon(evt.type);

      item.innerHTML = `
        <strong>${evt.title}</strong>
        <div class="type">${evt.type}</div>
        ${evt.note ? `<span>${evt.note}</span>` : ""}
      `;
      eventList.appendChild(item);
    });
  };

  const renderCalendar = () => {
    monthLabel.textContent =
      new Date(displayYear, displayMonth, 1).toLocaleString("default", { month: "long" });

    const firstDay = new Date(displayYear, displayMonth, 1);
    const startDayIndex = (firstDay.getDay() + 6) % 7;
    const daysInMonth = new Date(displayYear, displayMonth + 1, 0).getDate();
    const events = loadEvents();

    dayGrid.innerHTML = "";

    for (let i = 0; i < startDayIndex; i++) {
      const spacer = document.createElement("div");
      spacer.className = "day-button inactive";
      dayGrid.appendChild(spacer);
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const button = document.createElement("button");
      button.className = "day-button";
      button.textContent = day;

      if (
        day === today.getDate() &&
        displayMonth === today.getMonth() &&
        displayYear === today.getFullYear()
      ) {
        button.classList.add("today");
      }

      if (day === selectedDate.day && displayMonth === selectedDate.month) {
        button.classList.add("selected");
      }

      const key = keyForDate(displayMonth, day);
      const count = events[key]?.length || 0;

      if (count > 0) {
        button.classList.add("has-event");
        button.dataset.count = count;
      }

      button.onclick = () => {
        selectedDate = { month: displayMonth, day };
        renderCalendar();
        renderEvents();
      };

      dayGrid.appendChild(button);
    }
  };

  eventForm.onsubmit = (e) => {
    e.preventDefault();

    const title = eventTitle.value.trim();
    if (!title) return;

    const events = loadEvents();
    const key = keyForDate(selectedDate.month, selectedDate.day);

    events[key] = events[key] || [];
    events[key].push({
      title,
      note: eventNote.value.trim(),
      type: eventType.value,
      createdAt: new Date().toISOString(),
      updatedAt: Date.now()
    });

    saveEvents(events);

    eventTitle.value = "";
    eventNote.value = "";
    eventType.value = "note";

    renderCalendar();
    renderEvents();
  };

  prevMonth.onclick = () => {
    displayMonth--;
    if (displayMonth < 0) { displayMonth = 11; displayYear--; }
    selectedDate = { month: displayMonth, day: 1 };
    renderCalendar();
    renderEvents();
  };

  nextMonth.onclick = () => {
    displayMonth++;
    if (displayMonth > 11) { displayMonth = 0; displayYear++; }
    selectedDate = { month: displayMonth, day: 1 };
    renderCalendar();
    renderEvents();
  };

  renderCalendar();
  renderEvents();
</script>
