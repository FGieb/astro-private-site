---
const today = new Date();
let displayYear = today.getFullYear();
let displayMonth = today.getMonth();

const getMonthLabel = (month: number, year: number) =>
  new Date(year, month, 1).toLocaleString("default", { month: "long" });
---

<section class="calendar-shell">
  <section class="calendar-card">
    <div class="calendar-header">
      <button id="prevMonth" type="button" class="nav-btn">◀</button>
      <h2 id="monthLabel">{getMonthLabel(displayMonth, displayYear)}</h2>
      <button id="nextMonth" type="button" class="nav-btn">▶</button>
    </div>

    <div class="weekday-row">
      <div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div>
      <div>Fri</div><div>Sat</div><div>Sun</div>
    </div>

    <div class="day-grid" id="dayGrid"></div>
  </section>

  <aside class="event-card">
    <h3 id="eventHeading">Events</h3>

    <form class="event-form" id="eventForm">
      <input id="eventTitle" type="text" placeholder="Event title" required />
      <textarea id="eventNote" rows="3" placeholder="Add a note (optional)"></textarea>
      <button type="submit" class="save-btn">Save Event</button>
    </form>

    <div class="event-list" id="eventList"></div>
  </aside>
</section>

<style>
  :root { color-scheme: dark; }

  .calendar-shell {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 2rem;
  }

  .calendar-card,
  .event-card {
    background: #0f0f0f;
    border: 1px solid #1f1f1f;
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .calendar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .calendar-header h2 {
    margin: 0;
    font-size: 1.5rem;
  }

  /* Month nav buttons */
  .nav-btn {
    margin-top: 0 !important;
    background: #1b1b1b !important;
    border: 1px solid #2f2f2f !important;
    color: #f5f5f5 !important;
    border-radius: 999px !important;
    padding: 0.4rem 0.9rem !important;
    cursor: pointer;
  }
  .nav-btn:hover { background: #2a2a2a !important; }

  .weekday-row,
  .day-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .weekday-row div {
    text-align: center;
    font-size: 0.85rem;
    color: #a5a5a5;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* === DAY BUTTONS === */
  .day-button {
    position: relative;
    margin-top: 0 !important;               /* override global button */
    padding: 0.8rem 0.4rem !important;      /* override global button */
    font-size: 1rem !important;
    line-height: 1 !important;

    background: #0a74c9 !important;         /* keep your blue tiles */
    border: 1px solid transparent !important;
    color: #ffffff !important;

    border-radius: 0.75rem !important;
    min-height: 64px;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .day-button:hover { filter: brightness(1.05); }

  .day-button.inactive {
    opacity: 0.25;
    cursor: default;
  }

  /* === VERY VISIBLE EVENT MARKER ===
     We use a badge via data-count so it’s impossible to miss */
  .day-button.has-event {
    border-color: rgba(255,255,255,0.55) !important;
    box-shadow:
      0 0 0 2px rgba(255,255,255,0.40),
      0 0 14px rgba(255,255,255,0.18);
  }

  .day-button.has-event::after {
    content: attr(data-count);
    position: absolute;
    top: 6px;
    right: 6px;

    min-width: 18px;
    height: 18px;
    padding: 0 6px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;

    background: #ffffff;
    color: #0f0f0f;

    box-shadow: 0 6px 14px rgba(0,0,0,0.35);
  }

  /* === SELECTED DAY === */
  .day-button.selected {
    background: #111 !important;
    border-color: #ffffff !important;
  }

  .day-button.selected.has-event {
    box-shadow:
      0 0 0 2px #ffffff,
      0 0 18px rgba(255, 255, 255, 0.35);
  }

  /* === EVENTS PANEL === */
  .event-card h3 { margin-top: 0; }

  .event-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .event-form input,
  .event-form textarea {
    background: #121212;
    border: 1px solid #2a2a2a;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    color: #f5f5f5;
  }

  .save-btn {
    margin-top: 0.25rem !important;
    background: #f5f5f5 !important;
    color: #050505 !important;
    border: none !important;
    border-radius: 0.75rem !important;
    padding: 0.75rem 1rem !important;
    font-weight: 700 !important;
    cursor: pointer !important;
  }
  .save-btn:hover { background: #d9d9d9 !important; }

  .event-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .event-item {
    padding: 0.75rem 1rem;
    background: #141414;
    border-radius: 0.75rem;
    border: 1px solid #242424;
  }

  .event-item span {
    display: block;
    color: #bdbdbd;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .calendar-shell { grid-template-columns: 1fr; }
  }
</style>

<script type="module" is:inline>
  const monthLabel = document.getElementById("monthLabel");
  const dayGrid = document.getElementById("dayGrid");
  const eventHeading = document.getElementById("eventHeading");
  const eventList = document.getElementById("eventList");
  const eventForm = document.getElementById("eventForm");
  const eventTitle = document.getElementById("eventTitle");
  const eventNote = document.getElementById("eventNote");
  const prevMonth = document.getElementById("prevMonth");
  const nextMonth = document.getElementById("nextMonth");

  // Must exist in the browser script (Astro frontmatter does not run here)
  const getMonthLabel = (month, year) =>
    new Date(year, month, 1).toLocaleString("default", { month: "long" });

  const today = new Date();
  let displayYear = today.getFullYear();
  let displayMonth = today.getMonth();
  let selectedDate = { month: displayMonth, day: today.getDate() };

  const loadEvents = () =>
    JSON.parse(localStorage.getItem("calendarEvents") || "{}");

  const saveEvents = (events) =>
    localStorage.setItem("calendarEvents", JSON.stringify(events));

  const keyForDate = (month, day) =>
    `${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;

  const renderEvents = () => {
    const events = loadEvents();
    const key = keyForDate(selectedDate.month, selectedDate.day);
    const list = events[key] || [];

    eventHeading.textContent =
      `Events for ${getMonthLabel(selectedDate.month, displayYear)} ${selectedDate.day}`;

    eventList.innerHTML = "";

    if (list.length === 0) {
      const empty = document.createElement("div");
      empty.className = "event-item";
      empty.textContent = "No events yet. Add the first one!";
      eventList.appendChild(empty);
      return;
    }

    list.forEach((evt) => {
      const item = document.createElement("div");
      item.className = "event-item";
      item.innerHTML = `
        <strong>${evt.title}</strong>
        ${evt.note ? `<span>${evt.note}</span>` : ""}
      `;
      eventList.appendChild(item);
    });
  };

  const renderCalendar = () => {
    monthLabel.textContent = getMonthLabel(displayMonth, displayYear);

    const firstDay = new Date(displayYear, displayMonth, 1);
    const startDayIndex = (firstDay.getDay() + 6) % 7; // Monday start
    const daysInMonth = new Date(displayYear, displayMonth + 1, 0).getDate();
    const events = loadEvents();

    dayGrid.innerHTML = "";

    for (let i = 0; i < startDayIndex; i++) {
      const spacer = document.createElement("div");
      spacer.className = "day-button inactive";
      dayGrid.appendChild(spacer);
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "day-button";
      button.textContent = String(day);

      if (day === selectedDate.day && displayMonth === selectedDate.month) {
        button.classList.add("selected");
      }

      const key = keyForDate(displayMonth, day);
      const count = events[key]?.length || 0;

      if (count > 0) {
        button.classList.add("has-event");
        button.dataset.count = String(count); // badge number
      }

      button.addEventListener("click", () => {
        selectedDate = { month: displayMonth, day };
        renderCalendar();
        renderEvents();
      });

      dayGrid.appendChild(button);
    }
  };

  eventForm.addEventListener("submit", (e) => {
    e.preventDefault();

    const title = eventTitle.value.trim();
    const note = eventNote.value.trim();
    if (!title) return;

    const events = loadEvents();
    const key = keyForDate(selectedDate.month, selectedDate.day);

    events[key] = events[key] || [];
    events[key].push({ title, note, updatedAt: Date.now() });

    saveEvents(events);

    eventTitle.value = "";
    eventNote.value = "";

    renderCalendar();
    renderEvents();
  });

  prevMonth.addEventListener("click", () => {
    displayMonth -= 1;
    if (displayMonth < 0) {
      displayMonth = 11;
      displayYear -= 1;
    }
    selectedDate = { month: displayMonth, day: 1 };
    renderCalendar();
    renderEvents();
  });

  nextMonth.addEventListener("click", () => {
    displayMonth += 1;
    if (displayMonth > 11) {
      displayMonth = 0;
      displayYear += 1;
    }
    selectedDate = { month: displayMonth, day: 1 };
    renderCalendar();
    renderEvents();
  });

  renderCalendar();
  renderEvents();
</script>
