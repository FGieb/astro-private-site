---
import Nav from "../components/Nav.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <slot name="head" />

    <style is:global>
      /* base dark mode */
      body {
        font-family: system-ui, sans-serif;
        background: #000;
        margin: 0;
        padding: 2rem;
        color: #fff;
      }

      a {
        color: #4da6ff;
        word-break: break-all;
      }

      .container {
        max-width: 700px;
        margin: auto;
        background: #111;
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 4px 12px rgba(255, 255, 255, 0.1);
      }

      textarea {
        width: 100%;
        height: 100px;
        padding: 1rem;
        font-size: 1rem;
        border-radius: 0.5rem;
        border: 1px solid #444;
        background: #222;
        color: #fff;
        resize: vertical;
      }

      button {
        margin-top: 1rem;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        background-color: #0077cc;
        color: #fff;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
      }

      .note {
        background: #222;
        border-left: 4px solid #0077cc;
        margin-top: 1rem;
        padding: 1rem;
        border-radius: 0.5rem;
        color: #ddd;
      }

      .timestamp {
        font-size: 0.8rem;
        color: #aaa;
        margin-top: 0.5rem;
      }
    </style>
  </head>

  <body>
    <Nav />
    <slot />
  </body>
</html>
