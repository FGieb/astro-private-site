---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{title}</title>

  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      color: white;
      background:
        linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.75)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    /* NAV (global) */
    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 1.25rem;
    }

    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(0,0,0,0.55);
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      backdrop-filter: blur(6px);
    }

    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.85;
    }

    .nav-pill a:hover {
      opacity: 1;
    }

    .nav-group { position: relative; display: flex; align-items: center; }
    .nav-group-label { cursor: pointer; opacity: 0.85; user-select: none; }
    .nav-group-label:hover { opacity: 1; }
    .nav-group-menu { display: none; position: absolute; top: calc(100% + 0.6rem); left: 50%; transform: translateX(-50%); background: rgba(14,18,26,0.97); border: 1px solid rgba(255,255,255,0.1); border-radius: 0.75rem; padding: 0.35rem; min-width: 130px; flex-direction: column; gap: 0.1rem; z-index: 100; backdrop-filter: blur(10px); }
    .nav-group:hover .nav-group-menu { display: flex; }
    .nav-group-menu a { display: block; padding: 0.4rem 0.75rem; border-radius: 0.5rem; white-space: nowrap; opacity: 0.85; }
    .nav-group-menu a:hover { background: rgba(255,255,255,0.08); opacity: 1; }
  </style>
</head>

<body>

  <!-- GLOBAL NAV -->
  <div class="top-nav">
    <div class="nav-pill">
      <a href="/calendar">📅 Calendar</a>
      <div class="nav-group">
        <span class="nav-group-label">🎮 Games ▾</span>
        <div class="nav-group-menu">
          <a href="/bets">🎲 Bets</a>
          <a href="/scores">🏆 Scores</a>
          <a href="/poker">🃏 Poker</a>
        </div>
      </div>
      <a href="/overview">📋 Overview</a>
      <a href="/home">🏠 Home</a>
      <a href="/notes">📝 Notes</a>
      <a href="/archive">🗂 Archive</a>
    </div>
  </div>

  <!-- PAGE CONTENT -->
  <slot />

</body>
</html>
