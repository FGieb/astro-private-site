---
const cookie = Astro.cookies.get("auth");
if (!cookie || cookie.value !== "1") {
  return Astro.redirect("/login");
}

import snippets from '../data/snippets.json';
import gallery from '../data/gallery.json'; // your cleaned list of IDs

const today = new Date();
const dayIndex = today.getDate();

const snippet = snippets[dayIndex % snippets.length];
const publicId = gallery[dayIndex % gallery.length];

// 🔍 Simple logic: if publicId is in known video list, use .mov, else .jpg
const videoIds = new Set([
