---
const cookieHeader = Astro.request.headers.get('cookie') || '';
const hasSession = cookieHeader.includes('session=valid');

if (!hasSession) {
  return new Response(null, {
    status: 302,
    headers: {
      Location: '/login',
    }
  });
}
---

<html>
  <head>
    <title>Private Home</title>
  </head>
  <body>
    <h1>🎉 Welcome to the private area!</h1>
    <p>This is a protected page.</p>
  </body>
</html>
