---
export const prerender = false;
export const runtime = "nodejs";

import { isValidSession } from "../lib/auth";

const cookie = Astro.cookies.get("auth");

if (!(await isValidSession(cookie?.value))) {
  return Astro.redirect("/login");
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Private Home</title>

  <style is:global>
    :root {
      --glass-dark: rgba(10, 16, 28, 0.52);
      --glass-mid: rgba(12, 20, 36, 0.44);
      --glass-light: rgba(255, 255, 255, 0.87);
      --text-dark: #121212;
      --text-light: #ffffff;
      --muted-light: rgba(255,255,255,0.72);
      --accent-blue: #0a74c9;
      --accent-blue-soft: rgba(10, 116, 201, 0.14);
      --accent-blue-border: rgba(10, 116, 201, 0.28);
      --shadow: 0 18px 40px rgba(0,0,0,0.18);
      --radius-xl: 1.6rem;
      --radius-lg: 1.15rem;
    }
  
    * {
      box-sizing: border-box;
    }
  
    html, body {
      margin: 0;
      min-height: 100%;
    }
  
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--text-light);
      min-height: 100vh;
      background-color: #2a2f38;
      background-image:
        linear-gradient(rgba(18, 24, 36, 0.52), rgba(18, 24, 36, 0.60)),
        linear-gradient(rgba(10, 116, 201, 0.10), rgba(10, 116, 201, 0.08)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed
    }
  
    .page {
      max-width: 1180px;
      margin: 0 auto;
      padding: 1.25rem 1.25rem 3rem;
    }
  
    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 0.25rem;
      margin-bottom: 2rem;
      position: relative;
      z-index: 1000;
    }
  
    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(14, 18, 26, 0.68);
      padding: 0.78rem 1.5rem;
      border-radius: 999px;
      backdrop-filter: blur(10px);
      box-shadow: 0 10px 24px rgba(0,0,0,0.14);
      flex-wrap: wrap;
      border: 1px solid #1f1f1f;
    }
  
    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.92;
      font-size: 1.02rem;
    }
  
    .nav-pill a:hover {
      opacity: 1;
      color: var(--accent-blue);
    }

    .nav-group { position: relative; }
    .nav-group-label { cursor: pointer; opacity: 0.92; user-select: none; font-size: 1.02rem; }
    .nav-group-label:hover { opacity: 1; }
    .nav-group-menu { display: none; position: absolute; top: calc(100% + 0.6rem); left: 50%; transform: translateX(-50%); background: rgba(14,18,26,0.97); border: 1px solid rgba(255,255,255,0.1); border-radius: 0.75rem; padding: 0.35rem; min-width: 130px; flex-direction: column; gap: 0.1rem; z-index: 100; backdrop-filter: blur(10px); }
    .nav-group:hover .nav-group-menu { display: flex; }
    .nav-group-menu a { display: block; padding: 0.4rem 0.75rem; border-radius: 0.5rem; white-space: nowrap; opacity: 0.85; }
    .nav-group-menu a:hover { background: rgba(255,255,255,0.08); opacity: 1; }

    .main-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.72fr);
      gap: 1.4rem;
      align-items: start;
    }
  
    .left-column,
    .right-column {
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
    }
  
    .quote-card {
      background: rgba(255, 255, 255, 0.83);
      color: var(--text-dark);
      min-height: 315px;
      border-radius: var(--radius-xl);
      padding: 2.05rem 2.2rem;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      backdrop-filter: blur(3px);
    }
  
    .quote-card .eyebrow {
      font-size: 0.92rem;
      letter-spacing: 0.04em;
      opacity: 0.55;
      margin-bottom: 0.7rem;
      text-transform: uppercase;
    }

    .quote-card h1 {
      margin: 0 0 1rem 0;
      font-size: 1.95rem;
      line-height: 1.08;
      font-weight: 700;
    }

    .quote-text {
      font-size: 1.55rem;
      line-height: 1.62;
      margin: 0;
      font-weight: 450;
    }

    /* ── A/B comparison ── */
    .ab-hint {
      font-size: 0.88rem;
      color: #666;
      margin: 0 0 1rem;
      letter-spacing: 0.02em;
    }

    .ab-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .ab-card {
      background: #f0f2f5;
      border: 2px solid transparent;
      border-radius: 0.9rem;
      padding: 0.9rem 1rem 0.75rem;
      text-align: left;
      transition: border-color 0.15s, background 0.15s;
    }

    .ab-card.chosen {
      border-color: var(--accent-blue);
      background: #e8f1fb;
    }

    .ab-badge {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: #999;
      margin-bottom: 0.45rem;
    }

    .ab-text {
      font-size: 0.95rem;
      line-height: 1.55;
      color: #222;
      margin: 0 0 0.75rem;
    }

    .ab-btn {
      margin: 0;
      padding: 0.35rem 0.85rem;
      font-size: 0.82rem;
      font-weight: 600;
      border-radius: 999px;
      border: 1.5px solid var(--accent-blue);
      background: transparent;
      color: var(--accent-blue);
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }

    .ab-btn:hover { background: var(--accent-blue); color: white; }
    .ab-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    .ab-who {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: #666;
      margin-top: 0.25rem;
    }

    .ab-player-btn {
      margin: 0;
      padding: 0.2rem 0.7rem;
      font-size: 0.82rem;
      font-weight: 700;
      border-radius: 999px;
      border: 1.5px solid #bbb;
      background: transparent;
      color: #444;
      cursor: pointer;
    }

    .ab-player-btn:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
    .ab-player-btn.selected { background: var(--accent-blue); border-color: var(--accent-blue); color: white; }

    .ab-result {
      margin-top: 0.9rem;
      padding: 0.75rem 1rem;
      background: #e8f1fb;
      border-radius: 0.8rem;
      font-size: 0.88rem;
      color: #1a1a2e;
      line-height: 1.6;
    }

    .ab-result strong { color: var(--accent-blue); }

    .ab-scores {
      margin-top: 0.5rem;
      font-size: 0.82rem;
      color: #555;
    }

    .ab-scores .score-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.3rem;
    }

    .ab-scores .bar-fill {
      height: 6px;
      border-radius: 999px;
      background: var(--accent-blue);
      transition: width 0.3s;
    }

    .ab-scores .bar-track {
      flex: 1;
      height: 6px;
      background: #ddd;
      border-radius: 999px;
      overflow: hidden;
    }
  
    .small-card,
    .thoughts-card {
      background: var(--glass-mid);
      color: white;
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.15rem;
      backdrop-filter: blur(10px);
      box-shadow: 0 12px 28px rgba(0,0,0,0.14);
      border: 1px solid rgba(10, 116, 201, 0.10);
    }
  
    .thoughts-card {
      border-left: 4px solid var(--accent-blue);
    }
  
    .small-card h3,
    .thoughts-card h3 {
      margin: 0 0 0.7rem 0;
      font-size: 1.2rem;
    }
  
    .small-card p {
      margin: 0;
      line-height: 1.55;
      color: rgba(255,255,255,0.94);
    }
  
    .calendar-link {
      display: inline-block;
      margin-top: 0.85rem;
      color: var(--accent-blue);
      text-decoration: underline;
      text-underline-offset: 2px;
      opacity: 0.98;
      font-weight: 600;
    }
  
    .calendar-link:hover {
      color: var(--accent-blue);
      opacity: 0.92;
    }
  
    .event-item {
      margin-bottom: 0.7rem;
      padding-bottom: 0.7rem;
      border-bottom: 1px solid rgba(255,255,255,0.10);
    }
  
    .event-item:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }
  
    .event-title {
      font-weight: 700;
      margin-bottom: 0.2rem;
    }
  
    .event-note {
      color: var(--muted-light);
      font-size: 0.95rem;
      line-height: 1.45;
    }

    #commentList {
      margin-bottom: 0.9rem;
    }
    
    .thought-item {
      padding: 0.22rem 0 0.5rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    
    .thought-item:last-child {
      border-bottom: none;
    }
    
    .thought-text {
      font-size: 0.95rem;
      line-height: 1.45;
      color: rgba(255,255,255,0.96);
      cursor: pointer;
      user-select: none;
    }

    .thought-text:hover {
      color: var(--accent-blue);
    }
            
    textarea {
      width: 100%;
      min-height: 82px;
      margin-top: 0.35rem;
      padding: 0.75rem 0.85rem;
      border-radius: 0.85rem;
      border: 1px solid transparent;
      font-family: inherit;
      font-size: 0.96rem;
      resize: vertical;
    }
  
    textarea:focus {
      outline: none;
      border-color: var(--accent-blue);
      box-shadow: 0 0 0 4px var(--accent-blue-soft);
    }
  
    button {
      margin-top: 0.7rem;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      border: none;
      background: var(--accent-blue);
      color: white;
      cursor: pointer;
      font-weight: 600;
    }
  
    button:hover {
      background: var(--accent-blue);
      opacity: 0.92;
    }
  
    .muted {
      opacity: 0.70;
    }
  
    .weather-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }

    .weather-header h3 {
      margin: 0;
    }

    .city-toggle {
      display: flex;
      gap: 0.3rem;
    }

    .city-btn {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.65);
      border-radius: 999px;
      padding: 0.2rem 0.65rem;
      font-size: 0.78rem;
      cursor: pointer;
      transition: all 0.15s;
    }

    .city-btn.active {
      background: var(--accent-blue);
      border-color: var(--accent-blue);
      color: white;
    }

    .weather-summary {
      font-size: 0.88rem;
      color: rgba(255,255,255,0.82);
      margin-bottom: 0.5rem;
      line-height: 1.5;
    }

    .weather-gpt {
      font-size: 0.82rem;
      color: rgba(255,255,255,0.6);
      line-height: 1.45;
      margin-bottom: 0.75rem;
    }

    .weather-chart {
      width: 100%;
      border-radius: 0.6rem;
      margin-top: 0.25rem;
    }

    .weather-alignment {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      margin-bottom: 0.5rem;
    }

    .weather-alignment.full     { background: rgba(34,197,94,0.18); color: #4ade80; }
    .weather-alignment.partial  { background: rgba(234,179,8,0.18);  color: #fbbf24; }
    .weather-alignment.divergent{ background: rgba(239,68,68,0.18);  color: #f87171; }

    @media (max-width: 900px) {
      .main-grid { grid-template-columns: 1fr; }
      .quote-card { min-height: 250px; padding: 1.7rem 1.4rem; }
      .quote-card h1 { font-size: 1.7rem; }
      .quote-text { font-size: 1.28rem; }
    }

    @media (max-width: 560px) {
      .ab-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="top-nav">
      <div class="nav-pill">
        <a href="/calendar">📅 Calendar</a>
        <div class="nav-group">
          <span class="nav-group-label">🎮 Games ▾</span>
          <div class="nav-group-menu">
            <a href="/bets">🎲 Bets</a>
            <a href="/scores">🏆 Scores</a>
            <a href="/poker">🃏 Poker</a>
          </div>
        </div>
        <a href="/overview">📋 Overview</a>
        <a href="/home">🏠 Home</a>
        <a href="/notes">📝 Notes</a>
        <a href="/archive">🗂 Archive</a>
      </div>
    </div>

    <main class="main-grid">
      <section class="left-column">
        <section class="quote-card">
          <div class="eyebrow">Today</div>
          <h1>Daily reflection</h1>

          <!-- A/B comparison (shown when both models generated) -->
          <div id="abView" style="display:none">
            <p class="ab-hint">Two versions — which do you prefer?</p>
            <div class="ab-grid">
              <div class="ab-card" id="abCardA">
                <div class="ab-badge">OPTION A</div>
                <p class="ab-text" id="abTextA"></p>
                <button class="ab-btn" id="abBtnA">Prefer A</button>
              </div>
              <div class="ab-card" id="abCardB">
                <div class="ab-badge">OPTION B</div>
                <p class="ab-text" id="abTextB"></p>
                <button class="ab-btn" id="abBtnB">Prefer B</button>
              </div>
            </div>
            <div id="abWho" class="ab-who">
              <span>I'm</span>
              <button class="ab-player-btn" data-p="LM">LM</button>
              <button class="ab-player-btn" data-p="BM">BM</button>
            </div>
            <div id="abResult" class="ab-result" style="display:none"></div>
          </div>

          <!-- Fallback: single reflection (no A/B data yet) -->
          <p id="dailyReflection" class="quote-text" style="display:none">Loading...</p>
        </section>

        <section class="thoughts-card">
          <h3>💬 Thoughts</h3>
          <div id="commentList"><div class="muted">Loading thoughts...</div></div>
          <textarea id="commentInput" placeholder="Leave a thought..."></textarea>
          <button id="saveComment" type="button">Add</button>
        </section>
      </section>

      <aside class="right-column">
        <section class="small-card">
          <h3>Fun fact</h3>
          <p id="dailyFun">Loading...</p>
        </section>

        <section class="small-card">
          <h3>Today on the calendar</h3>
          <div id="todayCalendar">
            <div class="muted">Loading today's events...</div>
          </div>
          <a class="calendar-link" href="/calendar">Open calendar</a>
        </section>

        <section class="small-card" id="weatherCard">
          <div class="weather-header">
            <h3>🌤 Weather</h3>
            <div class="city-toggle">
              <button class="city-btn active" data-city="brussels">Brussels</button>
              <button class="city-btn" data-city="paris">Paris</button>
            </div>
          </div>
          <div id="weatherContent"><div class="muted">Loading...</div></div>
        </section>
      </aside>
    </main>
  </div>

  <script type="module" is:inline>
    const reflectionEl = document.getElementById("dailyReflection");
    const funEl = document.getElementById("dailyFun");
    const calendarBox = document.getElementById("todayCalendar");
    const list = document.getElementById("commentList");
    const input = document.getElementById("commentInput");
    const button = document.getElementById("saveComment");

    const today = new Date().toISOString().slice(0, 10);
    let todayThoughts = [];

    // ── A/B vote state ──
    let abPlayer = localStorage.getItem("abPlayer"); // "LM" | "BM" | null
    let abData = null; // today's ab object from generateDaily

    function updatePlayerButtons() {
      document.querySelectorAll(".ab-player-btn").forEach(btn => {
        btn.classList.toggle("selected", btn.dataset.p === abPlayer);
      });
    }

    document.querySelectorAll(".ab-player-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        abPlayer = btn.dataset.p;
        localStorage.setItem("abPlayer", abPlayer);
        updatePlayerButtons();
        // If ab is loaded, check vote state now
        if (abData) loadVoteState();
      });
    });

    async function callVote(body) {
      const res = await fetch("/.netlify/functions/daily-vote", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...body, player: abPlayer }),
      });
      return res.json();
    }

    function renderScores(scores) {
      const total = (scores.openai || 0) + (scores.anthropic || 0);
      if (total === 0) return '<div class="ab-scores">No votes yet.</div>';
      const claudePct = total ? Math.round((scores.anthropic / total) * 100) : 0;
      const gptPct = 100 - claudePct;
      return `<div class="ab-scores">
        <strong>Running scores</strong> (${total} vote${total !== 1 ? "s" : ""})
        <div class="score-bar">
          <span style="width:3.5em;font-size:0.8rem">Claude</span>
          <div class="bar-track"><div class="bar-fill" style="width:${claudePct}%"></div></div>
          <span style="font-size:0.8rem">${scores.anthropic || 0}</span>
        </div>
        <div class="score-bar">
          <span style="width:3.5em;font-size:0.8rem">GPT-4o</span>
          <div class="bar-track"><div class="bar-fill" style="width:${gptPct}%;background:#e67e22"></div></div>
          <span style="font-size:0.8rem">${scores.openai || 0}</span>
        </div>
      </div>`;
    }

    function renderVoteResult(data) {
      const resultEl = document.getElementById("abResult");
      const { myVote, oppVote, scores } = data;
      const oppName = abPlayer === "LM" ? "BM" : "LM";

      let html = `<div>You chose <strong>${myVote.choice}</strong> — that was <strong>${myVote.label}</strong>.</div>`;

      if (oppVote?.model) {
        html += `<div style="margin-top:0.3rem">${oppName} chose <strong>${oppVote.choice}</strong> — <strong>${oppVote.label}</strong>.</div>`;
      } else if (oppVote?.choice) {
        html += `<div style="margin-top:0.3rem">${oppName} chose <strong>${oppVote.choice}</strong> (vote first to see their model).</div>`;
      } else {
        html += `<div style="margin-top:0.3rem;color:#888">${oppName} hasn't voted yet.</div>`;
      }

      html += renderScores(scores);
      resultEl.innerHTML = html;
      resultEl.style.display = "";

      // Highlight chosen card
      document.getElementById("abCardA").classList.toggle("chosen", myVote.choice === "A");
      document.getElementById("abCardB").classList.toggle("chosen", myVote.choice === "B");

      // Disable vote buttons
      document.getElementById("abBtnA").disabled = true;
      document.getElementById("abBtnB").disabled = true;
      document.getElementById("abWho").style.display = "none";
    }

    async function loadVoteState() {
      if (!abPlayer || !abData) return;
      try {
        const data = await callVote({ action: "get_today" });
        if (data.hasVoted) renderVoteResult(data);
      } catch (err) {
        console.error("loadVoteState failed:", err);
      }
    }

    async function submitVote(choice) {
      if (!abPlayer) {
        alert("Please select who you are (LM or BM) first.");
        return;
      }
      try {
        document.getElementById("abBtnA").disabled = true;
        document.getElementById("abBtnB").disabled = true;
        const data = await callVote({ action: "vote", choice });
        if (data.error) {
          alert(data.error);
          document.getElementById("abBtnA").disabled = false;
          document.getElementById("abBtnB").disabled = false;
          return;
        }
        renderVoteResult(data);
      } catch (err) {
        console.error("Vote failed:", err);
        document.getElementById("abBtnA").disabled = false;
        document.getElementById("abBtnB").disabled = false;
      }
    }

    document.getElementById("abBtnA").addEventListener("click", () => submitVote("A"));
    document.getElementById("abBtnB").addEventListener("click", () => submitVote("B"));
  
    function escapeHtml(str) {
      return String(str)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }
  
    function iconForType(type) {
      return {
        note: "📝",
        plan: "📍",
        memory: "🧠",
        occasion: "🌟",
      }[type] || "📝";
    }
  
    async function loadDailyContent() {
      try {
        const cacheKey = `daily-${today}`;
        const cached = sessionStorage.getItem(cacheKey);

        let data;
        if (cached) {
          data = JSON.parse(cached);
        }

        if (!data) {
          const res = await fetch("/.netlify/functions/generateDaily");
          data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data?.error || `generateDaily failed with ${res.status}`);
          // Always cache so we don't keep re-fetching on every page load
          if (data?.reflective?.text) {
            sessionStorage.setItem(cacheKey, JSON.stringify(data));
          }
        }

        funEl.textContent = data?.fun?.text || "No fun fact available.";

        if (data?.ab?.A?.text && data?.ab?.B?.text) {
          // Show A/B comparison
          abData = data.ab;
          document.getElementById("abTextA").textContent = data.ab.A.text;
          document.getElementById("abTextB").textContent = data.ab.B.text;
          document.getElementById("abView").style.display = "";
          reflectionEl.style.display = "none";
          updatePlayerButtons();
          await loadVoteState();
        } else {
          // Fallback: single reflection
          reflectionEl.textContent = data?.reflective?.text || "No reflection available.";
          reflectionEl.style.display = "";
          document.getElementById("abView").style.display = "none";
        }
      } catch (err) {
        console.error("Failed to load daily content:", err);
        reflectionEl.textContent = "Could not load today's reflection.";
        reflectionEl.style.display = "";
        funEl.textContent = "Could not load today's fun fact.";
      }
    }
  
    async function loadTodayCalendar() {
      try {
        const res = await fetch("/.netlify/functions/calendar-load", {
          cache: "no-store",
        });
  
        const data = await res.json().catch(() => ({}));
  
        if (!res.ok) {
          throw new Error(data?.error || `calendar-load failed with ${res.status}`);
        }
  
        const now = new Date();
        const key =
          `${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
  
        const events = Array.isArray(data?.[key]) ? data[key] : [];
  
        if (!events.length) {
          calendarBox.innerHTML = `<div class="muted">Nothing saved for today.</div>`;
          return;
        }
  
        calendarBox.innerHTML = events.map((e) => `
          <div class="event-item">
            <div class="event-title">${iconForType(e.type)} ${escapeHtml(e.title || "Untitled")}</div>
            ${e.note ? `<div class="event-note">${escapeHtml(e.note)}</div>` : ""}
          </div>
        `).join("");
      } catch (err) {
        console.error("Failed to load today's calendar:", err);
        calendarBox.innerHTML = `<div class="muted">Could not load today's events.</div>`;
      }
    }
  
    async function loadThoughts() {
      try {
        const data = await callContent({ type: "thoughts", action: "list" });
        const entries = Array.isArray(data?.entries) ? data.entries : [];
        todayThoughts = entries
          .filter((item) => item.date === today)
          .sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
        renderThoughts();
      } catch (err) {
        console.error("Failed to load thoughts:", err);
        list.innerHTML = `<div class="muted">Could not load thoughts.</div>`;
      }
    }
  
    async function callContent(body) {
      const res = await fetch("/.netlify/functions/content", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.error || "content failed");
      return data;
    }

    function renderThoughts() {
      list.innerHTML = todayThoughts.length
        ? todayThoughts
            .map((item) => `
              <div class="thought-item" data-id="${item.id}">
                <div
                  class="thought-text"
                  data-id="${item.id}"
                  role="button"
                  tabindex="0"
                  aria-label="Click to edit thought"
                >${escapeHtml(item.text || "")}</div>
              </div>
            `)
            .join("")
        : `<div class="muted">No thoughts yet.</div>`;

      document.querySelectorAll(".thought-text").forEach((el) => {
        const handle = async (event) => {
          event.stopPropagation();
          const id = el.getAttribute("data-id");
          if (!id) return;
          const current = el.textContent;
          const edited = window.prompt("Edit thought\n(clear + OK to delete):", current);
          if (edited === null) return;
          try {
            if (edited.trim() === "") {
              await callContent({ type: "thoughts", action: "delete", id });
            } else if (edited.trim() !== current) {
              await callContent({ type: "thoughts", action: "update", id, data: { text: edited.trim() } });
            }
            await loadThoughts();
          } catch (err) {
            console.error("Failed to update thought:", err);
            alert("Could not update the thought.");
          }
        };
        el.addEventListener("click", handle);
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); handle(e); }
        });
      });
    }
  
    button.addEventListener("click", async () => {
      const text = input.value.trim();
      if (!text) return;
  
      button.disabled = true;
  
      try {
        const res = await fetch("/.netlify/functions/content", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            type: "thoughts",
            action: "add",
            data: {
              date: today,
              text,
            },
          }),
        });
  
        const data = await res.json().catch(() => ({}));
  
        if (!res.ok) {
          throw new Error(data?.error || `content add failed with ${res.status}`);
        }
  
        input.value = "";
        await loadThoughts();
      } catch (err) {
        console.error("Failed to save thought:", err);
        alert("Could not save the thought.");
      } finally {
        button.disabled = false;
      }
    });
  
    loadDailyContent();
    loadTodayCalendar();
    loadThoughts();

    // --- Weather widget ---
    const WEATHER_BASE = "https://raw.githubusercontent.com/FGieb/WeatherBot/main/docs/";
    let currentCity = "brussels";

    async function loadWeather(city) {
      const box = document.getElementById("weatherContent");
      box.innerHTML = '<div class="muted">Loading...</div>';
      try {
        const res = await fetch(`${WEATHER_BASE}${city}_forecast.json`);
        if (!res.ok) throw new Error("Not found");
        const d = await res.json();
        const alignClass = (d.alignment || "").toLowerCase();
        box.innerHTML = `
          <span class="weather-alignment ${alignClass}">${d.alignment || "—"}</span>
          <div class="weather-summary">${escapeHtml(d.summary || "")}</div>
          <div class="weather-gpt">${escapeHtml(d.gpt_comment || "")}</div>
          <img class="weather-chart" src="${WEATHER_BASE}${city}_comparison.png" alt="${city} weather chart" loading="lazy" />
        `;
      } catch {
        box.innerHTML = '<div class="muted">Weather data unavailable.</div>';
      }
    }

    document.querySelectorAll(".city-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".city-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentCity = btn.dataset.city;
        loadWeather(currentCity);
      });
    });

    loadWeather(currentCity);
  </script>
  
</body>
</html>
