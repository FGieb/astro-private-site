---
const cookie = Astro.cookies.get("auth");
if (!cookie || cookie.value !== "1") {
  return Astro.redirect("/login");
}

import Nav from "../components/Nav.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Private Home</title>

    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url("/images/homebackground.jpg");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        color: white;
        padding: 2.5rem;
        position: relative;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(6px);
        z-index: -1;
        pointer-events: none;
      }

      /* === LAYOUT === */
      .home-layout {
        display: grid;
        grid-template-columns: 1fr minmax(240px, 280px);
        gap: 2.5rem;
        max-width: 1050px;
        margin: 0 auto;
        align-items: start;
      }

      .main-column {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* === WELCOME === */
      .welcome {
        margin-bottom: 2rem;
        text-align: center;
        opacity: 0.9;
      }

      .welcome h1 {
        font-size: 1.9rem;
        margin-bottom: 0.3rem;
        font-weight: 600;
      }

      .welcome p {
        font-size: 0.95rem;
        opacity: 0.7;
      }

      /* === DAILY REFLECTION === */
      .daily-reflection {
        background: rgba(255, 255, 255, 0.9);
        color: #111;
        padding: 1.5rem 1.8rem;
        border-radius: 1.1rem;
        max-width: 600px;
        text-align: center;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        margin-bottom: 2.2rem;
      }

      .daily-reflection h2 {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.8rem;
        opacity: 0.6;
      }

      .reflection-text {
        font-size: 1.15rem;
        line-height: 1.6;
        opacity: 0.85;
      }

      .placeholder {
        opacity: 0.75;
      }

      /* === MEDIA === */
      .media {
        max-width: 260px;
        width: 100%;
        height: auto;
        border-radius: 0.8rem;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
        margin-top: 2rem;
      }

      /* === SIDE PANEL === */
      .side-panel {
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(4px);
        border-radius: 1rem;
        padding: 1.2rem;
        font-size: 0.9rem;
        opacity: 0.95;
      }

      .today-event h3 {
        margin-top: 0;
        font-size: 1rem;
        opacity: 0.85;
        margin-bottom: 0.75rem;
      }

      .today-event .event-item {
        margin-bottom: 0.9rem;
        font-size: 0.85rem;
      }

      .event-note {
        opacity: 0.7;
        margin-top: 0.25rem;
      }

      .hidden {
        display: none;
      }

      /* === MOBILE === */
      @media (max-width: 900px) {
        .home-layout {
          grid-template-columns: 1fr;
        }

        .side-panel {
          order: -1;
        }
      }
    </style>
  </head>

  <body>
    <Nav />

    <div class="welcome">
      <h1>🐒 Goedemiddag, monkey</h1>
      <p>Still becoming.</p>
    </div>

    <div class="home-layout">
      <!-- MAIN -->
      <div class="main-column">
        <div class="daily-reflection placeholder">
          <h2>Today</h2>
          <p class="reflection-text">
            Today’s reflection will appear here.
          </p>
        </div>

        <img id="dailyMedia" alt="Daily Visual" class="media" style="display: none;" />
        <video id="dailyVideo" class="media" controls style="display: none;">
          <source id="videoSource" type="video/mp4" />
        </video>
        <img id="fallbackImage" alt="Fallback visual" class="media" style="display: none;" />
      </div>

      <!-- SIDE -->
      <aside class="side-panel">
        <section id="todayEvent" class="today-event hidden">
          <h3>📅 Today</h3>
          <div id="todayEventContent"></div>
        </section>
      </aside>
    </div>

    <!-- === MEDIA SCRIPT === -->
    <script type="module" is:inline>
      const base = "https://res.cloudinary.com/du2rss0bx";
      let gallery = [];

      try {
        const res = await fetch("/.netlify/functions/getGallery");
        gallery = await res.json();
      } catch {}

      const fallback = document.getElementById("fallbackImage");
      const img = document.getElementById("dailyMedia");
      const video = document.getElementById("dailyVideo");
      const videoSource = document.getElementById("videoSource");

      const fallbackImages = [
        "IMG_20250515_120530.jpg",
        "IMG_20250515_121218.jpg",
        "IMG_20250515_135154.jpg",
        "IMG_20250515_192053.jpg",
        "IMG-20240906-WA0006.jpg",
        "IMG-20241020-WA0029.jpg",
        "IMG-20241104-WA0059.jpg",
        "IMG-20250130-WA0081.jpg",
        "IMG-20250130-WA0099.jpg",
        "IMG-20250303-WA0051.jpg",
        "IMG-20250317-WA0027.jpg",
        "IMG-20250407-WA0017.jpg",
        "IMG-20250415-WA0048.jpg",
        "IMG-20250415-WA0062.jpg",
        "IMG-20250510-WA0007.jpg",
        "IMG20250510210447.jpg"
      ];

      const tryUrl = (url) =>
        fetch(url, { method: "HEAD" }).then(r => r.ok).catch(() => false);

      const showMedia = async () => {
        const day = new Date().getDate();

        for (let offset = 0; offset < 7; offset++) {
          const index = (day + offset) % gallery.length;
          const id = gallery[index];
          const paths = [
            `${base}/image/upload/daily-images/${id}.jpg`,
            `${base}/video/upload/daily-images/${id}.mov`
          ];

          for (const url of paths) {
            const ok = await tryUrl(url);
            if (ok) {
              if (url.endsWith(".jpg")) {
                img.src = url;
                img.style.display = "block";
              } else {
                videoSource.src = url;
                video.load();
                video.style.display = "block";
              }
              return;
            }
          }
        }

        fallback.src = `/images/${fallbackImages[day % fallbackImages.length]}`;
        fallback.style.display = "block";
      };

      showMedia();
    </script>

    <!-- === TODAY EVENT SCRIPT === -->
    <script type="module" is:inline>
      const container = document.getElementById("todayEvent");
      const content = document.getElementById("todayEventContent");

      const keyForToday = () => {
        const d = new Date();
        return `${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      };

      const events = JSON.parse(localStorage.getItem("calendarEvents") || "{}");
      const todayEvents = events[keyForToday()];

      if (todayEvents?.length) {
        container.classList.remove("hidden");
        content.innerHTML = todayEvents.map(evt => `
          <div class="event-item">
            <strong>${evt.title}</strong>
            ${evt.note ? `<div class="event-note">${evt.note}</div>` : ""}
          </div>
        `).join("");
      }
    </script>
  </body>
</html>