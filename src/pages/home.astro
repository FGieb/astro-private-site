---
const cookie = Astro.cookies.get("auth");
if (!cookie || cookie.value !== "1") {
  return Astro.redirect("/login");
}

import Nav from "../components/Nav.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Private Home</title>

    <style>
      /* === BASE === */
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url("/images/homebackground.jpg");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        color: white;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7);
        padding: 2rem;
        position: relative;
      }

      /* Soft overlay to calm background */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: -1;
      }

      /* === LAYOUT === */
      .home-layout {
        display: grid;
        grid-template-columns: 1fr minmax(240px, 300px);
        gap: 2.5rem;
        max-width: 1100px;
        margin: 0 auto;
        align-items: start;
      }

      .main-column {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* === WELCOME === */
      .welcome {
        text-align: center;
        margin-bottom: 2.5rem;
        opacity: 0.9;
      }

      .welcome h1 {
        font-size: 2rem;
        margin-bottom: 0.3rem;
        font-weight: 600;
      }

      .welcome p {
        font-size: 0.95rem;
        opacity: 0.7;
      }

      /* === DAILY REFLECTION === */
      .daily-reflection {
        background: rgba(255, 255, 255, 0.88);
        color: #111;
        padding: 1.4rem 1.6rem;
        border-radius: 1rem;
        max-width: 560px;
        width: 100%;
        text-align: center;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
        margin-bottom: 2rem;
      }

      .daily-reflection h2 {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.8rem;
        opacity: 0.6;
        letter-spacing: 0.02em;
      }

      .reflection-text {
        font-size: 1.1rem;
        line-height: 1.55;
        opacity: 0.9;
      }

      .placeholder {
        opacity: 0.75;
      }

      /* === MEDIA === */
      .media {
        max-width: 320px;
        width: 100%;
        border-radius: 0.9rem;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45);
        margin-bottom: 2rem;
      }

      /* === SIDE PANEL / TODAY === */
      .side-panel {
        background: rgba(0, 0, 0, 0.55);
        border-radius: 1rem;
        padding: 1.2rem;
        font-size: 0.95rem;
      }

      .today-event h3 {
        margin-top: 0;
        font-size: 1.1rem;
        margin-bottom: 0.8rem;
        opacity: 0.85;
      }

      .today-event .event-item {
        margin-bottom: 0.9rem;
        font-size: 0.95rem;
      }

      .event-note {
        opacity: 0.75;
        margin-top: 0.25rem;
      }

      .hidden {
        display: none;
      }

      /* === MOBILE === */
      @media (max-width: 900px) {
        body {
          padding: 1.5rem 1.2rem;
        }

        body::before {
          background: rgba(0, 0, 0, 0.65);
          backdrop-filter: blur(8px);
        }

        .home-layout {
          grid-template-columns: 1fr;
        }

        .welcome h1 {
          font-size: 1.8rem;
        }

        .media {
          max-width: 280px;
        }

        .side-panel {
          order: 2;
          margin-top: 2rem;
          background: rgba(255, 255, 255, 0.12);
        }

        .today-event h3 {
          font-size: 1.15rem;
        }

        .today-event .event-item {
          font-size: 1rem;
        }
      }
    </style>
  </head>

  <body>
    <Nav />

    <div class="welcome">
      <h1>🐒 Goedemiddag, monkey</h1>
      <p>Still becoming.</p>
    </div>

    <div class="home-layout">
      <!-- MAIN -->
      <div class="main-column">
        <div class="daily-reflection placeholder">
          <h2>Today</h2>
          <p class="reflection-text">
            Today’s reflection will appear here.
          </p>
        </div>

        <img id="dailyMedia" class="media" style="display:none" />
        <video id="dailyVideo" class="media" controls style="display:none">
          <source id="videoSource" type="video/mp4" />
        </video>
        <img id="fallbackImage" class="media" style="display:none" />
      </div>

      <!-- SIDE -->
      <aside class="side-panel">
        <section id="todayEvent" class="today-event hidden">
          <h3>📅 Today</h3>
          <div id="todayEventContent"></div>
        </section>
      </aside>
    </div>

    <!-- === MEDIA SCRIPT === -->
    <script type="module" is:inline>
      const base = "https://res.cloudinary.com/du2rss0bx";
      let gallery = [];

      try {
        const res = await fetch("/.netlify/functions/getGallery");
        gallery = await res.json();
      } catch {}

      const img = document.getElementById("dailyMedia");
      const video = document.getElementById("dailyVideo");
      const source = document.getElementById("videoSource");
      const fallback = document.getElementById("fallbackImage");

      const tryUrl = (url) =>
        fetch(url, { method: "HEAD" }).then(r => r.ok).catch(() => false);

      const showMedia = async () => {
        const day = new Date().getDate();

        for (let i = 0; i < gallery.length; i++) {
          const id = gallery[(day + i) % gallery.length];
          const jpg = `${base}/image/upload/daily-images/${id}.jpg`;
          const mov = `${base}/video/upload/daily-images/${id}.mov`;

          if (await tryUrl(jpg)) {
            img.src = jpg;
            img.style.display = "block";
            return;
          }
          if (await tryUrl(mov)) {
            source.src = mov;
            video.load();
            video.style.display = "block";
            return;
          }
        }
      };

      showMedia();
    </script>

    <!-- === TODAY EVENT SCRIPT === -->
    <script type="module" is:inline>
      const container = document.getElementById("todayEvent");
      const content = document.getElementById("todayEventContent");

      const key = () => {
        const d = new Date();
        return `${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      };

      const events = JSON.parse(localStorage.getItem("calendarEvents") || "{}");
      const today = events[key()];

      if (today?.length) {
        container.classList.remove("hidden");
        content.innerHTML = today.map(e => `
          <div class="event-item">
            <strong>${e.title}</strong>
            ${e.note ? `<div class="event-note">${e.note}</div>` : ""}
          </div>
        `).join("");
      }
    </script>
  </body>
</html>