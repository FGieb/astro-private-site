---
const cookie = Astro.cookies.get("auth");
if (!cookie || cookie.value !== "1") {
  return Astro.redirect("/login");
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Private Home</title>

  <style>
    :root {
      --card-bg: rgba(255,255,255,0.88);
      --side-bg: rgba(0,0,0,0.45);
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      color: white;
      background:
        linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.65)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    /* NAV */
    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 1.25rem;
    }

    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(0,0,0,0.55);
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      backdrop-filter: blur(6px);
    }

    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.85;
    }

    .nav-pill a:hover { opacity: 1; }

    /* LAYOUT */
    .layout {
      max-width: 980px;
      margin: 3rem auto 0;
      padding: 0 1.25rem 4rem;
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 2rem;
      align-items: start;
    }

    /* CENTER */
    .center {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .welcome h1 {
      font-size: 2rem;
      margin-bottom: 0.25rem;
    }

    .welcome p {
      font-size: 0.95rem;
      opacity: 0.7;
      margin-bottom: 2rem;
    }

    .reflection-card {
      background: var(--card-bg);
      color: #111;
      padding: 1.6rem 1.8rem;
      border-radius: 1.25rem;
      width: 100%;
      max-width: 560px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.25);
      margin-bottom: 1.2rem;
    }

    .reflection-card h2 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      opacity: 0.5;
      margin-bottom: 0.75rem;
    }

    .reflection-text {
      font-size: 1.1rem;
      line-height: 1.55;
    }

    /* COMMENTS */
    .thoughts {
      background: rgba(0,0,0,0.45);
      border-radius: 1rem;
      padding: 1rem 1.2rem;
      width: 100%;
      max-width: 420px;
      text-align: left;
      backdrop-filter: blur(6px);
    }

    .thoughts h3 {
      font-size: 0.9rem;
      opacity: 0.8;
      margin-bottom: 0.6rem;
    }

    #commentList div {
      font-size: 0.9rem;
      margin-bottom: 0.35rem;
    }

    textarea {
      width: 100%;
      margin-top: 0.5rem;
      padding: 0.6rem;
      border-radius: 0.6rem;
      border: none;
      font-family: inherit;
    }

    button {
      margin-top: 0.5rem;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      border: none;
      background: rgba(255,255,255,0.9);
      cursor: pointer;
    }

    /* RIGHT RAIL */
    .side {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .side-card {
      background: var(--side-bg);
      border-radius: 1rem;
      padding: 1rem 1.1rem;
      backdrop-filter: blur(6px);
      font-size: 0.9rem;
    }

    .side-card h4 {
      font-size: 0.8rem;
      opacity: 0.7;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .side-link {
      margin-top: 0.6rem;
      font-size: 0.8rem;
      opacity: 0.75;
    }

    .side-link a {
      color: white;
      text-decoration: none;
    }

    .side-link a:hover { opacity: 1; }

    /* MOBILE */
    @media (max-width: 820px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .side {
        order: 2;
      }

      .center {
        order: 1;
      }
    }
  </style>
</head>

<body>
  <div class="top-nav">
    <div class="nav-pill">
      <a href="/calendar">📅 Calendar</a>
      <a href="/home">🏠 Home</a>
      <a href="/notes">📝 Notes</a>
      <a href="/archive">🗂 Archive</a>
    </div>
  </div>

  <main class="layout">

    <!-- CENTER -->
    <section class="center">
      <div class="welcome">
        <h1>🐒 Goedemiddag, monkey</h1>
        <p>Still becoming.</p>
      </div>

      <section class="reflection-card">
        <h2>Today</h2>
        <p id="dailyReflection" class="reflection-text">
          Loading today’s reflection…
        </p>
      </section>

      <section class="thoughts">
        <h3>💬 Thoughts</h3>
        <div id="commentList"></div>
        <textarea id="commentInput" placeholder="Leave a thought…"></textarea>
        <button id="saveComment">Add</button>
      </section>
    </section>

    <!-- RIGHT RAIL -->
    <aside class="side">

      <div id="todayEvent" class="side-card" style="display:none;">
        <h4>📍 Today</h4>
        <div id="todayEventContent"></div>
        <div class="side-link">
          <a href="/calendar">↗ Open calendar</a>
        </div>
      </div>

      <div class="side-card">
        <h4>💡 Also today</h4>
        <div id="funFact">Loading…</div>
      </div>

    </aside>

  </main>

  <!-- CALENDAR -->
  <script type="module" is:inline>
    const container = document.getElementById("todayEvent");
    const content = document.getElementById("todayEventContent");

    const keyForToday = () => {
      const d = new Date();
      return `${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
    };

    const events = JSON.parse(localStorage.getItem("calendarEvents") || "{}");
    const todayEvents = events[keyForToday()];

    if (todayEvents?.length) {
      container.style.display = "block";
      content.innerHTML = todayEvents.map(evt => `
        <div><strong>${evt.title}</strong></div>
      `).join("");
    }
  </script>

  <!-- DAILY CONTENT -->
  <script type="module" is:inline>
    async function loadDaily() {
      try {
        const res = await fetch("/.netlify/functions/generateDaily");
        const data = await res.json();
        document.getElementById("dailyReflection").textContent =
          data.reflective.text;
        document.getElementById("funFact").textContent =
          data.fun.text;
      } catch {
        document.getElementById("dailyReflection").textContent =
          "Today will reveal itself later.";
      }
    }
    loadDaily();
  </script>

  <!-- COMMENTS -->
  <script type="module" is:inline>
    const date = new Date().toISOString().slice(0,10);
  
    const list = document.getElementById("commentList");
    const input = document.getElementById("commentInput");
    const button = document.getElementById("saveComment");
  
    async function submitComment() {
      if (!input.value.trim()) return;
  
      await fetch("/.netlify/functions/addComment", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          date,
          text: input.value.trim()
        })
      });
  
      input.value = "";
      loadComments();
    }
  
    async function loadComments() {
      const res = await fetch("/.netlify/functions/generateDaily");
      const data = await res.json();
  
      const comments = data.comments || [];
      list.innerHTML = comments
        .map(c => `<div>– ${c.text}</div>`)
        .join("");
    }
  
    button.addEventListener("click", submitComment);
    loadComments();
  </script>

</body>
</html>
