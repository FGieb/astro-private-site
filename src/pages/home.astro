---
const cookie = Astro.cookies.get("auth");
if (!cookie || cookie.value !== "1") {
  return Astro.redirect("/login");
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Private Home</title>

  <style>
    :root {
      --card-bg: rgba(255,255,255,0.88);
      --side-bg: rgba(0,0,0,0.45);
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      color: white;
      background:
        linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.65)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 1.25rem;
    }

    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(0,0,0,0.55);
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      backdrop-filter: blur(6px);
    }

    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.85;
    }

    .nav-pill a:hover { opacity: 1; }

    .layout {
      max-width: 980px;
      margin: 3rem auto 0;
      padding: 0 1.25rem 4rem;
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 2rem;
    }

    .center {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .reflection-card {
      background: var(--card-bg);
      color: #111;
      padding: 1.6rem 1.8rem;
      border-radius: 1.25rem;
      width: 100%;
      max-width: 560px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.25);
      margin-bottom: 1.2rem;
    }

    .thoughts {
      background: rgba(0,0,0,0.45);
      border-radius: 1rem;
      padding: 1rem 1.2rem;
      width: 100%;
      max-width: 420px;
      text-align: left;
      backdrop-filter: blur(6px);
    }

    #commentList div {
      font-size: 0.9rem;
      margin-bottom: 0.35rem;
    }

    textarea {
      width: 100%;
      margin-top: 0.5rem;
      padding: 0.6rem;
      border-radius: 0.6rem;
      border: none;
      font-family: inherit;
    }

    button {
      margin-top: 0.5rem;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      border: none;
      background: rgba(255,255,255,0.9);
      cursor: pointer;
    }
  </style>
</head>

<body>
  <div class="top-nav">
    <div class="nav-pill">
      <a href="/calendar">📅 Calendar</a>
      <a href="/home">🏠 Home</a>
      <a href="/bets">🎲 Bets</a>
      <a href="/notes">📝 Notes</a>
      <a href="/archive">🗂 Archive</a>
    </div>
  </div>

  <main class="layout">
    <section class="center">
      <section class="reflection-card">
        <h2>Today</h2>
        <p id="dailyReflection">Loading…</p>
      </section>

      <section class="thoughts">
        <h3>💬 Thoughts</h3>
        <div id="commentList"></div>
        <textarea id="commentInput" placeholder="Leave a thought…"></textarea>
        <button id="saveComment">Add</button>
      </section>
    </section>
  </main>

  <!-- DAILY CONTENT -->
  <script type="module" is:inline>
    async function loadDailyContent() {
      const res = await fetch("/.netlify/functions/generateDaily");
      const data = await res.json();
      document.getElementById("dailyReflection").textContent =
        data.reflective.text;
    }
    loadDailyContent();
  </script>

  <!-- COMMENTS -->
  <script type="module" is:inline>
    const list = document.getElementById("commentList");
    const input = document.getElementById("commentInput");
    const button = document.getElementById("saveComment");

    const today = new Date().toISOString().slice(0, 10);
    let dailyEntries = {};
    let todayEntry = null;

    async function loadDaily() {
      const res = await fetch("/.netlify/functions/daily-load");
      dailyEntries = await res.json();

      todayEntry = dailyEntries[today] || { comments: [] };
      renderComments();
    }

    async function saveDaily() {
      await fetch("/.netlify/functions/daily-save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          date: today,
          update: { comments: todayEntry.comments },
        }),
      });
    }

    function renderComments() {
      list.innerHTML = todayEntry.comments.length
        ? todayEntry.comments.map(c => `<div>– ${c.text}</div>`).join("")
        : `<div style="opacity:0.6;">No thoughts yet.</div>`;
    }

    button.addEventListener("click", async () => {
      const text = input.value.trim();
      if (!text) return;

      todayEntry.comments.push({
        text,
        createdAt: new Date().toISOString(),
      });

      input.value = "";
      renderComments();
      await saveDaily();
    });

    loadDaily();
  </script>
</body>
</html>
