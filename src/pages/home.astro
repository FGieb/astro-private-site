---
export const prerender = false;
export const runtime = "nodejs";

import { isValidSession } from "../lib/auth";

const cookie = Astro.cookies.get("auth");

if (!(await isValidSession(cookie?.value))) {
  return Astro.redirect("/login");
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Private Home</title>

  <style>
    :root {
      --glass-dark: rgba(10, 16, 28, 0.52);
      --glass-mid: rgba(12, 20, 36, 0.44);
      --glass-light: rgba(255, 255, 255, 0.87);
      --text-dark: #121212;
      --text-light: #ffffff;
      --muted-light: rgba(255,255,255,0.72);
      --accent-blue: #8eb8ff;
      --shadow: 0 18px 40px rgba(0,0,0,0.18);
      --radius-xl: 1.6rem;
      --radius-lg: 1.15rem;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      min-height: 100%;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--text-light);
      min-height: 100vh;
      background-color: #2a2f38;
      background-image:
        linear-gradient(rgba(18, 24, 36, 0.52), rgba(18, 24, 36, 0.60)),
        linear-gradient(rgba(125, 165, 235, 0.12), rgba(125, 165, 235, 0.10)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }

    .page {
      max-width: 1180px;
      margin: 0 auto;
      padding: 1.25rem 1.25rem 3rem;
    }

    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 0.25rem;
      margin-bottom: 2rem;
    }

    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(14, 18, 26, 0.68);
      padding: 0.78rem 1.5rem;
      border-radius: 999px;
      backdrop-filter: blur(10px);
      box-shadow: 0 10px 24px rgba(0,0,0,0.14);
      flex-wrap: wrap;
      border: 1px solid rgba(142, 184, 255, 0.08);
    }

    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.92;
      font-size: 1.02rem;
    }

    .nav-pill a:hover {
      opacity: 1;
      color: var(--accent-blue);
    }

    .main-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.72fr);
      gap: 1.4rem;
      align-items: start;
    }

    .left-column,
    .right-column {
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
    }

    .quote-card {
      background: rgba(255, 255, 255, 0.83);
      color: var(--text-dark);
      min-height: 315px;
      border-radius: var(--radius-xl);
      padding: 2.05rem 2.2rem;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      backdrop-filter: blur(3px);
    }

    .quote-card .eyebrow {
      font-size: 0.92rem;
      letter-spacing: 0.04em;
      opacity: 0.55;
      margin-bottom: 0.7rem;
      text-transform: uppercase;
    }

    .quote-card h1 {
      margin: 0 0 1rem 0;
      font-size: 1.95rem;
      line-height: 1.08;
      font-weight: 700;
    }

    .quote-text {
      font-size: 1.55rem;
      line-height: 1.62;
      margin: 0;
      font-weight: 450;
    }

    .small-card,
    .thoughts-card {
      background: var(--glass-mid);
      color: white;
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.15rem;
      backdrop-filter: blur(10px);
      box-shadow: 0 12px 28px rgba(0,0,0,0.14);
      border: 1px solid rgba(142, 184, 255, 0.08);
    }

    .small-card h3,
    .thoughts-card h3 {
      margin: 0 0 0.7rem 0;
      font-size: 1.2rem;
    }

    .small-card p {
      margin: 0;
      line-height: 1.55;
      color: rgba(255,255,255,0.94);
    }

    .calendar-link {
      display: inline-block;
      margin-top: 0.85rem;
      color: var(--accent-blue);
      text-decoration: underline;
      text-underline-offset: 2px;
      opacity: 0.98;
    }

    .calendar-link:hover {
      color: #bfd6ff;
    }

    .event-item {
      margin-bottom: 0.7rem;
      padding-bottom: 0.7rem;
      border-bottom: 1px solid rgba(255,255,255,0.10);
    }

    .event-item:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }

    .event-title {
      font-weight: 700;
      margin-bottom: 0.2rem;
    }

    .event-note {
      color: var(--muted-light);
      font-size: 0.95rem;
      line-height: 1.45;
    }

    #commentList {
      margin-bottom: 0.9rem;
    }

    #commentList div {
      font-size: 0.95rem;
      margin-bottom: 0.45rem;
      line-height: 1.45;
    }

    textarea {
      width: 100%;
      min-height: 82px;
      margin-top: 0.35rem;
      padding: 0.75rem 0.85rem;
      border-radius: 0.85rem;
      border: none;
      font-family: inherit;
      font-size: 0.96rem;
      resize: vertical;
    }

    button {
      margin-top: 0.7rem;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      border: none;
      background: rgba(255,255,255,0.96);
      color: #111;
      cursor: pointer;
      font-weight: 600;
    }

    button:hover {
      background: #dbe8ff;
    }

    .muted {
      opacity: 0.70;
    }

    @media (max-width: 900px) {
      .main-grid {
        grid-template-columns: 1fr;
      }

      .quote-card {
        min-height: 250px;
        padding: 1.7rem 1.4rem;
      }

      .quote-card h1 {
        font-size: 1.7rem;
      }

      .quote-text {
        font-size: 1.28rem;
      }
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="top-nav">
      <div class="nav-pill">
        <a href="/calendar">📅 Calendar</a>
        <a href="/home">🏠 Home</a>
        <a href="/bets">🎲 Bets</a>
        <a href="/notes">📝 Notes</a>
        <a href="/archive">🗂 Archive</a>
      </div>
    </div>

    <main class="main-grid">
      <section class="left-column">
        <section class="quote-card">
          <div class="eyebrow">Today</div>
          <h1>Daily reflection</h1>
          <p id="dailyReflection" class="quote-text">Loading...</p>
        </section>

        <section class="thoughts-card">
          <h3>💬 Thoughts</h3>
          <div id="commentList"><div class="muted">Loading thoughts...</div></div>
          <textarea id="commentInput" placeholder="Leave a thought..."></textarea>
          <button id="saveComment" type="button">Add</button>
        </section>
      </section>

      <aside class="right-column">
        <section class="small-card">
          <h3>Fun fact</h3>
          <p id="dailyFun">Loading...</p>
        </section>

        <section class="small-card">
          <h3>Today on the calendar</h3>
          <div id="todayCalendar">
            <div class="muted">Loading today's events...</div>
          </div>
          <a class="calendar-link" href="/calendar">Open calendar</a>
        </section>
      </aside>
    </main>
  </div>

  <script type="module" is:inline>
    async function loadDailyContent() {
      const reflectionEl = document.getElementById("dailyReflection");
      const funEl = document.getElementById("dailyFun");

      try {
        const res = await fetch("/.netlify/functions/generateDaily", {
          cache: "no-store",
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          throw new Error(data?.error || `generateDaily failed with ${res.status}`);
        }

        reflectionEl.textContent = data?.reflective?.text || "No reflection available.";
        funEl.textContent = data?.fun?.text || "No fun fact available.";
      } catch (err) {
        console.error("Failed to load daily content:", err);
        reflectionEl.textContent = "Could not load today's reflection.";
        funEl.textContent = "Could not load today's fun fact.";
      }
    }

    function escapeHtml(str) {
      return String(str)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function iconForType(type) {
      return {
        note: "📝",
        plan: "📍",
        memory: "🧠",
        occasion: "🌟"
      }[type] || "📝";
    }

    async function loadTodayCalendar() {
      const box = document.getElementById("todayCalendar");

      try {
        const res = await fetch("/.netlify/functions/calendar-load", {
          cache: "no-store",
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          throw new Error(data?.error || `calendar-load failed with ${res.status}`);
        }

        const now = new Date();
        const key =
          `${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;

        const events = Array.isArray(data?.[key]) ? data[key] : [];

        if (!events.length) {
          box.innerHTML = `<div class="muted">Nothing saved for today.</div>`;
          return;
        }

        box.innerHTML = events.map((e) => `
          <div class="event-item">
            <div class="event-title">${iconForType(e.type)} ${escapeHtml(e.title || "Untitled")}</div>
            ${e.note ? `<div class="event-note">${escapeHtml(e.note)}</div>` : ""}
          </div>
        `).join("");
      } catch (err) {
        console.error("Failed to load today's calendar:", err);
        box.innerHTML = `<div class="muted">Could not load today's events.</div>`;
      }
    }

    const list = document.getElementById("commentList");
    const input = document.getElementById("commentInput");
    const button = document.getElementById("saveComment");

    const today = new Date().toISOString().slice(0, 10);
    let dailyEntries = {};
    let todayEntry = { comments: [] };

    async function loadDailyComments() {
      try {
        const res = await fetch("/.netlify/functions/daily-load", {
          cache: "no-store",
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          throw new Error(data?.error || `daily-load failed with ${res.status}`);
        }

        dailyEntries = data || {};
        todayEntry = dailyEntries[today] || { comments: [] };

        if (!Array.isArray(todayEntry.comments)) {
          todayEntry.comments = [];
        }

        renderComments();
      } catch (err) {
        console.error("Failed to load comments:", err);
        list.innerHTML = `<div class="muted">Could not load thoughts.</div>`;
      }
    }

    async function saveDailyComments() {
      const res = await fetch("/.netlify/functions/daily-save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          date: today,
          update: { comments: todayEntry.comments },
        }),
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data?.error || `daily-save failed with ${res.status}`);
      }
    }

    function renderComments() {
      list.innerHTML = todayEntry.comments.length
        ? todayEntry.comments
            .map((c) => `<div>– ${escapeHtml(c.text)}</div>`)
            .join("")
        : `<div class="muted">No thoughts yet.</div>`;
    }

    button.addEventListener("click", async () => {
      const text = input.value.trim();
      if (!text) return;

      todayEntry.comments.push({
        text,
        createdAt: new Date().toISOString(),
      });

      input.value = "";
      renderComments();

      try {
        await saveDailyComments();
      } catch (err) {
        console.error("Failed to save comment:", err);
        alert("Could not save the thought.");
      }
    });

    loadDailyContent();
    loadTodayCalendar();
    loadDailyComments();
  </script>
</body>
</html>
