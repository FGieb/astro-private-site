---
const cookie = Astro.cookies.get("auth");
if (!cookie || cookie.value !== "1") {
  return Astro.redirect("/login");
}

import Nav from "../components/Nav.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Private Home</title>

    <style>
      :root {
        --card-bg: rgba(255, 255, 255, 0.88);
        --soft-dark: rgba(0, 0, 0, 0.45);
      }

      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        min-height: 100vh;
        color: white;
        background:
          linear-gradient(
            rgba(0,0,0,0.55),
            rgba(0,0,0,0.65)
          ),
          url("/images/homebackground.jpg");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
      }

      /* === TOP NAV === */
      .top-nav {
        display: flex;
        justify-content: center;
        margin-top: 1.25rem;
      }

      .nav-pill {
        display: flex;
        gap: 1.2rem;
        background: rgba(0, 0, 0, 0.55);
        padding: 0.6rem 1.4rem;
        border-radius: 999px;
        font-size: 1rem;
        backdrop-filter: blur(6px);
      }

      .nav-pill a {
        color: white;
        text-decoration: none;
        opacity: 0.85;
      }

      .nav-pill a:hover {
        opacity: 1;
      }

      /* === MAIN WRAPPER === */
      .wrapper {
        max-width: 720px;
        margin: 3rem auto 0;
        padding: 0 1.25rem 4rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      /* === WELCOME === */
      .welcome h1 {
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
      }

      .welcome p {
        font-size: 0.95rem;
        opacity: 0.7;
        margin-bottom: 2rem;
      }

      /* === DAILY REFLECTION (HERO) === */
      .reflection-card {
        background: var(--card-bg);
        color: #111;
        padding: 1.6rem 1.8rem;
        border-radius: 1.25rem;
        width: 100%;
        max-width: 560px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.25);
        margin-bottom: 1.8rem;
      }

      .reflection-card h2 {
        font-size: 0.9rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        opacity: 0.55;
        margin-bottom: 0.75rem;
      }

      .reflection-text {
        font-size: 1.1rem;
        line-height: 1.55;
      }

      /* === TODAY AGENDA === */
      .today-box {
        background: rgba(0,0,0,0.5);
        border-radius: 1rem;
        padding: 1rem 1.2rem;
        width: 100%;
        max-width: 420px;
        margin-bottom: 2rem;
        backdrop-filter: blur(6px);
      }

      .today-box h3 {
        font-size: 0.95rem;
        opacity: 0.8;
        margin-bottom: 0.75rem;
      }

      .event-item {
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }

      .event-note {
        font-size: 0.8rem;
        opacity: 0.7;
      }

      /* === IMAGE === */
      .media {
        width: 220px;
        border-radius: 0.9rem;
        box-shadow: 0 10px 24px rgba(0,0,0,0.45);
      }

      /* === MOBILE === */
      @media (max-width: 600px) {
        .welcome h1 {
          font-size: 1.7rem;
        }

        .reflection-text {
          font-size: 1.05rem;
        }

        .nav-pill {
          font-size: 0.95rem;
        }
      }
    </style>
  </head>

  <body>
    <!-- NAV -->
    <div class="top-nav">
      <div class="nav-pill">
        <a href="/calendar">📅 Calendar</a>
        <a href="/home">🏠 Home</a>
        <a href="/notes">📝 Notes</a>
      </div>
    </div>

    <!-- CONTENT -->
    <main class="wrapper">
      <section class="welcome">
        <h1>🐒 Goedemiddag, monkey</h1>
        <p>Still becoming.</p>
      </section>

      <section class="reflection-card">
        <h2>Today</h2>
        <p class="reflection-text">
          Today’s reflection will appear here.
        </p>
      </section>

      <section id="todayEvent" class="today-box" style="display:none;">
        <h3>📍 Today</h3>
        <div id="todayEventContent"></div>
      </section>

      <img
        id="dailyMedia"
        class="media"
        alt="Daily visual"
        style="display:none;"
      />
    </main>

    <!-- === CALENDAR → HOMEPAGE === -->
    <script type="module" is:inline>
      const container = document.getElementById("todayEvent");
      const content = document.getElementById("todayEventContent");

      const keyForToday = () => {
        const d = new Date();
        return `${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
      };

      const events = JSON.parse(localStorage.getItem("calendarEvents") || "{}");
      const todayEvents = events[keyForToday()];

      if (todayEvents?.length) {
        container.style.display = "block";
        content.innerHTML = todayEvents.map(evt => `
          <div class="event-item">
            <strong>${evt.title}</strong>
            ${evt.note ? `<div class="event-note">${evt.note}</div>` : ""}
          </div>
        `).join("");
      }
    </script>
  </body>
</html>
