---
const cookie = Astro.cookies.get("auth");
if (!cookie || cookie.value !== "1") {
  return Astro.redirect("/login");
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Notes</title>

  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      color: white;
      background:
        linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.75)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    /* NAV (same everywhere) */
    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 1.25rem;
    }

    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(0,0,0,0.55);
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      backdrop-filter: blur(6px);
    }

    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.85;
    }

    .nav-pill a:hover { opacity: 1; }

    /* PAGE */
    .wrapper {
      max-width: 640px;
      margin: 3rem auto;
      padding: 0 1.25rem 4rem;
    }

    h1 {
      text-align: center;
      margin-bottom: 2rem;
    }

    /* INPUT CARD */
    .note-input {
      background: rgba(255,255,255,0.9);
      color: #111;
      border-radius: 1.2rem;
      padding: 1.4rem 1.6rem;
      box-shadow: 0 12px 30px rgba(0,0,0,0.25);
      margin-bottom: 2rem;
    }

    textarea {
      width: 100%;
      min-height: 100px;
      border-radius: 0.6rem;
      border: none;
      padding: 0.6rem;
      font-family: inherit;
      resize: vertical;
    }

    button {
      margin-top: 0.6rem;
      padding: 0.4rem 1rem;
      border-radius: 999px;
      border: none;
      background: #1677ff; /* calendar blue */
      color: white;
      cursor: pointer;
    }

    /* NOTES LIST */
    .note {
      background: rgba(0,0,0,0.45);
      border-radius: 1rem;
      padding: 1rem 1.2rem;
      margin-bottom: 1rem;
      backdrop-filter: blur(6px);
    }

    .meta {
      font-size: 0.75rem;
      opacity: 0.6;
      margin-top: 0.4rem;
    }
  </style>
</head>

<body>

  <div class="top-nav">
    <div class="nav-pill">
      <a href="/calendar">📅 Calendar</a>
      <a href="/home">🏠 Home</a>
      <a href="/notes">📝 Notes</a>
      <a href="/archive">🗂 Archive</a>
    </div>
  </div>

  <main class="wrapper">
    <h1>📝 Shared Notes</h1>

    <div class="note-input">
      <textarea id="noteInput" placeholder="Write a note…"></textarea>
      <button id="addNote">Add note</button>
    </div>

    <div id="notesList"></div>
  </main>

  <!-- NOTES LOGIC (reuse what you already have) -->
  <script type="module" is:inline>
  const input = document.getElementById("noteInput");
  const list = document.getElementById("notesList");
  const button = document.getElementById("addNote");

  let notes = [];

  async function loadNotes() {
    const res = await fetch("/.netlify/functions/notes-load");
    notes = await res.json();
    render();
  }

  async function saveNotes() {
    await fetch("/.netlify/functions/notes-save", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(notes),
    });
  }

  function render() {
    list.innerHTML = notes.length
      ? notes.map(n => `
          <div class="note">
            <div>${n.text}</div>
            <div class="meta">
              ${new Date(n.createdAt).toLocaleString()}
            </div>
          </div>
        `).join("")
      : `<div class="note">No notes yet.</div>`;
  }

  button.addEventListener("click", async () => {
    if (!input.value.trim()) return;

    notes.unshift({
      text: input.value.trim(),
      createdAt: new Date().toISOString()
    });

    await saveNotes();
    input.value = "";
    render();
  });

  loadNotes();
</script>


</body>
</html>
