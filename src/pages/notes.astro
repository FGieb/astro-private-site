---
import { isValidSession } from "../lib/auth";

const cookie = Astro.cookies.get("auth");

if (!(await isValidSession(cookie?.value))) {
  return Astro.redirect("/login");
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Notes</title>

  <style is:global>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      color: white;
      background:
        linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.75)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 1.25rem;
    }

    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(0,0,0,0.55);
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      backdrop-filter: blur(6px);
    }

    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.85;
    }

    .nav-pill a:hover { opacity: 1; }
    .nav-group { position: relative; display: flex; align-items: center; }
    .nav-group-label { cursor: pointer; opacity: 0.85; user-select: none; }
    .nav-group-label:hover { opacity: 1; }
    .nav-group-menu { display: none; position: absolute; top: calc(100% + 0.6rem); left: 50%%; transform: translateX(-50%); background: rgba(14,18,26,0.97); border: 1px solid rgba(255,255,255,0.1); border-radius: 0.75rem; padding: 0.35rem; min-width: 130px; flex-direction: column; gap: 0.1rem; z-index: 100; backdrop-filter: blur(10px); }
    .nav-group:hover .nav-group-menu { display: flex; }
    .nav-group-menu a { display: block; padding: 0.4rem 0.75rem; border-radius: 0.5rem; white-space: nowrap; opacity: 0.85; }
    .nav-group-menu a:hover { background: rgba(255,255,255,0.08); opacity: 1; }

    .wrapper {
      max-width: 640px;
      margin: 3rem auto;
      padding: 0 1.25rem 4rem;
    }

    h1 {
      text-align: center;
      margin-bottom: 2rem;
    }

    .note-input {
      background: rgba(255,255,255,0.9);
      color: #111;
      border-radius: 1.2rem;
      padding: 1.4rem 1.6rem;
      box-shadow: 0 12px 30px rgba(0,0,0,0.25);
      margin-bottom: 2rem;
    }

    textarea {
      width: 100%;
      min-height: 100px;
      border-radius: 0.6rem;
      border: none;
      padding: 0.6rem;
      font-family: inherit;
      resize: vertical;
      box-sizing: border-box;
    }

    button {
      margin-top: 0.6rem;
      padding: 0.4rem 1rem;
      border-radius: 999px;
      border: none;
      background: #1677ff;
      color: white;
      cursor: pointer;
    }

    .note {
      background: rgba(0,0,0,0.45);
      border-radius: 1rem;
      padding: 1rem 1.2rem;
      margin-bottom: 1rem;
      backdrop-filter: blur(6px);
    }

    .note-text {
      cursor: pointer;
      transition: color 0.15s;
    }

    .note-text:hover {
      color: rgba(100, 180, 255, 0.90);
    }

    .meta {
      font-size: 0.75rem;
      opacity: 0.6;
      margin-top: 0.4rem;
    }
  </style>
</head>

<body>

  <div class="top-nav">
    <div class="nav-pill">
      <a href="/calendar">📅 Calendar</a>
      <a href="/home">🏠 Home</a>
      <div class="nav-group">
        <span class="nav-group-label">🎮 Games ▾</span>
        <div class="nav-group-menu">
          <a href="/bets">🎲 Bets</a>
          <a href="/scores">🏆 Scores</a>
          <a href="/poker">🃏 Poker</a>
        </div>
      </div>
      <a href="/overview">📋 Overview</a>
      <a href="/notes">📝 Notes</a>
      <a href="/archive">🗂 Archive</a>
    </div>
  </div>

  <main class="wrapper">
    <h1>📝 Shared Notes</h1>

    <div class="note-input">
      <textarea id="noteInput" placeholder="Write a note…"></textarea>
      <button id="addNote">Add note</button>
    </div>

    <div id="notesList"></div>
  </main>

  <script type="module" is:inline>
    const input = document.getElementById("noteInput");
    const list = document.getElementById("notesList");
    const button = document.getElementById("addNote");

    function escapeHtml(str) {
      return String(str)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    async function callContent(body) {
      const res = await fetch("/.netlify/functions/content", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.error || `content failed with ${res.status}`);
      return data;
    }

    async function loadNotes() {
      const data = await callContent({ type: "notes", action: "list" });
      render(data.entries || []);
    }

    function render(notes) {
      if (!notes.length) {
        list.innerHTML = '<div class="note">No notes yet.</div>';
        return;
      }

      list.innerHTML = notes.map((n) => `
        <div class="note" data-id="${n.id}">
          <div class="note-text" data-id="${n.id}" role="button" tabindex="0"
            aria-label="Click to edit note"
          >${escapeHtml(n.text || "")}</div>
          <div class="meta">${new Date(n.createdAt).toLocaleString()}</div>
        </div>
      `).join("");

      document.querySelectorAll(".note-text").forEach((el) => {
        const handle = async (event) => {
          event.stopPropagation();
          const id = el.getAttribute("data-id");
          if (!id) return;
          const current = el.textContent;
          const edited = window.prompt("Edit note\n(clear + OK to delete):", current);
          if (edited === null) return;
          try {
            if (edited.trim() === "") {
              await callContent({ type: "notes", action: "delete", id });
            } else if (edited.trim() !== current) {
              await callContent({ type: "notes", action: "update", id, data: { text: edited.trim() } });
            }
            await loadNotes();
          } catch (err) {
            console.error("Failed to update note:", err);
            alert("Could not update the note.");
          }
        };
        el.addEventListener("click", handle);
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); handle(e); }
        });
      });
    }

    button.addEventListener("click", async () => {
      const text = input.value.trim();
      if (!text) return;
      try {
        await callContent({ type: "notes", action: "add", data: { text } });
        input.value = "";
        await loadNotes();
      } catch (err) {
        console.error("Failed to add note:", err);
        alert("Could not save the note.");
      }
    });

    loadNotes();
  </script>

</body>
</html>
