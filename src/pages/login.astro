---
export const prerender = false;

import { createSession } from "../lib/auth";

const correctPassphrase = import.meta.env.LOGIN_PASSPHRASE;
const isPost = Astro.request.method === "POST";

let error = "";

if (isPost) {
  const formData = await Astro.request.formData();
  const pass = formData.get("passphrase");

  if (pass === correctPassphrase) {
    const token = await createSession();

    Astro.cookies.set("auth", token, {
      path: "/",
      httpOnly: true,
      secure: true,
      sameSite: "Strict",
      maxAge: 60 * 60 * 24 * 7, // 7 days
    });

    return Astro.redirect("/home");
  } else {
    error = "Incorrect passphrase.";
  }
}
---


<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url('/images/background1.jpg');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .login-box {
        background: rgba(255,255,255,0.85);
        padding: 2rem 3rem;
        border-radius: 1rem;
        max-width: 420px;
        width: 92%;
        text-align: center;
      }
      input {
        width: 100%;
        padding: 0.6rem;
        margin-bottom: 1rem;
      }
      button {
        padding: 0.6rem 1.2rem;
        background: #222;
        color: white;
        border: none;
        cursor: pointer;
      }
      .error {
        color: #c00;
        margin-top: 0.75rem;
      }
    </style>
  </head>
  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>

      <form method="POST">
        <input
          type="password"
          name="passphrase"
          placeholder="Passphrase"
          required
        />
        <button>Enter</button>
      </form>

      {error && <p class="error">❌ {error}</p>}
    </div>
  </body>
</html>
