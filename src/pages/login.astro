---
import { createSession } from "../lib/auth";

const correctPassphrase = import.meta.env.LOGIN_PASSPHRASE;
const baseUrl = import.meta.env.PUBLIC_SITE_URL;

const isPost = Astro.request.method === "POST";
const trustedDevice = Astro.cookies.get("trusted_device");
const hasTrustedDevice = !!trustedDevice;

let step = "password"; // "password" | "email" | "code"
let error = "";
let email = "";

if (isPost) {
  const formData = await Astro.request.formData();

  const pass = formData.get("passphrase");
  const submittedEmail = formData.get("email");
  const submittedCode = formData.get("code");

  // Step 1 — passphrase check
  if (pass !== correctPassphrase) {
    error = "Incorrect passphrase.";
    step = "password";
  } else {
    // Trusted device → skip email & code
    if (hasTrustedDevice) {
      const token = await createSession();
      Astro.cookies.set("auth", token, {
        path: "/",
        httpOnly: true,
        secure: true,
        sameSite: "Strict",
        maxAge: 60 * 60 * 24 * 7, // 7 days
      });

      return Astro.redirect("/home");
    }

    // Step 2 — email submitted → send code
    if (submittedEmail && !submittedCode) {
      email = String(submittedEmail);
      step = "code";

      await fetch(`${baseUrl}/api/send-login-code`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
    }

    // Step 3 — code submitted → verify
    if (submittedEmail && submittedCode) {
      const res = await fetch(`${baseUrl}/api/verify-login-code`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: submittedEmail,
          code: submittedCode,
        }),
      });

      const result = await res.json();

      if (result.ok) {
        const token = await createSession();

        Astro.cookies.set("auth", token, {
          path: "/",
          httpOnly: true,
          secure: true,
          sameSite: "Strict",
          maxAge: 60 * 60 * 24 * 7, // 7 days
        });

        Astro.cookies.set("trusted_device", "1", {
          path: "/",
          httpOnly: true,
          secure: true,
          sameSite: "Strict",
          maxAge: 60 * 60 * 24 * 90, // 90 days
        });

        return Astro.redirect("/home");
      } else {
        error = "Invalid or expired code.";
        step = "code";
        email = String(submittedEmail);
      }
    }

    // Default after passphrase → ask for email
    if (!submittedEmail) {
      step = "email";
    }
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url('/images/background1.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .login-box {
        background-color: rgba(255, 255, 255, 0.85);
        padding: 2rem 3rem;
        border-radius: 1rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        text-align: center;
        max-width: 400px;
        width: 90%;
      }

      h1 {
        margin-bottom: 1rem;
      }

      input {
        padding: 0.5rem;
        width: 100%;
        margin-bottom: 1rem;
        font-size: 1rem;
      }

      button {
        padding: 0.5rem 1.2rem;
        font-size: 1rem;
        border: none;
        background-color: #222;
        color: #fff;
        cursor: pointer;
        border-radius: 4px;
      }

      .error {
        color: red;
        margin-top: 0.5rem;
      }

      .info {
        font-size: 0.9rem;
        opacity: 0.8;
        margin-top: 1rem;
      }
    </style>
  </head>

  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>

      {step === "password" && (
        <form method="POST">
          <input
            type="password"
            name="passphrase"
            placeholder="Enter passphrase"
            required
          />
          <button type="submit">Continue</button>
        </form>
      )}

      {step === "email" && (
        <form method="POST">
          <input type="hidden" name="passphrase" value={correctPassphrase} />
          <p><strong>New device detected.</strong></p>
          <p class="info">
            Enter your email to receive a one-time login code.
          </p>
          <input
            type="email"
            name="email"
            placeholder="Your email"
            required
          />
          <button type="submit">Send code</button>
        </form>
      )}

      {step === "code" && (
        <form method="POST">
          <input type="hidden" name="passphrase" value={correctPassphrase} />
          <input type="hidden" name="email" value={email} />
          <p class="info">
            Enter the 6-digit code sent to your email.
          </p>
          <input
            type="text"
            name="code"
            placeholder="6-digit code"
            required
          />
          <button type="submit">Verify</button>
        </form>
      )}

      {error && <p class="error">❌ {error}</p>}
    </div>
  </body>
</html>
