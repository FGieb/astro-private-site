---
export const prerender = false;

import { createSession } from "../lib/auth";
import crypto from "node:crypto";

const correctPassphrase = import.meta.env.LOGIN_PASSPHRASE;
const SITE_URL = import.meta.env.PUBLIC_SITE_URL;

const isPost = Astro.request.method === "POST";
const hasTrustedDevice = !!Astro.cookies.get("trusted_device");

let step = "password"; // "password" | "email" | "code"
let error = "";
let info = "";

function ensureLoginId(email) {
  let id = Astro.cookies.get("login_id")?.value;
  if (!id) {
    id = crypto.randomUUID();
  }

  Astro.cookies.set("login_id", id, {
    path: "/login",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 10,
  });

  Astro.cookies.set("login_email", email, {
    path: "/login",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 10,
  });

  return id;
}

function clearLoginId() {
  Astro.cookies.delete("login_id", { path: "/login" });
  Astro.cookies.delete("login_email", { path: "/login" });
}

async function doLogin() {
  const token = await createSession();

  Astro.cookies.set("auth", token, {
    path: "/",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 60 * 24 * 7,
  });

  Astro.cookies.set("trusted_device", "1", {
    path: "/",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 60 * 24 * 90,
  });

  clearLoginId();
  return Astro.redirect("/home");
}

if (!isPost) step = "password";

if (isPost) {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") || "");
  const pass = formData.get("passphrase");
  const submittedEmail = formData.get("email");
  const submittedCode = formData.get("code");

  if (action === "restart") {
    clearLoginId();
    step = "password";
  } else if (pass !== correctPassphrase) {
    error = "Incorrect passphrase.";
    step = "password";
  } else {
    if (hasTrustedDevice) return await doLogin();

    // Send code
    if (submittedEmail && !submittedCode && action !== "resend") {
      const email = String(submittedEmail).toLowerCase().trim();
      const loginId = ensureLoginId(email);

      step = "code";
      info = "Code sent. Check your inbox.";

      await fetch(`${SITE_URL}/api/send-login-code`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, loginId }),
      });
    }

    // Resend
    else if (action === "resend") {
      const email = String(submittedEmail || "").toLowerCase().trim();
      if (!email) {
        step = "email";
        error = "Please enter your email to resend the code.";
      } else {
        const loginId = ensureLoginId(email);
        step = "code";
        info = "Code re-sent. Check your inbox.";

        await fetch(`${SITE_URL}/api/send-login-code`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, loginId }),
        });
      }
    }

    // Verify
    else if (submittedCode) {
      const email = Astro.cookies.get("login_email")?.value;
      const loginId = Astro.cookies.get("login_id")?.value;

      if (!email || !loginId) {
        step = "email";
        error = "Login session expired. Please restart.";
      } else {
        const res = await fetch(`${SITE_URL}/api/verify-login-code`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            loginId,
            email,
            code: String(submittedCode).trim(),
          }),
        });

        const result = await res.json();

        if (result.ok) {
          return await doLogin();
        } else {
          step = "code";
          error = "Invalid or expired code.";
        }
      }
    }

    // After passphrase
    else {
      step = "email";
    }
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url('/images/background1.jpg');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .login-box {
        background: rgba(255,255,255,0.85);
        padding: 2rem 3rem;
        border-radius: 1rem;
        max-width: 440px;
        width: 92%;
        text-align: center;
      }
      input {
        width: 100%;
        padding: 0.6rem;
        margin-bottom: 1rem;
      }
      button {
        padding: 0.6rem 1.2rem;
        background: #222;
        color: white;
        border: none;
        cursor: pointer;
      }
      .row {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 0.5rem;
      }
      .error { color: #c00; margin-top: 0.75rem; }
      .info  { color: #222; opacity: 0.85; margin: 0.5rem 0 1rem; font-size: 0.95rem; }
      .muted { font-size: 0.9rem; opacity: 0.75; margin-top: 0.5rem; }
    </style>
  </head>
  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>

      {step === "password" && (
        <form method="POST">
          <input type="password" name="passphrase" placeholder="Passphrase" required />
          <button>Continue</button>
        </form>
      )}

      {step === "email" && (
        <form method="POST">
          <input type="hidden" name="passphrase" value={correctPassphrase} />
          <p class="muted">New device — verify via email</p>
          <input type="email" name="email" placeholder="Your email" required />
          <button>Send code</button>
          <div class="row">
            <button type="submit" name="action" value="restart" formnovalidate>Restart</button>
          </div>
        </form>
      )}

      {step === "code" && (
        <form method="POST">
          <input type="hidden" name="passphrase" value={correctPassphrase} />

          {info && <p class="info">{info}</p>}

          <input type="email" name="email" placeholder="Your email" required />
          <input type="text" name="code" placeholder="6-digit code"
                 inputmode="numeric" autocomplete="one-time-code" required />

          <button>Verify</button>

          <div class="row">
            <button type="submit" name="action" value="resend" formnovalidate>Resend code</button>
            <button type="submit" name="action" value="restart" formnovalidate>Restart</button>
          </div>

          <p class="muted">Resend requires your email again (prevents stale-state bugs).</p>
        </form>
      )}

      {error && <p class="error">❌ {error}</p>}
    </div>
  </body>
</html>
