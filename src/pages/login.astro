---
import { createSession } from "../lib/auth";

const correctPassphrase = import.meta.env.LOGIN_PASSPHRASE;

const isPost = Astro.request.method === "POST";
const trustedDevice = Astro.cookies.get("trusted_device");
const hasTrustedDevice = !!trustedDevice;

let step = "password"; // "password" | "email"
let error = "";

if (isPost) {
  const formData = await Astro.request.formData();
  const pass = formData.get("passphrase");

  if (pass !== correctPassphrase) {
    error = "Incorrect passphrase.";
  } else {
    // Password correct
    if (hasTrustedDevice) {
      // Trusted device → login directly
      const token = await createSession();
      Astro.cookies.set("auth", token, {
        path: "/",
        httpOnly: true,
        secure: true,
        sameSite: "Strict",
        maxAge: 60 * 60 * 24 * 7, // 7 days
      });

      return Astro.redirect("/home");
    } else {
      // New device → email step required
      step = "email";
    }
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url('/images/background1.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .login-box {
        background-color: rgba(255, 255, 255, 0.85);
        padding: 2rem 3rem;
        border-radius: 1rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        text-align: center;
        max-width: 400px;
        width: 90%;
      }

      h1 {
        margin-bottom: 1rem;
      }

      input {
        padding: 0.5rem;
        width: 100%;
        margin-bottom: 1rem;
        font-size: 1rem;
      }

      button {
        padding: 0.5rem 1.2rem;
        font-size: 1rem;
        border: none;
        background-color: #222;
        color: #fff;
        cursor: pointer;
        border-radius: 4px;
      }

      .error {
        color: red;
        margin-top: 0.5rem;
      }

      .info {
        font-size: 0.9rem;
        opacity: 0.8;
        margin-top: 1rem;
      }
    </style>
  </head>

  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>

      {step === "password" && (
        <form method="POST">
          <input
            type="password"
            name="passphrase"
            placeholder="Enter passphrase"
            required
          />
          <button type="submit">Continue</button>
        </form>
      )}

      {step === "email" && (
        <div>
          <p><strong>New device detected.</strong></p>
          <p class="info">
            Email verification is required before access is granted.
          </p>
          <p class="info">
            (Email step will be implemented next.)
          </p>
        </div>
      )}

      {error && <p class="error">❌ {error}</p>}
    </div>
  </body>
</html>
