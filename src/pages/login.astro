---
export const prerender = false;

import { createSession } from "../lib/auth";

const correctPassphrase = import.meta.env.LOGIN_PASSPHRASE;
const isPost = Astro.request.method === "POST";

function isAllowedEmail(email: string) {
  const raw = import.meta.env.ALLOWED_EMAILS || "";
  const allowed = raw
    .split(",")
    .map((e) => e.trim().toLowerCase())
    .filter(Boolean);
  return allowed.includes(email.trim().toLowerCase());
}

let error = "";
let step: "passphrase" | "code" = "passphrase";

// Read cookies (may exist from earlier attempts)
const trustedDevice = Astro.cookies.get("trusted_device")?.value === "1";
const pendingEmailCookie = (Astro.cookies.get("login_email")?.value || "").trim().toLowerCase();

// Allow a safe reset from URL: /login?reset=1
const reset = Astro.url.searchParams.get("reset") === "1";
if (reset) {
  Astro.cookies.delete("login_email", { path: "/" });
  // We intentionally do NOT delete trusted_device here.
  // If you want reset to also untrust device, uncomment next line:
  // Astro.cookies.delete("trusted_device", { path: "/" });
}

// IMPORTANT: On GET we ALWAYS start at passphrase.
// We do NOT auto-jump to code based on cookies (prevents "stuck on code screen").
// Only a successful POST will set step="code".
if (isPost) {
  const formData = await Astro.request.formData();

  const isPassphrasePost = formData.has("passphrase");
  const isCodePost = formData.has("code");

  // ---------------------------
  // PASS + EMAIL SUBMISSION
  // ---------------------------
  if (isPassphrasePost) {
    const pass = (formData.get("passphrase") || "").toString();
    const email = (formData.get("email") || "").toString().trim().toLowerCase();

    if (pass !== correctPassphrase) {
      error = "Incorrect passphrase.";
      step = "passphrase";
    } else if (!email) {
      error = "Please enter your email.";
      step = "passphrase";
    } else if (!isAllowedEmail(email)) {
      error = "This email is not authorised.";
      step = "passphrase";
    } else {
      // If device is already trusted, skip email code and log in directly
      if (trustedDevice) {
        const token = await createSession();
        Astro.cookies.set("auth", token, {
          path: "/",
          httpOnly: true,
          secure: true,
          sameSite: "Strict",
          maxAge: 60 * 60 * 24 * 7, // 7 days
        });

        return Astro.redirect("/home");
      }

      // Ask server to generate/store/email the code (single source of truth)
      try {
        const res = await fetch(new URL("/api/send-login-code", Astro.url), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, loginId: email }),
        });

        if (!res.ok) {
          const text = await res.text().catch(() => "");
          error = `Failed to send code. (${res.status}) ${text}`.trim();
          step = "passphrase";
        } else {
          // Only NOW, after successful send, set the pending email cookie
          Astro.cookies.set("login_email", email, {
            path: "/",
            httpOnly: true,
            secure: true,
            sameSite: "Strict",
            maxAge: 60 * 10, // 10 minutes
          });

          step = "code";
        }
      } catch (e) {
        error = `Failed to send code. ${String(e)}`;
        step = "passphrase";
      }
    }
  }

  // ---------------------------
  // CODE VERIFICATION
  // ---------------------------
  else if (isCodePost) {
    const input = (formData.get("code") || "").toString().trim();

    // Use cookie set after successful send
    const email = (Astro.cookies.get("login_email")?.value || "").trim().toLowerCase();

    if (!email) {
      error = "No active login attempt. Please start again.";
      step = "passphrase";
    } else if (!/^\d{6}$/.test(input)) {
      error = "Incorrect verification code.";
      step = "code";
    } else {
      try {
        const res = await fetch(new URL("/api/verify-login-code", Astro.url), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ loginId: email, code: input }),
        });

        if (!res.ok) {
          error = "Incorrect verification code.";
          step = "code";
        } else {
          // Trust device for 60 days
          Astro.cookies.set("trusted_device", "1", {
            path: "/",
            httpOnly: true,
            secure: true,
            sameSite: "Strict",
            maxAge: 60 * 60 * 24 * 60,
          });

          // Clear pending email cookie
          Astro.cookies.delete("login_email", { path: "/" });

          // Create session
          const token = await createSession();
          Astro.cookies.set("auth", token, {
            path: "/",
            httpOnly: true,
            secure: true,
            sameSite: "Strict",
            maxAge: 60 * 60 * 24 * 7, // 7 days
          });

          return Astro.redirect("/home");
        }
      } catch (e) {
        error = `Verification failed. ${String(e)}`;
        step = "code";
      }
    }
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url("/images/background1.jpg");
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .login-box {
        background: rgba(255, 255, 255, 0.85);
        padding: 2rem 3rem;
        border-radius: 1rem;
        max-width: 420px;
        width: 92%;
        text-align: center;
      }
      input {
        width: 100%;
        padding: 0.6rem;
        margin-bottom: 1rem;
      }
      button {
        padding: 0.6rem 1.2rem;
        background: #222;
        color: white;
        border: none;
        cursor: pointer;
      }
      .error {
        color: #c00;
        margin-top: 0.75rem;
      }
      .hint {
        margin-top: 0.75rem;
        font-size: 0.95rem;
      }
      .link {
        display: inline-block;
        margin-top: 0.75rem;
        font-size: 0.95rem;
        color: #222;
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>

      {step === "passphrase" ? (
        <form method="POST">
          <input type="email" name="email" placeholder="Email" required />
          <input type="password" name="passphrase" placeholder="Passphrase" required />
          <button type="submit">Enter</button>
        </form>
      ) : null}

      {step === "code" ? (
        <div>
          <p>Passphrase accepted.</p>
          <p class="hint">Enter the 6-digit code we sent to your email.</p>

          <form method="POST">
            <input
              type="text"
              name="code"
              placeholder="Verification code"
              inputmode="numeric"
              pattern="[0-9]{6}"
              autocomplete="one-time-code"
              required
            />
            <button type="submit">Verify</button>
          </form>

          <a class="link" href="/login?reset=1">Start over</a>
        </div>
      ) : null}

      {error ? <p class="error">❌ {error}</p> : null}
    </div>
  </body>
</html>
