---
import { Astro } from 'astro';

let correctPassphrase = "alm.bumblebee"; // Your private key
let isValid = false;

// Check submitted passphrase
if (Astro.request.method === "POST") {
  const body = await Astro.request.formData();
  const pass = body.get("passphrase");
  if (pass === correctPassphrase) {
    isValid = true;
    // Set session cookie
    return new Response(null, {
      status: 302,
      headers: {
        Location: '/home',
        'Set-Cookie': `session=valid; Path=/; HttpOnly; SameSite=Strict`,
      }
    });
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url('/images/background1.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .login-box {
        background-color: rgba(255, 255, 255, 0.85);
        padding: 2rem 3rem;
        border-radius: 1rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        text-align: center;
        max-width: 400px;
        width: 90%;
      }

      .error {
        color: red;
        margin-top: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>
      <form method="POST">
        <input type="password" name="passphrase" placeholder="Enter passphrase" required />
        <br /><br />
        <button type="submit">Enter</button>
      </form>

      {Astro.request.method === "POST" && !isValid ? (
        <p class="error">❌ Incorrect passphrase</p>
      ) : null}
    </div>
  </body>
</html>
