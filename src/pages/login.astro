---
export const prerender = false;

import { createSession } from "../lib/auth";
import crypto from "node:crypto";

const correctPassphrase = import.meta.env.LOGIN_PASSPHRASE;
const SITE_URL = import.meta.env.PUBLIC_SITE_URL;

const isPost = Astro.request.method === "POST";
const hasTrustedDevice = !!Astro.cookies.get("trusted_device");

let step = "password"; // "password" | "email" | "code"
let error = "";
let info = "";

function ensureLoginId(email) {
  let id = Astro.cookies.get("login_id")?.value;
  if (!id) {
    id = crypto.randomUUID();
  }

  Astro.cookies.set("login_id", id, {
    path: "/login",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 10,
  });

  Astro.cookies.set("login_email", email, {
    path: "/login",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 10,
  });

  return id;
}

function clearLoginId() {
  Astro.cookies.delete("login_id", { path: "/login" });
  Astro.cookies.delete("login_email", { path: "/login" });
}

async function doLogin() {
  const token = await createSession();

  Astro.cookies.set("auth", token, {
    path: "/",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 60 * 24 * 7,
  });

  Astro.cookies.set("trusted_device", "1", {
    path: "/",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 60 * 24 * 90,
  });

  clearLoginId();
  return Astro.redirect("/home");
}

if (!isPost) step = "password";

if (isPost) {
  const formData = await Astro.request.formData();
  const action = String(formData.get("action") || "");
  const pass = formData.get("passphrase");
  const submittedEmail = formData.get("email");
  const submittedCode = formData.get("code");

  if (action === "restart") {
    clearLoginId();
    step = "password";
  } else if (pass !== correctPassphrase) {
    error = "Incorrect passphrase.";
    step = "password";
  } else {
    if (hasTrustedDevice) return await doLogin();

    // Send code
    if (submittedEmail && !submittedCode && action !== "resend") {
      const email = String(submittedEmail).toLowerCase().trim();
      const loginId = ensureLoginId(email);

      step = "code";
      info = "Code sent. Check your inbox.";

      await fetch(`${SITE_URL}/api/send-login-code`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, loginId }),
      });
    }

    // Resend
    else if (action === "resend") {
      const email = String(submittedEmail || "").toLowerCase().trim();
      if (!email) {
        step = "email";
        error = "Please enter your email to resend the code.";
      } else {
        const loginId = ensureLoginId(email);
        step = "code";
        info = "Code re-sent. Check your inbox.";

        await fetch(`${SITE_URL}/api/send-login-code`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, loginId }),
        });
      }
    }

    // Verify (FIXED)
    else if (submittedCode) {
      const email = Astro.cookies.get("login_email")?.value;
      const loginId = Astro.cookies.get("login_id")?.value;

      if (!email || !loginId) {
        step = "email";
        error = "Login session expired. Please restart.";
      } else {
        const res = await fetch(`${SITE_URL}/api/verify-login-code`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            loginId,
            email,
            code: String(submittedCode).trim(),
          }),
        });

        const result = await res.json();

        if (result.ok) {
          return await doLogin();
        } else {
          step = "code";
          error = "Invalid or expired code.";
        }
      }
    }

    // After passphrase
    else {
      step = "email";
    }
  }
}
---
