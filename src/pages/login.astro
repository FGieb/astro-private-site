---
let correctPassphrase = "your-passphrase-here"; // Change this to your own
let isValid = false;

if (Astro.request.method === "POST") {
  const body = await Astro.request.formData();
  const pass = body.get("passphrase");
  isValid = pass === correctPassphrase;
}
---

<body>
  {isValid ? (
    <script>
      window.location.href = '/home';
    </script>
  ) : (
    <div class="login-box">
      <h1>🔐 Private Access</h1>
      <form method="POST">
        <input type="password" name="passphrase" placeholder="Enter passphrase" required />
        <br />
        <button type="submit">Enter</button>
      </form>
      {Astro.request.method === 'POST' && <p class="error">❌ Incorrect passphrase.</p>}
    </div>
  )}
</body>
