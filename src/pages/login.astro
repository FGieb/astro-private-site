---
export const prerender = true; // static page that always renders
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url('/images/background1.jpg');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .login-box {
        background: rgba(255,255,255,0.88);
        padding: 2rem 3rem;
        border-radius: 1rem;
        max-width: 460px;
        width: 92%;
        text-align: center;
      }
      input {
        width: 100%;
        padding: 0.65rem;
        margin-bottom: 0.9rem;
        box-sizing: border-box;
      }
      button {
        padding: 0.65rem 1.2rem;
        background: #222;
        color: white;
        border: none;
        cursor: pointer;
        width: 100%;
      }
      .row {
        display: flex;
        gap: 0.75rem;
        margin-top: 0.75rem;
      }
      .row button { width: 50%; }
      .error { color: #c00; margin-top: 0.75rem; }
      .info  { color: #222; opacity: 0.85; margin: 0.5rem 0 1rem; font-size: 0.95rem; }
      .muted { font-size: 0.9rem; opacity: 0.75; margin-top: 0.5rem; }
    </style>
  </head>
  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>

      <p class="muted">Enter passphrase. If this is a new device, you’ll verify via email.</p>

      <!-- Single form that can either send or verify -->
      <form method="POST" action="/api/login">
        <input type="password" name="passphrase" placeholder="Passphrase" required />
        <input type="email" name="email" placeholder="Your email (only needed for verification)" />
        <input type="text" name="code" placeholder="6-digit code (only when verifying)"
               inputmode="numeric" autocomplete="one-time-code" />

        <button type="submit" name="action" value="send">Send code / Login</button>

        <div class="row">
          <button type="submit" name="action" value="verify" formnovalidate>Verify code</button>
          <button type="submit" name="action" value="restart" formnovalidate>Restart</button>
        </div>
      </form>

      <p class="muted">Tip: “Send code / Login” logs in immediately on trusted devices.</p>
    </div>
  </body>
</html>
