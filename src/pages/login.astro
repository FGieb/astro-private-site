---
import { createSession } from "../lib/auth";

const correctPassphrase = import.meta.env.LOGIN_PASSPHRASE;
const SITE_URL = import.meta.env.PUBLIC_SITE_URL;

const isPost = Astro.request.method === "POST";
const trustedDevice = Astro.cookies.get("trusted_device");
const hasTrustedDevice = !!trustedDevice;

let step: "password" | "email" | "code" = "password";
let error = "";

if (isPost) {
  const formData = await Astro.request.formData();

  const pass = formData.get("passphrase");
  const submittedEmail = formData.get("email");
  const submittedCode = formData.get("code");

  // STEP 1 — Passphrase
  if (pass !== correctPassphrase) {
    error = "Incorrect passphrase.";
    step = "password";
  } else {
    // Trusted device → direct login
    if (hasTrustedDevice) {
      const token = await createSession();

      Astro.cookies.set("auth", token, {
        path: "/",
        httpOnly: true,
        secure: true,
        sameSite: "Strict",
        maxAge: 60 * 60 * 24 * 7,
      });

      return Astro.redirect("/home");
    }

    // STEP 2 — Email submitted → send code
    if (
      submittedEmail &&
      !submittedCode &&
      !Astro.cookies.get("pending_email")
    ) {

      const email = String(submittedEmail).toLowerCase().trim();
      step = "code";

      // 🔐 Persist email securely for verification step
      Astro.cookies.set("pending_email", email, {
        path: "/login",
        httpOnly: true,
        secure: true,
        sameSite: "Strict",
        maxAge: 60 * 10, // 10 minutes
      });

      await fetch(`${SITE_URL}/api/send-login-code`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
    }

    // STEP 3 — Code submitted → verify
    if (submittedCode) {
      const emailFromCookie = Astro.cookies.get("pending_email")?.value;

      if (!emailFromCookie) {
        error = "Session expired. Please restart login.";
        step = "email";
      } else {
        const res = await fetch(`${SITE_URL}/api/verify-login-code`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: emailFromCookie,
            code: String(submittedCode).trim(),
          }),
        });

        const result = await res.json();

        if (result.ok) {
          const token = await createSession();

          Astro.cookies.delete("pending_email", { path: "/login" });

          Astro.cookies.set("auth", token, {
            path: "/",
            httpOnly: true,
            secure: true,
            sameSite: "Strict",
            maxAge: 60 * 60 * 24 * 7,
          });

          Astro.cookies.set("trusted_device", "1", {
            path: "/",
            httpOnly: true,
            secure: true,
            sameSite: "Strict",
            maxAge: 60 * 60 * 24 * 90,
          });

          return Astro.redirect("/home");
        } else {
          error = "Invalid or expired code.";
          step = "code";
        }
      }
    }

    // Default after passphrase
    if (!submittedEmail && !submittedCode) {
      step = "email";
    }
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url('/images/background1.jpg');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .login-box {
        background: rgba(255,255,255,0.85);
        padding: 2rem 3rem;
        border-radius: 1rem;
        max-width: 400px;
        width: 90%;
        text-align: center;
      }

      input {
        width: 100%;
        padding: 0.5rem;
        margin-bottom: 1rem;
      }

      button {
        padding: 0.6rem 1.2rem;
        background: #222;
        color: white;
        border: none;
        cursor: pointer;
      }

      .error {
        color: red;
        margin-top: 0.5rem;
      }

      .info {
        font-size: 0.9rem;
        opacity: 0.8;
      }
    </style>
  </head>

  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>

      {step === "password" && (
        <form method="POST">
          <input
            type="password"
            name="passphrase"
            placeholder="Passphrase"
            required
          />
          <button>Continue</button>
        </form>
      )}

      {step === "email" && (
        <form method="POST">
          <input type="hidden" name="passphrase" value={correctPassphrase} />
          <p class="info">New device — verify via email</p>
          <input type="email" name="email" placeholder="Your email" required />
          <button>Send code</button>
        </form>
      )}

      {step === "code" && (
        <form method="POST">
          <input type="hidden" name="passphrase" value={correctPassphrase} />
          <input type="text" name="code" placeholder="6-digit code" required />
          <button>Verify</button>
        </form>
      )}

      {error && <p class="error">❌ {error}</p>}
    </div>
  </body>
</html>
