---
import { createSession } from "../lib/auth";

const correctPassphrase = import.meta.env.LOGIN_PASSPHRASE;
const SITE_URL = import.meta.env.PUBLIC_SITE_URL;

const isPost = Astro.request.method === "POST";
const hasTrustedDevice = !!Astro.cookies.get("trusted_device");

let step: "password" | "email" | "code" = "password";
let error = "";
let info = "";

function setPendingEmail(email: string) {
  Astro.cookies.set("pending_email", email, {
    path: "/login",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 10, // 10 minutes
  });
}

function clearPendingEmail() {
  Astro.cookies.delete("pending_email", { path: "/login" });
}

async function doLogin() {
  const token = await createSession();

  Astro.cookies.set("auth", token, {
    path: "/",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 60 * 24 * 7, // 7 days
  });

  Astro.cookies.set("trusted_device", "1", {
    path: "/",
    httpOnly: true,
    secure: true,
    sameSite: "Strict",
    maxAge: 60 * 60 * 24 * 90, // 90 days
  });

  return Astro.redirect("/home");
}

// On GET: always start at password (stable baseline)
if (!isPost) {
  step = "password";
}

if (isPost) {
  const formData = await Astro.request.formData();

  const action = String(formData.get("action") || "");
  const pass = formData.get("passphrase");
  const submittedEmail = formData.get("email");
  const submittedCode = formData.get("code");

  // Restart button: clears pending state and returns to email step (after passphrase)
  if (action === "restart") {
    clearPendingEmail();
    step = "password";
  } else {
    // STEP 1 — Passphrase
    if (pass !== correctPassphrase) {
      error = "Incorrect passphrase.";
      step = "password";
    } else {
      // Trusted device → direct login
      if (hasTrustedDevice) {
        return await doLogin();
      }

      const pendingEmail = Astro.cookies.get("pending_email")?.value;

      // STEP 2 — Email submitted → send code
      if (submittedEmail && !submittedCode) {
        const email = String(submittedEmail).toLowerCase().trim();
        setPendingEmail(email);
        step = "code";
        info = "Code sent. Check your inbox.";

        await fetch(`${SITE_URL}/api/send-login-code`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
      }
      // STEP 2b — Resend code (from code screen)
      else if (action === "resend") {
        if (!pendingEmail) {
          error = "Session expired. Please restart.";
          step = "email";
        } else {
          step = "code";
          info = "Code re-sent. Check your inbox.";

          await fetch(`${SITE_URL}/api/send-login-code`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: pendingEmail }),
          });
        }
      }
      // STEP 3 — Code submitted → verify
      else if (submittedCode) {
        if (!pendingEmail) {
          error = "Session expired. Please restart login.";
          step = "email";
        } else {
          const res = await fetch(`${SITE_URL}/api/verify-login-code`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email: pendingEmail,
              code: String(submittedCode).trim(),
            }),
          });

          const result = await res.json();
          
          if (result.ok) {
            clearPendingEmail();
            return await doLogin();
          } else {
            error = result.reason
              ? `Verification failed: ${result.reason}`
              : "Invalid or expired code.";
            step = "code";
          }

        }
      }
      // Default after correct passphrase (no email, no code)
      else {
        step = pendingEmail ? "code" : "email";
      }
    }
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url('/images/background1.jpg');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .login-box {
        background: rgba(255,255,255,0.85);
        padding: 2rem 3rem;
        border-radius: 1rem;
        max-width: 440px;
        width: 92%;
        text-align: center;
      }

      input {
        width: 100%;
        padding: 0.6rem;
        margin-bottom: 1rem;
      }

      button {
        padding: 0.6rem 1.2rem;
        background: #222;
        color: white;
        border: none;
        cursor: pointer;
      }

      .row {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 0.5rem;
      }

      .error { color: #c00; margin-top: 0.75rem; }
      .info  { color: #222; opacity: 0.85; margin: 0.5rem 0 1rem; font-size: 0.95rem; }
      .muted { font-size: 0.9rem; opacity: 0.75; margin-top: 0.5rem; }
    </style>
  </head>

  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>

      {step === "password" && (
        <form method="POST">
          <input type="password" name="passphrase" placeholder="Passphrase" required />
          <button>Continue</button>
        </form>
      )}

      {step === "email" && (
        <form method="POST">
          <input type="hidden" name="passphrase" value={correctPassphrase} />
          <p class="muted">New device — verify via email</p>
          <input type="email" name="email" placeholder="Your email" required />
          <button>Send code</button>

          <div class="row">
            <button type="submit" name="action" value="restart">Restart</button>
          </div>
        </form>
      )}

      {step === "code" && (
        <form method="POST">
          <input type="hidden" name="passphrase" value={correctPassphrase} />

          {info && <p class="info">{info}</p>}

          <input type="text" name="code" placeholder="6-digit code" inputmode="numeric" autocomplete="one-time-code" required />
          <button>Verify</button>

          <div class="row">
            <button type="submit" name="action" value="resend">Resend code</button>
            <button type="submit" name="action" value="restart">Restart</button>
          </div>

          <p class="muted">If you didn’t receive an email, press “Resend code”.</p>
        </form>
      )}

      {error && <p class="error">❌ {error}</p>}
    </div>
  </body>
</html>
