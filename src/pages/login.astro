---
let correctPassphrase = "alwayslovingthemonkey.bumblebee"; // <-- change this to your own
let isValid = false;

---
let correctPassphrase = "mypassword"; // your passphrase
let isValid = false;

if (Astro.request.method === "POST") {
  const body = await Astro.request.formData();
  const pass = body.get("passphrase");
  isValid = pass === correctPassphrase;

  if (isValid) {
    return Astro.redirect('/home');
  }
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      /* your existing styling here */
    </style>
  </head>
  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>
      <form method="POST">
        <input type="password" name="passphrase" placeholder="Enter passphrase" required />
        <br />
        <button type="submit">Enter</button>
      </form>

      {Astro.request.method === "POST" && !isValid && <p class="error">❌ Incorrect passphrase.</p>}
    </div>
  </body>
</html>
