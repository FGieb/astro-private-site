---
export const prerender = false;

import { createSession } from "../lib/auth";

const correctPassphrase = import.meta.env.LOGIN_PASSPHRASE;
const isPost = Astro.request.method === "POST";

let error = "";
let step: "passphrase" | "code" = "passphrase";
let debugCode: string | null = null;

if (isPost) {
  const formData = await Astro.request.formData();

  // STEP 1 — passphrase
  if (step === "passphrase") {
    const pass = formData.get("passphrase");

    if (pass === correctPassphrase) {
      // 🔐 generate code
      const code = Math.floor(100000 + Math.random() * 900000).toString();

      // store in cookie (10 min)
      Astro.cookies.set("login_code", code, {
        path: "/",
        httpOnly: true,
        secure: true,
        sameSite: "Strict",
        maxAge: 60 * 10,
      });

      debugCode = code; // 👈 TEMPORARY
      step = "code";
    } else {
      error = "Incorrect passphrase.";
    }
  }

  // STEP 2 — verify code
  else if (step === "code") {
    const input = (formData.get("code") || "").toString().trim();
    const stored = Astro.cookies.get("login_code")?.value;

    if (!stored) {
      error = "Verification code expired. Reload and try again.";
      step = "passphrase";
    } else if (input !== stored) {
      error = "Incorrect verification code.";
    } else {
      // ✅ SUCCESS — still no session yet
      debugCode = "✔ Code accepted";
    }
  }
}
---



<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <style>
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background-image: url('/images/background1.jpg');
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .login-box {
        background: rgba(255,255,255,0.85);
        padding: 2rem 3rem;
        border-radius: 1rem;
        max-width: 420px;
        width: 92%;
        text-align: center;
      }
      input {
        width: 100%;
        padding: 0.6rem;
        margin-bottom: 1rem;
      }
      button {
        padding: 0.6rem 1.2rem;
        background: #222;
        color: white;
        border: none;
        cursor: pointer;
      }
      .error {
        color: #c00;
        margin-top: 0.75rem;
      }
    </style>
  </head>
  <body>
    <div class="login-box">
      <h1>🔐 Private Access</h1>
    
      {step === "passphrase" && (
        <form method="POST">
          <input
            type="password"
            name="passphrase"
            placeholder="Passphrase"
            required
          />
          <button>Enter</button>
        </form>
      )}

      {step === "code" && (
        <>
          <p>Passphrase accepted.</p>
          <p>Verification step (code) will go here.</p>
      
          <form method="POST">
            <input
              type="text"
              name="code"
              placeholder="Verification code"
              required
            />
            <button>Verify</button>
          </form>
      
          {debugCode && (
            <p style="margin-top: 1rem; font-family: monospace;">
              DEBUG CODE: <strong>{debugCode}</strong>
            </p>
          )}
        </>
      )}
    
      {error && <p class="error">❌ {error}</p>}
    </div>

  </body>
</html>
