---
import { getStore } from "@netlify/blobs";
import { isValidSession } from "../lib/auth";
import BaseLayout from "../layouts/BaseLayout.astro";

const cookie = Astro.cookies.get("auth");

if (!(await isValidSession(cookie?.value))) {
  return Astro.redirect("/login");
}

const store = getStore("bets");
const raw = await store.get("bets");

const bets = raw
  ? JSON.parse(new TextDecoder().decode(raw))
  : [];
---

<BaseLayout title="Bets">
  <main class="bets-shell">
    <header class="bets-header">
      <h1>🎲 Bets</h1>
      <p class="subtitle">A small ledger of promises.</p>
    </header>

    <section class="bets-table">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Title</th>
            <th>Stakes</th>
            <th>Owner</th>
            <th>Status</th>
            <th>Notes</th>
          </tr>
        </thead>

        <tbody>
          {bets.length === 0 ? (
            <tr>
              <td colSpan="6" class="empty">
                No bets yet — the first one always feels ceremonial.
              </td>
            </tr>
          ) : (
            bets.map((bet) => (
              <tr
                class:list={{
                  open: bet.status === "open",
                  done: bet.status !== "open",
                }}
              >
                <td>{bet.date}</td>
                <td>{bet.title}</td>
                <td>{bet.stakes}</td>
                <td>{bet.owner || "—"}</td>
                <td>
                  <button
                    type="button"
                    class:list={{
                      status: true,
                      open: bet.status === "open",
                      done: bet.status !== "open",
                    }}
                    data-id={bet.id}
                    data-status={bet.status}
                  >
                    {bet.status}
                  </button>
                </td>
                <td>{bet.notes || ""}</td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </section>

    <section class="bets-form">
      <h2>Add a bet</h2>

      <form method="POST" action="/.netlify/functions/add-bet">
        <input
          type="hidden"
          name="date"
          value={new Date().toISOString().slice(0, 10)}
        />

        <label>
          Title
          <input name="title" required />
        </label>

        <label>
          Stakes
          <input name="stakes" required />
        </label>

        <label>
          Notes
          <textarea name="notes" rows="3"></textarea>
        </label>

        <button type="submit">Add bet</button>
      </form>
    </section>
  </main>

  <script>
    document.querySelectorAll(".status").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const current = btn.dataset.status;
        const next = current === "open" ? "done" : "open";

        const res = await fetch("/.netlify/functions/update-bet", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, status: next }),
        });

        if (res.ok) {
          location.reload();
        } else {
          alert("Could not update bet.");
        }
      });
    });
  </script>
</BaseLayout>

<style>
:root {
  --accent-blue: #0a74c9;
}

.bets-shell {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2.5rem 1.25rem 4rem;
}

.bets-header {
  text-align: center;
  margin-bottom: 2.25rem;
}

.bets-header h1::after {
  content: "";
  display: block;
  width: 48px;
  height: 3px;
  margin: 0.5rem auto 0;
  border-radius: 999px;
  background: var(--accent-blue);
}

.subtitle {
  font-size: 0.9rem;
  opacity: 0.6;
}

.bets-table {
  background: rgba(0, 0, 0, 0.35);
  border-radius: 1rem;
  padding: 1rem 1.25rem;
  backdrop-filter: blur(6px);
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  padding: 0.65rem 0.6rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 0.9rem;
  vertical-align: top;
}

th {
  text-align: left;
  font-weight: 600;
  opacity: 0.75;
}

td.empty {
  text-align: center;
  padding: 1.5rem;
  opacity: 0.6;
  font-style: italic;
}

tr.open {
  background: rgba(10, 116, 201, 0.12);
}

tr.done {
  opacity: 0.6;
}

.status {
  cursor: pointer;
  border: none;
  border-radius: 999px;
  padding: 0.2rem 0.6rem;
  font-size: 0.75rem;
  text-transform: lowercase;
  background: transparent;
}

.status.open {
  background: rgba(10, 116, 201, 0.25);
  color: white;
}

.status.done {
  background: rgba(255, 255, 255, 0.15);
  color: white;
}

.bets-form {
  margin-top: 3rem;
  max-width: 420px;
  margin-inline: auto;
  background: rgba(255, 255, 255, 0.92);
  color: #111;
  padding: 1.4rem 1.5rem;
  border-radius: 1.1rem;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
}

.bets-form h2 {
  margin-bottom: 0.75rem;
  font-size: 1rem;
}

.bets-form label {
  display: block;
  font-size: 0.8rem;
  margin-bottom: 0.75rem;
}

.bets-form input,
.bets-form textarea {
  width: 100%;
  margin-top: 0.25rem;
  padding: 0.45rem 0.55rem;
  border-radius: 0.5rem;
  border: 1px solid rgba(0, 0, 0, 0.2);
  font-family: inherit;
  box-sizing: border-box;
}

.bets-form button[type="submit"] {
  margin-top: 0.8rem;
  padding: 0.45rem 1rem;
  border-radius: 999px;
  border: none;
  background: #111;
  color: white;
  cursor: pointer;
}
</style>
