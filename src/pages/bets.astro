---
import { getStore } from "@netlify/blobs";
import { isValidSession } from "../lib/auth";
import BaseLayout from "../layouts/BaseLayout.astro";

const cookie = Astro.cookies.get("auth");

if (!(await isValidSession(cookie?.value))) {
  return Astro.redirect("/login");
}

function blobToText(raw) {
  if (!raw) return "";
  if (typeof raw === "string") return raw;
  if (raw instanceof Uint8Array) return new TextDecoder().decode(raw);
  return String(raw);
}

const store = getStore("bets");
const raw = await store.get("bets");

let bets = [];

try {
  const text = blobToText(raw).trim();
  bets = text ? JSON.parse(text) : [];
} catch (err) {
  console.error("Failed to parse bets blob:", err);
  bets = [];
}

bets = Array.isArray(bets) ? bets : [];

bets.sort((a, b) => {
  const da = new Date(b?.betDate || b?.date || 0).getTime();
  const db = new Date(a?.betDate || a?.date || 0).getTime();
  return db - da;
});
---

<BaseLayout title="Bets">
  <main class="bets-shell">
    <header class="bets-header">
      <h1>🎲 Bets</h1>
      <p class="subtitle">A small ledger of promises.</p>
    </header>

    <div class="bets-layout">
      <section class="bets-card">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Bet date</th>
                <th>Title</th>
                <th>Stakes</th>
                <th>Who owes it</th>
                <th>Status</th>
                <th>Done on</th>
                <th>Notes</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              {bets.length === 0 ? (
                <tr>
                  <td colSpan="8" class="empty">
                    No bets yet — the first one always feels ceremonial.
                  </td>
                </tr>
              ) : (
                bets.map((bet) => (
                  <>
                    <tr
                      class:list={{
                        "bet-row": true,
                        open: (bet.status || "open") === "open",
                        done: bet.status === "done",
                      }}
                    >
                      <td>{bet.betDate || bet.date || "—"}</td>
                      <td class="title-cell">{bet.title}</td>
                      <td>{bet.stakes}</td>
                      <td>{bet.owner || "—"}</td>
                      <td>
                        <span
                          class:list={{
                            pill: true,
                            statusPill: true,
                            open: (bet.status || "open") === "open",
                            done: bet.status === "done",
                          }}
                        >
                          {bet.status || "open"}
                        </span>
                      </td>
                      <td>{bet.executedDate || "—"}</td>
                      <td>{bet.notes || ""}</td>
                      <td class="actions-cell">
                        <button
                          type="button"
                          class="action-btn edit-toggle-btn"
                          data-action="toggle-edit"
                          data-id={bet.id}
                        >
                          Edit
                        </button>
                        <button
                          type="button"
                          class="action-btn delete-btn"
                          data-action="delete-bet"
                          data-id={bet.id}
                        >
                          Delete
                        </button>
                      </td>
                    </tr>

                    <tr class="edit-row hidden" data-edit-row={bet.id}>
                      <td colSpan="8">
                        <form class="edit-form" data-edit-form={bet.id}>
                          <input type="hidden" name="id" value={bet.id} />

                          <label>
                            Bet date
                            <input
                              type="date"
                              name="betDate"
                              value={bet.betDate || bet.date || ""}
                            />
                          </label>

                          <label>
                            Title
                            <input
                              type="text"
                              name="title"
                              value={bet.title || ""}
                              required
                            />
                          </label>

                          <label>
                            Stakes
                            <input
                              type="text"
                              name="stakes"
                              value={bet.stakes || ""}
                              required
                            />
                          </label>

                          <label>
                            Who owes it
                            <select name="owner">
                              <option value="" selected={!bet.owner}>—</option>
                              <option value="LM" selected={bet.owner === "LM"}>LM</option>
                              <option value="BM" selected={bet.owner === "BM"}>BM</option>
                            </select>
                          </label>

                          <label>
                            Status
                            <select name="status">
                              <option value="open" selected={(bet.status || "open") === "open"}>open</option>
                              <option value="done" selected={bet.status === "done"}>done</option>
                            </select>
                          </label>

                          <label>
                            Done on
                            <input
                              type="date"
                              name="executedDate"
                              value={bet.executedDate || ""}
                            />
                          </label>

                          <label class="notes-field">
                            Notes
                            <textarea name="notes" rows="3">{bet.notes || ""}</textarea>
                          </label>

                          <div class="edit-actions">
                            <button type="submit" class="save-small-btn">Save changes</button>
                            <button
                              type="button"
                              class="cancel-btn"
                              data-action="toggle-edit"
                              data-id={bet.id}
                            >
                              Cancel
                            </button>
                          </div>
                        </form>
                      </td>
                    </tr>
                  </>
                ))
              )}
            </tbody>
          </table>
        </div>
      </section>

      <section class="bet-form-card">
        <h2>Add a bet</h2>

        <form id="betForm" class="bet-form">
          <label>
            Bet date
            <input
              type="date"
              name="betDate"
              value={new Date().toISOString().slice(0, 10)}
              required
            />
          </label>

          <label>
            Title
            <input name="title" required />
          </label>

          <label>
            Stakes
            <input name="stakes" required />
          </label>

          <label>
            Who owes it
            <select name="owner">
              <option value="">—</option>
              <option value="LM">LM</option>
              <option value="BM">BM</option>
            </select>
          </label>

          <label>
            Status
            <select name="status">
              <option value="open">open</option>
              <option value="done">done</option>
            </select>
          </label>

          <label>
            Done on
            <input type="date" name="executedDate" />
          </label>

          <label>
            Notes
            <textarea name="notes" rows="4"></textarea>
          </label>

          <button type="submit" class="save-btn">Save bet</button>
        </form>
      </section>
    </div>
  </main>

  <script>
    async function postJson(url, payload) {
      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      let data = {};
      try {
        data = await res.json();
      } catch {}

      if (!res.ok || data.ok === false) {
        throw new Error(data?.error || "Request failed");
      }

      return data;
    }

    const statusSelect = document.querySelector("#betForm select[name='status']");
    const executedDateInput = document.querySelector("#betForm input[name='executedDate']");
    const betForm = document.getElementById("betForm");

    if (statusSelect && executedDateInput) {
      statusSelect.addEventListener("change", () => {
        if (statusSelect.value === "done" && !executedDateInput.value) {
          executedDateInput.value = new Date().toISOString().slice(0, 10);
        }
        if (statusSelect.value === "open") {
          executedDateInput.value = "";
        }
      });
    }

    if (betForm) {
      betForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(betForm);

        try {
          const res = await fetch("/.netlify/functions/add-bet", {
            method: "POST",
            body: formData,
          });

          const data = await res.json();

          if (!res.ok || !data.ok) {
            throw new Error(data?.error || "Failed to save bet");
          }

          location.reload();
        } catch (err) {
          alert("Could not save bet.");
          console.error(err);
        }
      });
    }

    document.querySelectorAll("[data-action='toggle-edit']").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.id;
        const row = document.querySelector(`[data-edit-row="${id}"]`);
        if (row) row.classList.toggle("hidden");
      });
    });

    document.querySelectorAll("[data-edit-form]").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const id = formData.get("id");

        const updates = {
          betDate: String(formData.get("betDate") || ""),
          title: String(formData.get("title") || ""),
          stakes: String(formData.get("stakes") || ""),
          owner: String(formData.get("owner") || ""),
          status: String(formData.get("status") || "open"),
          executedDate: String(formData.get("executedDate") || ""),
          notes: String(formData.get("notes") || ""),
        };

        if (updates.status === "done" && !updates.executedDate) {
          updates.executedDate = new Date().toISOString().slice(0, 10);
        }

        if (updates.status === "open") {
          updates.executedDate = "";
        }

        try {
          await postJson("/.netlify/functions/update-bet", {
            id,
            updates,
          });
          location.reload();
        } catch (err) {
          alert("Could not update bet.");
          console.error(err);
        }
      });
    });

    document.querySelectorAll("[data-action='delete-bet']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;

        if (!confirm("Delete this bet?")) return;

        try {
          await postJson("/.netlify/functions/delete-bet", { id });
          location.reload();
        } catch (err) {
          alert("Could not delete bet.");
          console.error(err);
        }
      });
    });
  </script>
</BaseLayout>

<style is:global>
  :root {
    color-scheme: dark;
  }

  .bets-shell {
    max-width: 1450px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .bets-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .bets-header h1 {
    margin-bottom: 0.35rem;
  }

  .bets-header h1::after {
    content: "";
    display: block;
    width: 48px;
    height: 3px;
    margin: 0.5rem auto 0;
    border-radius: 999px;
    background: #0a74c9;
  }

  .subtitle {
    font-size: 0.95rem;
    opacity: 0.7;
  }

  .bets-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(360px, 0.9fr);
    gap: 2.5rem;
    align-items: start;
  }

  .bets-card,
  .bet-form-card {
    background: linear-gradient(180deg, #101214 0%, #0d0f11 100%);
    border: 1px solid #20242a;
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.9rem 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font-size: 0.95rem;
    vertical-align: top;
    text-align: left;
  }

  th {
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
    background: rgba(10, 116, 201, 0.10);
    border-bottom: 1px solid rgba(10, 116, 201, 0.35);
  }

  th:first-child { border-radius: 0.6rem 0 0 0; }
  th:last-child  { border-radius: 0 0.6rem 0 0; }

  .bet-row {
    transition: background 0.12s;
  }

  .bet-row:hover td {
    background: rgba(255, 255, 255, 0.03);
  }

  .bet-row.open {
    background: rgba(10, 116, 201, 0.08);
  }

  .bet-row.open:hover td {
    background: rgba(10, 116, 201, 0.13);
  }

  .bet-row.done {
    background: rgba(255, 255, 255, 0.02);
    opacity: 0.85;
  }

  .title-cell {
    font-weight: 600;
  }

  td.empty {
    text-align: center;
    padding: 1.4rem;
    opacity: 0.65;
    font-style: italic;
  }

  .pill {
    display: inline-block;
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: white;
  }

  .statusPill.open {
    background: #0a74c9;
  }

  .statusPill.done {
    background: #1f2a35;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .actions-cell {
    min-width: 150px;
  }

  .action-btn,
  .save-small-btn,
  .cancel-btn {
    border: none;
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    margin-right: 0.4rem;
  }

  .edit-toggle-btn {
    background: #143252;
    color: white;
  }

  .delete-btn {
    background: #3a1717;
    color: #ffd2d2;
  }

  .save-small-btn {
    background: #0a74c9;
    color: white;
  }

  .cancel-btn {
    background: #1f1f1f;
    color: rgba(255, 255, 255, 0.85);
  }

  .edit-row.hidden {
    display: none;
  }

  .edit-row td {
    background: rgba(255, 255, 255, 0.025);
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .edit-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(180px, 1fr));
    gap: 0.9rem 1rem;
    align-items: start;
  }

  .edit-form label,
  .bet-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
  }

  .notes-field {
    grid-column: 1 / -1;
  }

  .edit-actions {
    grid-column: 1 / -1;
    margin-top: 0.35rem;
  }

  .bet-form-card h2 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .bet-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .edit-form input,
  .edit-form select,
  .edit-form textarea,
  .bet-form input,
  .bet-form select,
  .bet-form textarea {
    padding: 0.65rem 0.75rem;
    font-size: 0.95rem;
    border-radius: 0.75rem;
    border: 1px solid #343a42;
    background: #15181c;
    color: white;
    font-family: inherit;
  }

  .edit-form textarea,
  .bet-form textarea {
    min-height: 110px;
    resize: vertical;
  }

  .save-btn {
    margin-top: 0.5rem;
    align-self: flex-start;
    background: #0a74c9;
    color: white;
    border: none;
    border-radius: 999px;
    padding: 0.6rem 1rem;
    cursor: pointer;
    font-weight: 700;
  }

  @media (max-width: 1080px) {
    .bets-layout {
      grid-template-columns: 1fr;
    }

    .edit-form {
      grid-template-columns: 1fr;
    }
  }
</style>
