---
import { isValidSession } from "../lib/auth";
import BaseLayout from "../layouts/BaseLayout.astro";

const cookie = Astro.cookies.get("auth");

if (!(await isValidSession(cookie?.value))) {
  return Astro.redirect("/login");
}

// Load bets dynamically
const betsRes = await fetch(
  new URL("/.netlify/functions/get-bets", Astro.url)
);

const bets = betsRes.ok ? await betsRes.json() : [];
---

<BaseLayout title="Bets">
  <main class="bets-shell">

    <!-- HEADER -->
    <header class="bets-header">
      <h1>🎲 Bets</h1>
      <p class="subtitle">A small ledger of promises.</p>
    </header>

    <!-- TABLE -->
    <section class="bets-table">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Title</th>
            <th>Stakes</th>
            <th>Owner</th>
            <th>Status</th>
            <th>Notes</th>
          </tr>
        </thead>

        <tbody>
          {bets.length === 0 ? (
            <tr>
              <td colspan="6" class="empty">
                No bets yet — the first one always feels ceremonial.
              </td>
            </tr>
          ) : (
            bets.map((bet) => (
              <tr
                class:list={{
                  open: bet.status === "open",
                  done: bet.status !== "open",
                }}
              >
                <td>{bet.date}</td>
                <td>{bet.title}</td>
                <td>{bet.stakes}</td>
                <td>{bet.owner || "—"}</td>
                <td>
                  <button
                    class:list={{
                      status: true,
                      open: bet.status === "open",
                      done: bet.status !== "open",
                    }}
                    data-id={bet.id}
                    data-status={bet.status}
                  >
                    {bet.status}
                  </button>
                </td>
                <td>{bet.notes || ""}</td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </section>

    <!-- FORM -->
    <section class="bets-form">
      <h2>Add a bet</h2>

      <form method="POST" action="/.netlify/functions/add-bet">
        <input
          type="hidden"
          name="date"
          value={new Date().toISOString().slice(0, 10)}
        />

        <label>
          Title
          <input name="title" required />
        </label>

        <label>
          Stakes
          <input name="stakes" required />
        </label>

        <label>
          Notes
          <textarea name="notes" rows="3"></textarea>
        </label>

        <button type="submit">Add bet</button>
      </form>
    </section>

  </main>

  <!-- STATUS TOGGLE SCRIPT -->
  <script>
    document.querySelectorAll(".status").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const current = btn.dataset.status;
        const next = current === "open" ? "done" : "open";

        await fetch("/.netlify/functions/update-bet", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, status: next }),
        });

        location.reload();
      });
    });
  </script>
</BaseLayout>

<style>
/* ===== ACCENT ===== */
:root {
  --accent-blue: #0a74c9;
}

/* ===== SHELL ===== */
.bets-shell {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2.5rem 1.25rem 4rem;
}

/* ===== HEADER ===== */
.bets-header {
  text-align: center;
  margin-bottom: 2.25rem;
}

.bets-header h1::after {
  content: "";
  display: block;
  width: 48px;
  height: 3px;
  margin: 0.5rem auto 0;
  border-radius: 999px;
  background: var(--accent-blue);
}

.subtitle {
  font-size: 0.9rem;
  opacity: 0.6;
}

/* ===== TABLE ===== */
.bets-table {
  background: rgba(0,0,0,0.35);
  border-radius: 1rem;
  padding: 1rem 1.25rem;
  backdrop-filter: blur(6px);
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  padding: 0.65rem 0.6rem;
  border-bottom: 1px solid rgba(255,255,255,0.12);
  font-size: 0.9rem;
}

tr.open {
  background: rgba(10,116,201,0.12);
}

tr.done {
  opacity: 0.6;
}

/* ===== STATUS BUTTON ===== */
.status {
  cursor: pointer;
  border: none;
  border-radius: 999px;
  padding: 0.15rem 0.55rem;
  font-size: 0.75rem;
  text-transform: lowercase;
  background: transparent;
}

.status.open {
  background: rgba(10,116,201,0.25);
  color: white;
}

.status.done {
  background: rgba(255,255,255,0.15);
}

/* ===== FORM ===== */
.bets-form {
  margin-top: 3rem;
  max-width: 420px;
  margin-inline: auto;
  background: rgba(255,255,255,0.92);
  color: #111;
  padding: 1.4rem 1.5rem;
  border-radius: 1.1rem;
}
</style>
