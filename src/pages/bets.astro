---
import { getStore } from "@netlify/blobs";
import { isValidSession } from "../lib/auth";
import BaseLayout from "../layouts/BaseLayout.astro";

const cookie = Astro.cookies.get("auth");

if (!(await isValidSession(cookie?.value))) {
  return Astro.redirect("/login");
}

function blobToText(raw) {
  if (!raw) return "";
  if (typeof raw === "string") return raw;
  if (raw instanceof Uint8Array) return new TextDecoder().decode(raw);
  return String(raw);
}

const store = getStore("bets");
const raw = await store.get("bets");

let bets = [];

try {
  const text = blobToText(raw).trim();
  bets = text ? JSON.parse(text) : [];
} catch (err) {
  console.error("Failed to parse bets blob:", err);
  bets = [];
}

bets = Array.isArray(bets) ? bets : [];

bets.sort((a, b) => {
  const da = new Date(b?.betDate || b?.date || 0).getTime();
  const db = new Date(a?.betDate || a?.date || 0).getTime();
  return db - da;
});
---

<BaseLayout title="Bets">
  <main class="bets-shell">
    <header class="bets-header">
      <h1>🎲 Bets</h1>
      <p class="subtitle">A small ledger of promises.</p>
    </header>

    <!-- ═══════════════  DICE & DARES  ═══════════════ -->
    <section class="dice-section">
      <button type="button" id="diceToggle" class="dice-toggle-btn">
        🎲 Dice &amp; Dares
        <span class="toggle-arrow">▾</span>
      </button>

      <div id="dicePanel" class="dice-panel hidden">

        <!-- Step 0 — who are you? -->
        <div id="diceStep0" class="dice-step">
          <p class="dice-prompt">Who's rolling?</p>
          <div class="player-btns">
            <button type="button" class="player-btn" data-player="LM">LM</button>
            <button type="button" class="player-btn" data-player="BM">BM</button>
          </div>
        </div>

        <!-- Step 1 — roll for category -->
        <div id="diceStep1" class="dice-step hidden">
          <p class="dice-prompt"><span id="playerLabel"></span>, roll for the category.</p>

          <div class="mode-switch">
            <button type="button" class="mode-btn active" data-mode="roll" data-step="cat">🎲 Roll</button>
            <button type="button" class="mode-btn" data-mode="pick" data-step="cat">✋ Pick</button>
          </div>

          <div id="catOverview" class="overview-grid">
            <!-- filled by JS -->
          </div>

          <div id="catRollArea">
            <div class="dice-container">
              <div class="die" id="dieCat">
                <div class="die-face">?</div>
              </div>
            </div>
            <button type="button" id="rollCatBtn" class="roll-btn">Roll for category</button>
          </div>

          <div id="catResult" class="roll-result hidden">
            <p class="result-name" id="catName"></p>
            <button type="button" id="goToBetRoll" class="continue-btn">Continue to the bet roll →</button>
          </div>
        </div>

        <!-- Step 2 — roll for the bet -->
        <div id="diceStep2" class="dice-step hidden">
          <p class="dice-prompt">Category: <strong id="catLabel2"></strong></p>
          <button type="button" id="backToCat" class="back-link">← back to categories</button>

          <div class="mode-switch">
            <button type="button" class="mode-btn active" data-mode="roll" data-step="bet">🎲 Roll</button>
            <button type="button" class="mode-btn" data-mode="pick" data-step="bet">✋ Pick</button>
          </div>

          <div id="betOverview" class="overview-list">
            <!-- filled by JS -->
          </div>

          <div id="betRollArea">
            <div class="dice-container">
              <div class="die" id="dieBet">
                <div class="die-face">?</div>
              </div>
            </div>
            <button type="button" id="rollBetBtn" class="roll-btn">Roll for the bet</button>
          </div>

          <div id="betResult" class="roll-result hidden">
            <p class="tonight-label">Tonight's bet</p>
            <p class="tonight-bet" id="betText">—</p>
            <p class="tonight-desc" id="betDesc"></p>
            <button type="button" id="saveDiceBet" class="save-dice-btn">🎲 Save to bets</button>
            <button type="button" id="startOver" class="back-link" style="margin-top:.5rem">Start over</button>
          </div>
        </div>

      </div>
    </section>
    <!-- ═══════════════ /DICE & DARES ═══════════════ -->

    <div class="bets-layout">
      <section class="bets-card">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Bet date</th>
                <th>Title</th>
                <th>Stakes</th>
                <th>Who owes it</th>
                <th>Status</th>
                <th>Done on</th>
                <th>Notes</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              {bets.length === 0 ? (
                <tr>
                  <td colSpan="8" class="empty">
                    No bets yet — the first one always feels ceremonial.
                  </td>
                </tr>
              ) : (
                bets.map((bet) => (
                  <>
                    <tr
                      class:list={{
                        "bet-row": true,
                        open: (bet.status || "open") === "open",
                        done: bet.status === "done",
                      }}
                    >
                      <td>{bet.betDate || bet.date || "—"}</td>
                      <td class="title-cell">{bet.title}</td>
                      <td>{bet.stakes}</td>
                      <td>{bet.owner || "—"}</td>
                      <td>
                        <span
                          class:list={{
                            pill: true,
                            statusPill: true,
                            open: (bet.status || "open") === "open",
                            done: bet.status === "done",
                          }}
                        >
                          {bet.status || "open"}
                        </span>
                      </td>
                      <td>{bet.executedDate || "—"}</td>
                      <td>{bet.notes || ""}</td>
                      <td class="actions-cell">
                        <button
                          type="button"
                          class="action-btn edit-toggle-btn"
                          data-action="toggle-edit"
                          data-id={bet.id}
                        >
                          Edit
                        </button>
                        <button
                          type="button"
                          class="action-btn delete-btn"
                          data-action="delete-bet"
                          data-id={bet.id}
                        >
                          Delete
                        </button>
                      </td>
                    </tr>

                    <tr class="edit-row hidden" data-edit-row={bet.id}>
                      <td colSpan="8">
                        <form class="edit-form" data-edit-form={bet.id}>
                          <input type="hidden" name="id" value={bet.id} />

                          <label>
                            Bet date
                            <input
                              type="date"
                              name="betDate"
                              value={bet.betDate || bet.date || ""}
                            />
                          </label>

                          <label>
                            Title
                            <input
                              type="text"
                              name="title"
                              value={bet.title || ""}
                              required
                            />
                          </label>

                          <label>
                            Stakes
                            <input
                              type="text"
                              name="stakes"
                              value={bet.stakes || ""}
                              required
                            />
                          </label>

                          <label>
                            Who owes it
                            <select name="owner">
                              <option value="" selected={!bet.owner}>—</option>
                              <option value="LM" selected={bet.owner === "LM"}>LM</option>
                              <option value="BM" selected={bet.owner === "BM"}>BM</option>
                            </select>
                          </label>

                          <label>
                            Status
                            <select name="status">
                              <option value="open" selected={(bet.status || "open") === "open"}>open</option>
                              <option value="done" selected={bet.status === "done"}>done</option>
                            </select>
                          </label>

                          <label>
                            Done on
                            <input
                              type="date"
                              name="executedDate"
                              value={bet.executedDate || ""}
                            />
                          </label>

                          <label class="notes-field">
                            Notes
                            <textarea name="notes" rows="3">{bet.notes || ""}</textarea>
                          </label>

                          <div class="edit-actions">
                            <button type="submit" class="save-small-btn">Save changes</button>
                            <button
                              type="button"
                              class="cancel-btn"
                              data-action="toggle-edit"
                              data-id={bet.id}
                            >
                              Cancel
                            </button>
                          </div>
                        </form>
                      </td>
                    </tr>
                  </>
                ))
              )}
            </tbody>
          </table>
        </div>
      </section>

      <section class="bet-form-card">
        <h2>Add a bet</h2>

        <form id="betForm" class="bet-form">
          <label>
            Bet date
            <input
              type="date"
              name="betDate"
              value={new Date().toISOString().slice(0, 10)}
              required
            />
          </label>

          <label>
            Title
            <input name="title" required />
          </label>

          <label>
            Stakes
            <input name="stakes" required />
          </label>

          <label>
            Who owes it
            <select name="owner">
              <option value="">—</option>
              <option value="LM">LM</option>
              <option value="BM">BM</option>
            </select>
          </label>

          <label>
            Status
            <select name="status">
              <option value="open">open</option>
              <option value="done">done</option>
            </select>
          </label>

          <label>
            Done on
            <input type="date" name="executedDate" />
          </label>

          <label>
            Notes
            <textarea name="notes" rows="4"></textarea>
          </label>

          <button type="submit" class="save-btn">Save bet</button>
        </form>
      </section>
    </div>
  </main>

  <script>
    async function postJson(url, payload) {
      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      let data = {};
      try {
        data = await res.json();
      } catch {}

      if (!res.ok || data.ok === false) {
        throw new Error(data?.error || "Request failed");
      }

      return data;
    }

    const statusSelect = document.querySelector("#betForm select[name='status']");
    const executedDateInput = document.querySelector("#betForm input[name='executedDate']");
    const betForm = document.getElementById("betForm");

    if (statusSelect && executedDateInput) {
      statusSelect.addEventListener("change", () => {
        if (statusSelect.value === "done" && !executedDateInput.value) {
          executedDateInput.value = new Date().toISOString().slice(0, 10);
        }
        if (statusSelect.value === "open") {
          executedDateInput.value = "";
        }
      });
    }

    if (betForm) {
      betForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(betForm);

        try {
          const res = await fetch("/.netlify/functions/add-bet", {
            method: "POST",
            body: formData,
          });

          const data = await res.json();

          if (!res.ok || !data.ok) {
            throw new Error(data?.error || "Failed to save bet");
          }

          location.reload();
        } catch (err) {
          alert("Could not save bet.");
          console.error(err);
        }
      });
    }

    document.querySelectorAll("[data-action='toggle-edit']").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.id;
        const row = document.querySelector(`[data-edit-row="${id}"]`);
        if (row) row.classList.toggle("hidden");
      });
    });

    document.querySelectorAll("[data-edit-form]").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const id = formData.get("id");

        const updates = {
          betDate: String(formData.get("betDate") || ""),
          title: String(formData.get("title") || ""),
          stakes: String(formData.get("stakes") || ""),
          owner: String(formData.get("owner") || ""),
          status: String(formData.get("status") || "open"),
          executedDate: String(formData.get("executedDate") || ""),
          notes: String(formData.get("notes") || ""),
        };

        if (updates.status === "done" && !updates.executedDate) {
          updates.executedDate = new Date().toISOString().slice(0, 10);
        }

        if (updates.status === "open") {
          updates.executedDate = "";
        }

        try {
          await postJson("/.netlify/functions/update-bet", {
            id,
            updates,
          });
          location.reload();
        } catch (err) {
          alert("Could not update bet.");
          console.error(err);
        }
      });
    });

    document.querySelectorAll("[data-action='delete-bet']").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;

        if (!confirm("Delete this bet?")) return;

        try {
          await postJson("/.netlify/functions/delete-bet", { id });
          location.reload();
        } catch (err) {
          alert("Could not delete bet.");
          console.error(err);
        }
      });
    });
  </script>

  <!-- ═══════════════  DICE & DARES SCRIPT  ═══════════════ -->
  <script>
    const CATEGORIES = [
      {
        name: "Micro-moments",
        tag: "low effort, quick spark",
        bets: [
          { title: "1-minute eye contact", desc: "Set a timer for one minute and hold eye contact — no talking, no laughing your way out of it." },
          { title: "Philosophical question or dilemma", desc: "One of you poses a real dilemma or big question, the other has to actually answer it, not deflect." },
          { title: "5 random facts", desc: "Each brings 5 facts to impress the other — surprising, funny, or oddly specific, no mid-game research." },
          { title: "Lie detector game", desc: "Each of you tells 3 stories, two true and one invented, the other has to spot the lie." }
        ]
      },
      {
        name: "Made for you",
        tag: "someone prepares & presents",
        bets: [
          { title: "PowerPoint on a topic", desc: "Pick a topic, however niche, and build a short deck to actually present to the other." },
          { title: "Presentation", desc: "Same spirit as the PowerPoint, but freeform — no slides required, just come prepared to talk." },
          { title: "Teaching a skill", desc: "Teach the other something you genuinely know how to do, hands-on if possible." },
          { title: "City tour, as guide", desc: "Plan a walking route with streets, monuments and a few facts, and guide the other through it outside." },
          { title: "A random day from the chat", desc: "Scroll back to a random day from the last month and present what happened, like reporting the news." }
        ]
      },
      {
        name: "Taste & drink",
        tag: "cocktails, dinners, weird snacks",
        bets: [
          { title: "Homemade cocktail night", desc: "Design and make a cocktail from what's in the house, or a quick supermarket run." },
          { title: "Wine and dinner", desc: "Plan a proper wine and dinner pairing — doesn't have to be fancy, just intentional." },
          { title: "Wine price testing", desc: "Buy 2–3 wines across a price range and blind taste them — see if the cheap one actually loses." },
          { title: "Weird food", desc: "Buy, cook, or order something neither of you has tried before." },
          { title: "Food testing at the store", desc: "Pick a category — chips, chocolate, whatever — and compare a few brands side by side." },
          { title: "Five-ingredient cook-off", desc: "Cook a full dish using only five ingredients. Salt, water and oil don't count." }
        ]
      },
      {
        name: "Go explore",
        tag: "out of the apartment",
        bets: [
          { title: "Choose a museum", desc: "Pick a museum neither of you has been to, and go." },
          { title: "Night in Paris", desc: "Plan a full evening — a walk, a bar, a restaurant — like you're showing a friend around." },
          { title: "Metro line adventure", desc: "Pick a metro line at random and get off wherever looks interesting." },
          { title: "Random country night", desc: "Spin a globe or use a random generator, then build a night around that country — a dish, a phrase or two, a drink." },
          { title: "Scavenger hunt", desc: "Build a mini hunt with clues around the city or apartment for the other to solve." }
        ]
      },
      {
        name: "Structured game night",
        tag: "a format, not just an activity",
        bets: [
          { title: "Dice date", desc: "Assign an action to each die number, then roll through a whole evening built entirely on chance." },
          { title: "Offline evening", desc: "No phones for the night — one of you plans everything: what to do, eat, talk about, play." },
          { title: "Documentary + debate", desc: "Pick a surprising or obscure documentary, prepare snacks that match the topic, then debate what you watched." },
          { title: "Can't wear black", desc: "Pick a colour, and that's the only thing either of you can wear for the night." },
          { title: "Home Olympics", desc: "Invent three ridiculous physical challenges and run a best-of-three." },
          { title: "Dress-up theme night", desc: "Pick a dress code, however specific — no vetoes allowed." }
        ]
      },
      {
        name: "A little deeper",
        tag: "more meaningful, a bit of vulnerability",
        bets: [
          { title: "3 questions never asked", desc: "Each of you asks one question you've genuinely never asked the other, then actually answers it." },
          { title: "Name one fear", desc: "Say one fear out loud — no follow-up questions unless the other actually wants to ask." },
          { title: "Podcast interview", desc: "Interview each other like a guest on a show. Recording is optional, but treat it like a real conversation." },
          { title: "Time capsule", desc: "Each write down predictions and hopes for a year from now, seal it, and put a date in the calendar to open it." },
          { title: "Write and perform something", desc: "Write a song, poem or toast for the other, and actually perform it." }
        ]
      }
    ];

    let chosenPlayer = "";
    let chosenCatIdx = -1;
    let chosenBetIdx = -1;
    let rolling = false;
    let catMode = "roll";  // "roll" or "pick"
    let betMode = "roll";

    /* ---------- helpers ---------- */
    const $ = (sel) => document.querySelector(sel);
    const show = (el) => el?.classList.remove("hidden");
    const hide = (el) => el?.classList.add("hidden");

    function randomIndex(len) {
      return Math.floor(Math.random() * len);
    }

    function animateDie(dieEl, finalNumber, cb) {
      if (rolling) return;
      rolling = true;
      const face = dieEl.querySelector(".die-face");
      let ticks = 0;
      const total = 14;
      const iv = setInterval(() => {
        face.textContent = Math.floor(Math.random() * 6) + 1;
        dieEl.classList.add("rolling");
        ticks++;
        if (ticks >= total) {
          clearInterval(iv);
          face.textContent = finalNumber;
          dieEl.classList.remove("rolling");
          dieEl.classList.add("landed");
          setTimeout(() => dieEl.classList.remove("landed"), 400);
          rolling = false;
          cb?.();
        }
      }, 90);
    }

    /* ---------- mode switching ---------- */
    document.querySelectorAll(".mode-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const step = btn.dataset.step; // "cat" or "bet"
        const mode = btn.dataset.mode; // "roll" or "pick"

        // update active state on sibling buttons
        btn.parentElement.querySelectorAll(".mode-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");

        if (step === "cat") {
          catMode = mode;
          if (mode === "pick") {
            hide($("#catRollArea"));
            $("#catOverview").classList.add("pickable");
          } else {
            show($("#catRollArea"));
            $("#catOverview").classList.remove("pickable");
          }
        } else {
          betMode = mode;
          if (mode === "pick") {
            hide($("#betRollArea"));
            $("#betOverview").classList.add("pickable");
          } else {
            show($("#betRollArea"));
            $("#betOverview").classList.remove("pickable");
          }
        }
      });
    });

    /* ---------- render overview grids ---------- */
    function renderCatOverview() {
      const el = $("#catOverview");
      el.innerHTML = CATEGORIES.map((cat, i) =>
        `<div class="overview-card" data-idx="${i}">
          <span class="overview-num">${i + 1}</span>
          <span class="overview-title">${cat.name}</span>
          <span class="overview-tag">${cat.tag}</span>
        </div>`
      ).join("");

      // attach pick-click handlers
      el.querySelectorAll(".overview-card").forEach((card) => {
        card.addEventListener("click", () => {
          if (catMode !== "pick") return;
          const idx = parseInt(card.dataset.idx, 10);
          chosenCatIdx = idx;
          highlightOverviewItem("#catOverview", idx);
          $("#catName").textContent = CATEGORIES[idx].name + " — " + CATEGORIES[idx].tag;
          show($("#catResult"));
        });
      });
    }

    function renderBetOverview(catIdx) {
      const cat = CATEGORIES[catIdx];
      const el = $("#betOverview");
      el.innerHTML = cat.bets.map((b, i) =>
        `<div class="overview-item" data-idx="${i}">
          <span class="overview-num">${i + 1}</span>
          <span class="overview-title">${b.title}</span>
        </div>`
      ).join("");

      // attach pick-click handlers
      el.querySelectorAll(".overview-item").forEach((item) => {
        item.addEventListener("click", () => {
          if (betMode !== "pick") return;
          const idx = parseInt(item.dataset.idx, 10);
          chosenBetIdx = idx;
          const bet = cat.bets[idx];
          highlightOverviewItem("#betOverview", idx);
          $("#betText").textContent = bet.title;
          $("#betDesc").textContent = bet.desc;
          show($("#betResult"));
        });
      });
    }

    function highlightOverviewItem(container, idx) {
      const items = document.querySelectorAll(`${container} .overview-card, ${container} .overview-item`);
      items.forEach((el, i) => {
        el.classList.toggle("selected", i === idx);
      });
    }

    /* ---------- toggle panel ---------- */
    $("#diceToggle")?.addEventListener("click", () => {
      const panel = $("#dicePanel");
      const arrow = $(".toggle-arrow");
      panel.classList.toggle("hidden");
      arrow.textContent = panel.classList.contains("hidden") ? "\u25BE" : "\u25B4";
    });

    /* ---------- step 0: pick player ---------- */
    document.querySelectorAll(".player-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        chosenPlayer = btn.dataset.player;
        $("#playerLabel").textContent = chosenPlayer;
        hide($("#diceStep0"));
        show($("#diceStep1"));
        $("#dieCat .die-face").textContent = "?";
        hide($("#catResult"));
        renderCatOverview();
      });
    });

    /* ---------- step 1: roll for category ---------- */
    $("#rollCatBtn")?.addEventListener("click", () => {
      chosenCatIdx = randomIndex(CATEGORIES.length);
      const displayNum = chosenCatIdx + 1;
      animateDie($("#dieCat"), displayNum, () => {
        $("#catName").textContent = CATEGORIES[chosenCatIdx].name + " — " + CATEGORIES[chosenCatIdx].tag;
        highlightOverviewItem("#catOverview", chosenCatIdx);
        show($("#catResult"));
      });
    });

    $("#goToBetRoll")?.addEventListener("click", () => {
      hide($("#diceStep1"));
      show($("#diceStep2"));
      $("#catLabel2").textContent = CATEGORIES[chosenCatIdx].name;
      $("#dieBet .die-face").textContent = "?";
      hide($("#betResult"));
      renderBetOverview(chosenCatIdx);
      // reset bet mode to roll
      betMode = "roll";
      show($("#betRollArea"));
      $("#betOverview").classList.remove("pickable");
      const betBtns = $("#diceStep2").querySelectorAll(".mode-btn");
      betBtns.forEach(b => b.classList.toggle("active", b.dataset.mode === "roll"));
    });

    /* ---------- step 2: roll for bet ---------- */
    $("#backToCat")?.addEventListener("click", () => {
      hide($("#diceStep2"));
      show($("#diceStep1"));
    });

    $("#rollBetBtn")?.addEventListener("click", () => {
      const cat = CATEGORIES[chosenCatIdx];
      chosenBetIdx = randomIndex(cat.bets.length);
      const displayNum = chosenBetIdx + 1;
      animateDie($("#dieBet"), displayNum, () => {
        const bet = cat.bets[chosenBetIdx];
        $("#betText").textContent = bet.title;
        $("#betDesc").textContent = bet.desc;
        highlightOverviewItem("#betOverview", chosenBetIdx);
        show($("#betResult"));
      });
    });

    /* ---------- save ---------- */
    $("#saveDiceBet")?.addEventListener("click", async () => {
      const cat = CATEGORIES[chosenCatIdx];
      const bet = cat.bets[chosenBetIdx];
      const today = new Date().toISOString().slice(0, 10);
      const method = (catMode === "pick" || betMode === "pick") ? "Picked" : "Rolled";

      const form = new FormData();
      form.append("betDate", today);
      form.append("title", bet.title);
      form.append("stakes", cat.name);
      form.append("owner", chosenPlayer);
      form.append("status", "open");
      form.append("executedDate", "");
      form.append("notes", "\uD83C\uDFB2 " + method + " via Dice & Dares — " + bet.desc);

      $("#saveDiceBet").disabled = true;
      $("#saveDiceBet").textContent = "Saving…";

      try {
        const res = await fetch("/.netlify/functions/add-bet", {
          method: "POST",
          body: form,
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data?.error || "Failed");
        location.reload();
      } catch (err) {
        alert("Could not save the dice bet.");
        console.error(err);
        $("#saveDiceBet").disabled = false;
        $("#saveDiceBet").textContent = "\uD83C\uDFB2 Save to bets";
      }
    });

    /* ---------- start over ---------- */
    $("#startOver")?.addEventListener("click", () => {
      hide($("#diceStep1"));
      hide($("#diceStep2"));
      show($("#diceStep0"));
      chosenPlayer = "";
      chosenCatIdx = -1;
      chosenBetIdx = -1;
      catMode = "roll";
      betMode = "roll";
    });
  </script>
</BaseLayout>

