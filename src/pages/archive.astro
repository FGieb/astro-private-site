---
import daily from "../data/daily.json";

const cookie = Astro.cookies.get("auth");
if (!cookie || cookie.value !== "1") {
  return Astro.redirect("/login");
}

const entries = Object.entries(daily)
  .sort(([a],[b]) => b.localeCompare(a));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Archive</title>

  <style>
    body {
      margin: 0;
      font-family: system-ui, sans-serif;
      min-height: 100vh;
      color: white;
      background:
        linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.75)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 1.25rem;
    }

    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(0,0,0,0.55);
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      backdrop-filter: blur(6px);
    }

    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.85;
    }

    .nav-pill a:hover { opacity: 1; }

    .wrapper {
      max-width: 760px;
      margin: 3rem auto;
      padding: 0 1.25rem 4rem;
    }

    h1 {
      text-align: center;
      margin-bottom: 2rem;
    }

    .entry {
      background: rgba(255,255,255,0.9);
      color: #111;
      border-radius: 1.2rem;
      padding: 1.4rem 1.6rem;
      margin-bottom: 1.6rem;
      box-shadow: 0 10px 28px rgba(0,0,0,0.25);
    }

    .date {
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      opacity: 0.6;
      margin-bottom: 0.6rem;
    }

    .reflection {
      font-size: 1.05rem;
      line-height: 1.5;
      margin-bottom: 0.6rem;
    }

    .fun {
      font-size: 0.9rem;
      opacity: 0.7;
    }

    .comments {
      margin-top: 0.8rem;
      font-size: 0.85rem;
      opacity: 0.85;
    }

    .comments-title {
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      opacity: 0.6;
      margin-bottom: 0.35rem;
    }

    .comment-line {
      margin-top: 0.25rem;
    }

    .empty {
      text-align: center;
      opacity: 0.7;
      margin-top: 4rem;
    }
  </style>
</head>

<body>
  <div class="top-nav">
    <div class="nav-pill">
      <a href="/calendar">📅 Calendar</a>
      <a href="/home">🏠 Home</a>
      <a href="/notes">📝 Notes</a>
      <a href="/archive">🗂 Archive</a>
    </div>
  </div>

  <main class="wrapper">
    <h1>Archive</h1>

    {entries.length === 0 ? (
      <div class="empty">No entries yet.</div>
    ) : (
      entries.map(([date, entry]) => (
        <div class="entry" data-date={date}>
          <div class="date">{date}</div>

          {/* These are the important parts you said must not disappear */}
          <div class="reflection">{entry.reflective?.text}</div>
          <div class="fun">{entry.fun?.text}</div>

          {/* Comments block: rendered from daily.json if present, then upgraded by JS */}
          <div class="comments" data-comments-for={date} style={entry.comments?.length ? "" : "display:none;"}>
            <div class="comments-title">Thoughts</div>
            {entry.comments?.map(c => (
              <div class="comment-line">– {c.text}</div>
            ))}
          </div>
        </div>
      ))
    )}
  </main>

  <script type="module" is:inline>
    function renderComments(container, comments) {
      if (!container) return;

      if (!comments || comments.length === 0) {
        container.style.display = "none";
        container.innerHTML = "";
        return;
      }

      container.style.display = "";
      container.innerHTML =
        `<div class="comments-title">Thoughts</div>` +
        comments.map(c => `<div class="comment-line">– ${c.text}</div>`).join("");
    }

    async function upgradeCommentsFromServer() {
      let serverDaily = {};
      try {
        const res = await fetch("/.netlify/functions/daily-load");
        serverDaily = await res.json();
      } catch (err) {
        console.warn("daily-load failed; keeping archive as-is.", err);
        return;
      }

      // For each date we already rendered, replace comments if server has them
      for (const [date, entry] of Object.entries(serverDaily || {})) {
        const block = document.querySelector(`[data-comments-for="${date}"]`);
        if (!block) continue;

        const comments = entry?.comments || [];
        renderComments(block, comments);
      }
    }

    upgradeCommentsFromServer();
  </script>
</body>
</html>
