---
import { isValidSession } from "../lib/auth";
import daily from "../data/daily.json";

const cookie = Astro.cookies.get("auth");

if (!(await isValidSession(cookie?.value))) {
  return Astro.redirect("/login");
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Archive</title>

  <style is:global>
    body {
      margin: 0;
      font-family: system-ui, sans-serif;
      min-height: 100vh;
      color: white;
      background:
        linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.75)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 1.25rem;
    }

    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(0,0,0,0.55);
      padding: 0.6rem 1.4rem;
      border-radius: 999px;
      backdrop-filter: blur(6px);
    }

    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.85;
    }

    .wrapper {
      max-width: 760px;
      margin: 3rem auto;
      padding: 0 1.25rem 4rem;
    }

    h1 {
      text-align: center;
      margin-bottom: 2rem;
    }

    .entry {
      background: rgba(255,255,255,0.9);
      color: #111;
      border-radius: 1.2rem;
      padding: 1.4rem 1.6rem;
      margin-bottom: 1.6rem;
      box-shadow: 0 10px 28px rgba(0,0,0,0.25);
    }

    .date {
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      opacity: 0.6;
      margin-bottom: 0.6rem;
    }

    .reflection {
      font-size: 1.05rem;
      line-height: 1.5;
      margin-bottom: 0.5rem;
    }

    .comments {
      margin: 0.6rem 0 0.9rem;
      padding: 0.8rem 1rem;
      border-left: 4px solid #0a74c9;
      background: linear-gradient(
        to right,
        rgba(10, 116, 201, 0.08),
        rgba(10, 116, 201, 0.02)
      );
      border-radius: 0.6rem;
      font-size: 0.9rem;
    }

    .comments-title {
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #0a74c9;
      font-weight: 700;
      margin-bottom: 0.35rem;
    }

    .comment-line {
      margin-top: 0.3rem;
    }

    .fun {
      font-size: 0.9rem;
      opacity: 0.7;
      margin-top: 0.4rem;
    }

    .loading {
      text-align: center;
      opacity: 0.6;
      padding: 2rem 0;
    }
  </style>
</head>

<body>
  <div class="top-nav">
    <div class="nav-pill">
      <a href="/calendar">📅 Calendar</a>
      <a href="/home">🏠 Home</a>
      <a href="/notes">📝 Notes</a>
      <a href="/archive">🗂 Archive</a>
    </div>
  </div>

  <main class="wrapper">
    <h1>Archive</h1>
    <div id="archiveEntries"><div class="loading">Loading...</div></div>
  </main>

  <script type="module" is:inline define:vars={{ staticDaily: daily }}>
    function escapeHtml(str) {
      return String(str)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    async function loadAndRender() {
      // Start with static daily.json as the base (entries up to last deploy)
      const merged = {};
      for (const [date, entry] of Object.entries(staticDaily)) {
        merged[date] = { ...entry, newThoughts: [] };
      }

      // Overlay with live blob store data (newer entries + old comments)
      try {
        const res = await fetch("/.netlify/functions/daily-load");
        if (res.ok) {
          const blobData = await res.json();
          for (const [date, entry] of Object.entries(blobData)) {
            if (!merged[date]) merged[date] = { comments: [], newThoughts: [] };
            if (!merged[date].newThoughts) merged[date].newThoughts = [];
            if (entry.reflective?.text) merged[date].reflective = entry.reflective;
            if (entry.fun?.text) merged[date].fun = entry.fun;
            if (Array.isArray(entry.comments)) merged[date].comments = entry.comments;
            if (entry.generatedAt) merged[date].generatedAt = entry.generatedAt;
          }
        }
      } catch {}

      // Add new thoughts from content.mjs (the new thoughts bucket)
      try {
        const res = await fetch("/.netlify/functions/content", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ type: "thoughts", action: "list" }),
        });
        if (res.ok) {
          const data = await res.json();
          const thoughts = Array.isArray(data?.entries) ? data.entries : [];
          for (const thought of thoughts) {
            const date = thought.date;
            if (!date) continue;
            if (!merged[date]) merged[date] = { comments: [], newThoughts: [] };
            if (!merged[date].newThoughts) merged[date].newThoughts = [];
            merged[date].newThoughts.push(thought);
          }
        }
      } catch {}

      // Sort descending and render
      const sorted = Object.entries(merged).sort(([a], [b]) => b.localeCompare(a));

      const html = sorted.map(([date, entry]) => {
        const reflection = entry.reflective?.text || "";
        const fun = entry.fun?.text || "";

        // Old-style comments (from daily blob store)
        const oldComments = (entry.comments || [])
          .map(c => (typeof c === "string" ? c : c.text) || "")
          .filter(Boolean);

        // New thoughts (from content.mjs thoughts bucket)
        const newThoughts = (entry.newThoughts || [])
          .sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt))
          .map(t => t.text || "")
          .filter(Boolean);

        const allThoughts = [...oldComments, ...newThoughts];

        if (!reflection && !fun && !allThoughts.length) return "";

        const thoughtsHtml = allThoughts.length
          ? `<div class="comments">
              <div class="comments-title">Thoughts</div>
              ${allThoughts.map(t => `<div class="comment-line">– ${escapeHtml(t)}</div>`).join("")}
            </div>`
          : "";

        return `
          <div class="entry">
            <div class="date">${escapeHtml(date)}</div>
            ${reflection ? `<div class="reflection">${escapeHtml(reflection)}</div>` : ""}
            ${thoughtsHtml}
            ${fun ? `<div class="fun">${escapeHtml(fun)}</div>` : ""}
          </div>`;
      }).filter(Boolean).join("");

      document.getElementById("archiveEntries").innerHTML =
        html || '<div class="loading">No entries yet.</div>';
    }

    loadAndRender();
  </script>
</body>
</html>
