---
export const prerender = false;
export const runtime = "nodejs";

import { isValidSession } from "../lib/auth";

const cookie = Astro.cookies.get("auth");

if (!(await isValidSession(cookie?.value))) {
  return Astro.redirect("/login");
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Scrapbook</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <style is:global>
    :root {
      --glass-dark: rgba(10, 16, 28, 0.52);
      --glass-mid: rgba(12, 20, 36, 0.44);
      --glass-light: rgba(255, 255, 255, 0.87);
      --text-dark: #121212;
      --text-light: #ffffff;
      --muted-light: rgba(255,255,255,0.72);
      --accent-blue: #0a74c9;
      --accent-blue-soft: rgba(10, 116, 201, 0.14);
      --accent-blue-border: rgba(10, 116, 201, 0.28);
      --shadow: 0 18px 40px rgba(0,0,0,0.18);
      --radius-xl: 1.6rem;
      --radius-lg: 1.15rem;
    }

    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--text-light);
      min-height: 100vh;
      background-color: #2a2f38;
      background-image:
        linear-gradient(rgba(18, 24, 36, 0.52), rgba(18, 24, 36, 0.60)),
        linear-gradient(rgba(10, 116, 201, 0.10), rgba(10, 116, 201, 0.08)),
        url("/images/homebackground.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }

    .page {
      max-width: 920px;
      margin: 0 auto;
      padding: 1.25rem 1.25rem 3rem;
    }

    /* ── Nav ── */
    .top-nav {
      display: flex;
      justify-content: center;
      margin-top: 0.25rem;
      margin-bottom: 2rem;
      position: relative;
      z-index: 1000;
    }

    .nav-pill {
      display: flex;
      gap: 1.2rem;
      background: rgba(14, 18, 26, 0.68);
      padding: 0.78rem 1.5rem;
      border-radius: 999px;
      backdrop-filter: blur(10px);
      box-shadow: 0 10px 24px rgba(0,0,0,0.14);
      flex-wrap: wrap;
      border: 1px solid #1f1f1f;
    }

    .nav-pill a {
      color: white;
      text-decoration: none;
      opacity: 0.92;
      font-size: 1.02rem;
    }

    .nav-pill a:hover { opacity: 1; color: var(--accent-blue); }

    .nav-group { position: relative; }
    .nav-group-label { cursor: pointer; opacity: 0.92; user-select: none; font-size: 1.02rem; }
    .nav-group-label:hover { opacity: 1; }
    .nav-group-menu { display: none; position: absolute; top: calc(100% + 0.6rem); left: 50%; transform: translateX(-50%); background: rgba(14,18,26,0.97); border: 1px solid rgba(255,255,255,0.1); border-radius: 0.75rem; padding: 0.35rem; min-width: 130px; flex-direction: column; gap: 0.1rem; z-index: 100; backdrop-filter: blur(10px); }
    .nav-group:hover .nav-group-menu { display: flex; }
    .nav-group-menu a { display: block; padding: 0.4rem 0.75rem; border-radius: 0.5rem; white-space: nowrap; opacity: 0.85; }
    .nav-group-menu a:hover { background: rgba(255,255,255,0.08); opacity: 1; }

    /* ── Page header ── */
    .overview-header {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .overview-header h1 {
      margin: 0 0 0.25rem;
      font-size: 1.85rem;
      font-weight: 700;
    }

    .overview-header .subtitle {
      margin: 0;
      color: var(--muted-light);
      font-size: 0.95rem;
    }

    /* ── Category tabs ── */
    .cat-tabs {
      display: flex;
      justify-content: center;
      gap: 0.4rem;
      margin-bottom: 1.4rem;
    }

    .cat-tab {
      padding: 0.45rem 1.05rem;
      border-radius: 999px;
      border: 1.5px solid rgba(255,255,255,0.25);
      background: rgba(255,255,255,0.14);
      color: rgba(255,255,255,0.85);
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      backdrop-filter: blur(4px);
    }

    .cat-tab:hover {
      border-color: var(--accent-blue);
      color: var(--accent-blue);
      background: rgba(10, 116, 201, 0.12);
    }

    .cat-tab.active {
      background: var(--accent-blue);
      border-color: var(--accent-blue);
      color: white;
    }

    /* ── Search bar ── */
    .search-bar {
      margin-bottom: 1rem;
    }

    .search-bar input {
      width: 100%;
      padding: 0.5rem 1rem 0.5rem 2.2rem;
      border-radius: 999px;
      border: 1.5px solid rgba(255,255,255,0.18);
      background: rgba(255,255,255,0.10);
      color: white;
      font-family: inherit;
      font-size: 0.88rem;
      backdrop-filter: blur(6px);
      transition: border-color 0.15s, background 0.15s;
    }

    .search-bar input::placeholder { color: rgba(255,255,255,0.45); }

    .search-bar input:focus {
      outline: none;
      border-color: var(--accent-blue);
      background: rgba(255,255,255,0.14);
    }

    .search-wrap {
      position: relative;
    }

    .search-wrap::before {
      content: "🔍";
      position: absolute;
      left: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.82rem;
      pointer-events: none;
    }

    /* ── Add form — dark glass card ── */
    .add-card {
      background: var(--glass-mid);
      color: white;
      border-radius: var(--radius-lg);
      padding: 1rem 1.2rem;
      box-shadow: 0 8px 24px rgba(0,0,0,0.14);
      margin-bottom: 1.2rem;
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .add-card h2 {
      margin: 0 0 0.7rem;
      font-size: 0.95rem;
      font-weight: 700;
      color: white;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.55rem;
    }

    .form-grid .full { grid-column: 1 / -1; }

    .form-field label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.55);
      margin-bottom: 0.2rem;
    }

    .form-field input,
    .form-field textarea,
    .form-field select {
      width: 100%;
      padding: 0.42rem 0.65rem;
      border-radius: 0.5rem;
      border: 1px solid rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.08);
      color: white;
      font-family: inherit;
      font-size: 0.88rem;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .form-field input::placeholder,
    .form-field textarea::placeholder {
      color: rgba(255,255,255,0.35);
    }

    .form-field textarea {
      min-height: 48px;
      resize: vertical;
    }

    .form-field input:focus,
    .form-field textarea:focus,
    .form-field select:focus {
      outline: none;
      border-color: var(--accent-blue);
      box-shadow: 0 0 0 2px var(--accent-blue-soft);
      background: rgba(255,255,255,0.12);
    }

    .form-field select option {
      background: #1a1e28;
      color: white;
    }

    .form-field input[type="date"] {
      cursor: pointer;
      color-scheme: dark;
    }

    /* ── Star rating ── */
    .star-input {
      display: flex;
      gap: 0.15rem;
      padding-top: 0.1rem;
    }

    .star-input span {
      font-size: 1.2rem;
      cursor: pointer;
      color: rgba(255,255,255,0.2);
      transition: color 0.1s;
      user-select: none;
    }

    .star-input span.filled { color: #f59e0b; }
    .star-input span:hover { color: #fbbf24; }

    .form-actions {
      display: flex;
      gap: 0.6rem;
      margin-top: 0.65rem;
    }

    .btn-add {
      padding: 0.45rem 1.2rem;
      border-radius: 999px;
      border: none;
      background: var(--accent-blue);
      color: white;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.88rem;
      transition: opacity 0.15s;
    }

    .btn-add:hover { opacity: 0.88; }
    .btn-add:disabled { opacity: 0.4; cursor: not-allowed; }

    /* ── Edit modal ── */
    .edit-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.62);
      z-index: 2000;
      overflow-y: auto;
      backdrop-filter: blur(4px);
    }
 
    .edit-modal-box {
      background: rgba(12, 18, 32, 0.97);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 1.15rem;
      padding: 1.5rem;
      max-width: 540px;
      margin: 3rem auto;
      box-shadow: 0 20px 50px rgba(0,0,0,0.45);
    }
 
    .edit-modal-box h2 {
      margin: 0 0 1rem;
      font-size: 0.95rem;
      font-weight: 700;
      color: white;
    }
 
    .btn-cancel {
      padding: 0.45rem 1.2rem;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.22);
      background: transparent;
      color: rgba(255,255,255,0.72);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.88rem;
      transition: opacity 0.15s;
    }
 
    .btn-cancel:hover { opacity: 0.8; }
 
    /* ── Entry cards grid ── */
    .entries-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
      gap: 0.8rem;
    }

    .entry-card {
      background: rgba(230, 235, 245, 0.88);
      color: var(--text-dark);
      border-radius: 0.9rem;
      padding: 0.85rem 1rem;
      box-shadow: 0 4px 14px rgba(0,0,0,0.10);
      position: relative;
      transition: transform 0.12s, box-shadow 0.12s;
      border: 1px solid rgba(255,255,255,0.3);
      backdrop-filter: blur(8px);
    }

    .entry-card:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 22px rgba(0,0,0,0.14);
    }

    .entry-name {
      font-size: 0.95rem;
      font-weight: 700;
      margin: 0 0 0.25rem;
      color: #1a1a2e;
      padding-right: 2rem;
    }

    .entry-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 0.75rem;
      font-size: 0.82rem;
      color: #555;
      margin-bottom: 0.4rem;
    }

    .entry-meta span {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .entry-stars {
      color: #f59e0b;
      font-size: 0.88rem;
      letter-spacing: 0.05em;
    }

    .entry-notes {
      font-size: 0.85rem;
      color: #666;
      line-height: 1.45;
      margin-top: 0.3rem;
      border-top: 1px solid rgba(0,0,0,0.06);
      padding-top: 0.35rem;
    }

    .entry-badge {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      margin-bottom: 0.4rem;
    }

    .badge-restaurant { background: rgba(239, 68, 68, 0.12); color: #dc2626; }
    .badge-trip { background: rgba(34, 197, 94, 0.12); color: #16a34a; }
    .badge-media { background: rgba(139, 92, 246, 0.12); color: #7c3aed; }

    .entry-actions {
      position: absolute;
      top: 0.7rem;
      right: 0.7rem;
      display: flex;
      gap: 0.25rem;
    }

    .entry-actions button {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 0.88rem;
      padding: 0.15rem 0.3rem;
      border-radius: 0.4rem;
      opacity: 0.35;
      transition: opacity 0.15s;
      margin: 0;
      color: var(--text-dark);
    }

    .entry-actions button:hover { opacity: 1; }

    .empty-state {
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--muted-light);
      font-size: 0.95rem;
      grid-column: 1 / -1;
    }

    .empty-state .empty-icon {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    /* ── Timeline view ── */
    .timeline {
      display: none;
      position: relative;
      padding-left: 2rem;
    }

    .timeline.visible { display: block; }

    .timeline::before {
      content: "";
      position: absolute;
      left: 0.55rem;
      top: 0;
      bottom: 0;
      width: 2.5px;
      background: linear-gradient(to bottom, var(--accent-blue), rgba(10,116,201,0.2));
      border-radius: 999px;
    }

    .timeline-item {
      position: relative;
      margin-bottom: 1rem;
      padding-left: 0.8rem;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      left: -1.72rem;
      top: 0.85rem;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 2.5px solid var(--accent-blue);
      background: white;
    }

    .timeline-item.cat-restaurant::before { border-color: #dc2626; }
    .timeline-item.cat-trip::before { border-color: #16a34a; }
    .timeline-item.cat-media::before { border-color: #7c3aed; }

    .timeline-card {
      background: rgba(230, 235, 245, 0.88);
      color: var(--text-dark);
      border-radius: 0.85rem;
      padding: 0.75rem 1rem;
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
      border: 1px solid rgba(255,255,255,0.3);
      backdrop-filter: blur(8px);
    }

    .timeline-date {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--accent-blue);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.3rem;
    }

    .timeline-title {
      font-size: 1rem;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: 0.2rem;
    }

    .timeline-detail {
      font-size: 0.82rem;
      color: #666;
      line-height: 1.45;
    }

    .timeline-month-header {
      font-size: 0.85rem;
      font-weight: 700;
      color: white;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.6rem;
      margin-top: 0.4rem;
      padding-left: 0.8rem;
      position: relative;
    }

    .timeline-month-header::before {
      content: "";
      position: absolute;
      left: -1.72rem;
      top: 50%;
      transform: translateY(-50%);
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--accent-blue);
    }

    @media (max-width: 600px) {
      .form-grid { grid-template-columns: 1fr; }
      .entries-grid { grid-template-columns: 1fr; }
      .cat-tabs { flex-wrap: wrap; justify-content: center; }
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="top-nav">
      <div class="nav-pill">
        <a href="/calendar">📅 Calendar</a>
        <div class="nav-group">
          <span class="nav-group-label">🎮 Games ▾</span>
          <div class="nav-group-menu">
            <a href="/bets">🎲 Bets</a>
            <a href="/scores">🏆 Scores</a>
            <a href="/poker">🃏 Poker</a>
          </div>
        </div>
        <a href="/overview">🍷 Scrapbook</a>
        <a href="/home">🏠 Home</a>
        <a href="/notes">📝 Notes</a>
        <a href="/archive">🗂 Archive</a>
      </div>
    </div>

    <header class="overview-header">
      <h1>🍷 Scrapbook</h1>
      <p class="subtitle">Restaurants, trips, and things we watched.</p>
    </header>

    <div class="cat-tabs">
      <button class="cat-tab active" data-cat="restaurant">🍽 Restaurants</button>
      <button class="cat-tab" data-cat="trip">✈️ Trips</button>
      <button class="cat-tab" data-cat="media">🎬 Movies & Series</button>
      <button class="cat-tab" data-cat="timeline">📅 Timeline</button>
    </div>

    <!-- ── Search ── -->
    <div class="search-bar" id="searchBar">
      <div class="search-wrap">
        <input type="text" id="searchInput" placeholder="Search by name, location, notes..." />
      </div>
    </div>

    <!-- ── Add form ── -->
    <section class="add-card" id="addCard">
      <h2 id="formTitle">🍽 Add a restaurant</h2>

      <!-- Restaurant fields -->
      <div id="formRestaurant" class="form-grid">
        <div class="form-field">
          <label>Name</label>
          <input type="text" id="rName" placeholder="e.g. Le Petit Chou" />
        </div>
        <div class="form-field">
          <label>Location</label>
          <input type="text" id="rLocation" placeholder="e.g. Brussels" />
        </div>
        <div class="form-field">
          <label>Cuisine</label>
          <input type="text" id="rCuisine" placeholder="e.g. French, Italian..." />
        </div>
        <div class="form-field">
          <label>Date visited</label>
          <input type="date" id="rDate" />
        </div>
        <div class="form-field">
          <label>Rating</label>
          <div class="star-input" id="rStars">
            <span data-v="1">★</span><span data-v="2">★</span><span data-v="3">★</span><span data-v="4">★</span><span data-v="5">★</span>
          </div>
        </div>
        <div class="form-field full">
          <label>Notes</label>
          <textarea id="rNotes" placeholder="What did you think?"></textarea>
        </div>
      </div>

      <!-- Trip fields -->
      <div id="formTrip" class="form-grid" style="display:none">
        <div class="form-field full">
          <label>Destination</label>
          <input type="text" id="tDest" placeholder="e.g. Lisbon, Portugal" />
        </div>
        <div class="form-field">
          <label>From</label>
          <input type="date" id="tFrom" />
        </div>
        <div class="form-field">
          <label>To</label>
          <input type="date" id="tTo" />
        </div>
        <div class="form-field full">
          <label>Highlights</label>
          <input type="text" id="tHighlights" placeholder="e.g. Beach, old town, pasteis de nata..." />
        </div>
        <div class="form-field full">
          <label>Notes</label>
          <textarea id="tNotes" placeholder="How was it?"></textarea>
        </div>
      </div>

      <!-- Media fields -->
      <div id="formMedia" class="form-grid" style="display:none">
        <div class="form-field">
          <label>Title</label>
          <input type="text" id="mTitle" placeholder="e.g. Succession" />
        </div>
        <div class="form-field">
          <label>Type</label>
          <select id="mType">
            <option value="movie">Movie</option>
            <option value="series">Series</option>
          </select>
        </div>
        <div class="form-field">
          <label>Date watched</label>
          <input type="date" id="mDate" />
        </div>
        <div class="form-field">
          <label>Rating</label>
          <div class="star-input" id="mStars">
            <span data-v="1">★</span><span data-v="2">★</span><span data-v="3">★</span><span data-v="4">★</span><span data-v="5">★</span>
          </div>
        </div>
        <div class="form-field full">
          <label>Notes</label>
          <textarea id="mNotes" placeholder="Worth rewatching?"></textarea>
        </div>
      </div>

      <div class="form-actions">
        <button class="btn-add" id="btnAdd">Add</button>
      </div>
    </section>

    <!-- ── Entries (card grid) ── -->
    <div class="entries-grid" id="entriesGrid">
      <div class="empty-state">
        <div class="empty-icon">🍽</div>
        Loading...
      </div>
    </div>

    <!-- ── Timeline view ── -->
    <div class="timeline" id="timelineView"></div>
  </div>

  <!-- ── Edit modal ── -->
  <div class="edit-modal-overlay" id="editModal">
    <div class="edit-modal-box">
      <h2 id="editModalTitle">Edit entry</h2>
 
      <!-- Restaurant fields -->
      <div id="editFormRestaurant" class="form-grid" style="display:none">
        <div class="form-field">
          <label>Name</label>
          <input type="text" id="eName" />
        </div>
        <div class="form-field">
          <label>Location</label>
          <input type="text" id="eLocation" />
        </div>
        <div class="form-field">
          <label>Cuisine</label>
          <input type="text" id="eCuisine" />
        </div>
        <div class="form-field">
          <label>Date visited</label>
          <input type="date" id="eRDate" />
        </div>
        <div class="form-field">
          <label>Rating</label>
          <div class="star-input" id="eRStars">
            <span data-v="1">★</span><span data-v="2">★</span><span data-v="3">★</span><span data-v="4">★</span><span data-v="5">★</span>
          </div>
        </div>
        <div class="form-field full">
          <label>Notes</label>
          <textarea id="eRNotes"></textarea>
        </div>
      </div>
 
      <!-- Trip fields -->
      <div id="editFormTrip" class="form-grid" style="display:none">
        <div class="form-field full">
          <label>Destination</label>
          <input type="text" id="eDest" />
        </div>
        <div class="form-field">
          <label>From</label>
          <input type="date" id="eDateFrom" />
        </div>
        <div class="form-field">
          <label>To</label>
          <input type="date" id="eDateTo" />
        </div>
        <div class="form-field full">
          <label>Highlights</label>
          <input type="text" id="eHighlights" />
        </div>
        <div class="form-field full">
          <label>Notes</label>
          <textarea id="eTNotes"></textarea>
        </div>
      </div>
 
      <!-- Media fields -->
      <div id="editFormMedia" class="form-grid" style="display:none">
        <div class="form-field">
          <label>Title</label>
          <input type="text" id="eTitle" />
        </div>
        <div class="form-field">
          <label>Type</label>
          <select id="eType">
            <option value="movie">Movie</option>
            <option value="series">Series</option>
          </select>
        </div>
        <div class="form-field">
          <label>Date watched</label>
          <input type="date" id="eDateWatched" />
        </div>
        <div class="form-field">
          <label>Rating</label>
          <div class="star-input" id="eMStars">
            <span data-v="1">★</span><span data-v="2">★</span><span data-v="3">★</span><span data-v="4">★</span><span data-v="5">★</span>
          </div>
        </div>
        <div class="form-field full">
          <label>Notes</label>
          <textarea id="eMNotes"></textarea>
        </div>
      </div>
 
      <div class="form-actions" style="margin-top:1rem">
        <button class="btn-add" id="btnEditSave">Save</button>
        <button class="btn-cancel" id="btnEditCancel">Cancel</button>
      </div>
    </div>
  </div>
 
  <script type="module" is:inline>
    let currentCat = "restaurant";
    let allEntries = [];
    let starRatings = { rStars: 0, mStars: 0 };
    let editStarRatings = { eRStars: 0, eMStars: 0 };
    let currentEditEntry = null;
    let searchQuery = "";

    // ── Search ──
    document.getElementById("searchInput").addEventListener("input", (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      if (currentCat === "timeline") {
        renderTimeline();
      } else {
        renderEntries();
      }
    });

    // ── Star inputs ──
    document.querySelectorAll(".star-input").forEach((container) => {
      const key = container.id;
      container.querySelectorAll("span").forEach((star) => {
        star.addEventListener("click", () => {
          const v = parseInt(star.dataset.v);
          starRatings[key] = starRatings[key] === v ? 0 : v;
          updateStars(container, starRatings[key]);
        });
        star.addEventListener("mouseenter", () => {
          updateStars(container, parseInt(star.dataset.v));
        });
        star.addEventListener("mouseleave", () => {
          updateStars(container, starRatings[key]);
        });
      });
    });

    function updateStars(container, value) {
      container.querySelectorAll("span").forEach((s) => {
        s.classList.toggle("filled", parseInt(s.dataset.v) <= value);
      });
    }

    // ── Edit modal star inputs ──
    document.querySelectorAll("#editModal .star-input").forEach((container) => {
      const key = container.id;
      container.querySelectorAll("span").forEach((star) => {
        star.addEventListener("click", () => {
          const v = parseInt(star.dataset.v);
          editStarRatings[key] = editStarRatings[key] === v ? 0 : v;
          updateStars(container, editStarRatings[key]);
        });
        star.addEventListener("mouseenter", () => {
          updateStars(container, parseInt(star.dataset.v));
        });
        star.addEventListener("mouseleave", () => {
          updateStars(container, editStarRatings[key]);
        });
      });
    });
 
    // ── Category tabs ──
    document.querySelectorAll(".cat-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        currentCat = tab.dataset.cat;
        document.querySelectorAll(".cat-tab").forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        switchView();
      });
    });

    function switchView() {
      const isTimeline = currentCat === "timeline";
      document.getElementById("addCard").style.display = isTimeline ? "none" : "";
      document.getElementById("entriesGrid").style.display = isTimeline ? "none" : "";
      document.getElementById("timelineView").classList.toggle("visible", isTimeline);

      if (isTimeline) {
        renderTimeline();
      } else {
        switchForm();
        renderEntries();
      }
    }

    function switchForm() {
      const titles = {
        restaurant: "🍽 Add a restaurant",
        trip: "✈️ Add a trip",
        media: "🎬 Add a movie or series",
      };
      document.getElementById("formTitle").textContent = titles[currentCat];
      document.getElementById("formRestaurant").style.display = currentCat === "restaurant" ? "" : "none";
      document.getElementById("formTrip").style.display = currentCat === "trip" ? "" : "none";
      document.getElementById("formMedia").style.display = currentCat === "media" ? "" : "none";
    }

    // ── API ──
    async function callContent(body) {
      const res = await fetch("/.netlify/functions/content", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.error || "Request failed");
      return data;
    }

    function escapeHtml(str) {
      return String(str)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function starsHtml(rating) {
      if (!rating) return "";
      return '<span class="entry-stars">' + "★".repeat(rating) + "☆".repeat(5 - rating) + "</span>";
    }

    function formatDate(d) {
      if (!d) return "";
      try {
        return new Date(d + "T00:00:00").toLocaleDateString("en-GB", {
          day: "numeric", month: "short", year: "numeric",
        });
      } catch { return d; }
    }

    function getEntryDate(e) {
      return e.date || e.dateFrom || e.dateWatched || e.createdAt?.slice(0, 10) || "";
    }

    function getEntryName(e) {
      return e.name || e.destination || e.title || "Untitled";
    }

    function getCatIcon(cat) {
      return { restaurant: "🍽", trip: "✈️", media: "🎬" }[cat] || "";
    }

    // ── Render cards ──
    function matchesSearch(e) {
      if (!searchQuery) return true;
      const fields = [
        e.name, e.destination, e.title, e.location, e.cuisine,
        e.highlights, e.notes, e.mediaType,
      ];
      return fields.some((f) => f && f.toLowerCase().includes(searchQuery));
    }

    function renderEntries() {
      const grid = document.getElementById("entriesGrid");
      const filtered = allEntries.filter((e) => e.category === currentCat && matchesSearch(e));

      if (!filtered.length) {
        const icons = { restaurant: "🍽", trip: "✈️", media: "🎬" };
        const msgs = {
          restaurant: "No restaurants yet — time to eat out!",
          trip: "No trips yet — where to next?",
          media: "Nothing watched yet — movie night?",
        };
        grid.innerHTML = `<div class="empty-state"><div class="empty-icon">${icons[currentCat]}</div>${msgs[currentCat]}</div>`;
        return;
      }

      grid.innerHTML = filtered.map((e) => {
        const badge = currentCat === "restaurant"
          ? '<span class="entry-badge badge-restaurant">Restaurant</span>'
          : currentCat === "trip"
          ? '<span class="entry-badge badge-trip">Trip</span>'
          : `<span class="entry-badge badge-media">${escapeHtml(e.mediaType === "series" ? "Series" : "Movie")}</span>`;

        let meta = "";
        if (currentCat === "restaurant") {
          const parts = [];
          if (e.location) parts.push(`<span>📍 ${escapeHtml(e.location)}</span>`);
          if (e.cuisine) parts.push(`<span>🍴 ${escapeHtml(e.cuisine)}</span>`);
          if (e.date) parts.push(`<span>📅 ${escapeHtml(formatDate(e.date))}</span>`);
          meta = parts.join("");
        } else if (currentCat === "trip") {
          const parts = [];
          if (e.dateFrom && e.dateTo) {
            parts.push(`<span>📅 ${escapeHtml(formatDate(e.dateFrom))} → ${escapeHtml(formatDate(e.dateTo))}</span>`);
          } else if (e.dateFrom) {
            parts.push(`<span>📅 ${escapeHtml(formatDate(e.dateFrom))}</span>`);
          }
          if (e.highlights) parts.push(`<span>✨ ${escapeHtml(e.highlights)}</span>`);
          meta = parts.join("");
        } else {
          const parts = [];
          if (e.dateWatched) parts.push(`<span>📅 ${escapeHtml(formatDate(e.dateWatched))}</span>`);
          meta = parts.join("");
        }

        const name = getEntryName(e);

        return `
          <div class="entry-card" data-id="${e.id}">
            <div class="entry-actions">
              <button class="btn-edit" data-id="${e.id}" title="Edit">✏️</button>
              <button class="btn-del" data-id="${e.id}" title="Delete">🗑</button>
            </div>
            ${badge}
            <div class="entry-name">${escapeHtml(name)}</div>
            ${e.rating ? starsHtml(e.rating) : ""}
            <div class="entry-meta">${meta}</div>
            ${e.notes ? `<div class="entry-notes">${escapeHtml(e.notes)}</div>` : ""}
          </div>
        `;
      }).join("");

      // Bind delete buttons
      grid.querySelectorAll(".btn-del").forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (!confirm("Delete this entry?")) return;
          try {
            await callContent({ type: "tracker", action: "delete", id: btn.dataset.id });
            await loadEntries();
          } catch (err) {
            alert("Could not delete: " + err.message);
          }
        });
      });

      // Bind edit buttons
      grid.querySelectorAll(".btn-edit").forEach((btn) => {
        btn.addEventListener("click", () => {
          const entry = allEntries.find((e) => e.id === btn.dataset.id);
          if (!entry) return;
          openEdit(entry);
        });
      });
    }

    // ── Timeline ──
    function renderTimeline() {
      const container = document.getElementById("timelineView");
      const sorted = [...allEntries].filter(matchesSearch).sort((a, b) => {
        const da = getEntryDate(a);
        const db = getEntryDate(b);
        return db.localeCompare(da);
      });

      if (!sorted.length) {
        container.innerHTML = '<div class="empty-state" style="padding-left:0"><div class="empty-icon">📅</div>Nothing in the scrapbook yet.</div>';
        return;
      }

      let html = "";
      let lastMonth = "";

      sorted.forEach((e) => {
        const d = getEntryDate(e);
        const monthKey = d ? d.slice(0, 7) : "unknown";
        const monthLabel = d
          ? new Date(d + "T00:00:00").toLocaleDateString("en-GB", { month: "long", year: "numeric" })
          : "Undated";

        if (monthKey !== lastMonth) {
          html += `<div class="timeline-month-header">${escapeHtml(monthLabel)}</div>`;
          lastMonth = monthKey;
        }

        const cat = e.category;
        const icon = getCatIcon(cat);
        const name = getEntryName(e);
        const badge = cat === "restaurant"
          ? '<span class="entry-badge badge-restaurant">Restaurant</span>'
          : cat === "trip"
          ? '<span class="entry-badge badge-trip">Trip</span>'
          : `<span class="entry-badge badge-media">${escapeHtml(e.mediaType === "series" ? "Series" : "Movie")}</span>`;

        let detail = "";
        if (cat === "restaurant") {
          const parts = [];
          if (e.location) parts.push(escapeHtml(e.location));
          if (e.cuisine) parts.push(escapeHtml(e.cuisine));
          if (e.rating) parts.push("★".repeat(e.rating));
          detail = parts.join(" · ");
        } else if (cat === "trip") {
          const parts = [];
          if (e.dateFrom && e.dateTo) parts.push(`${formatDate(e.dateFrom)} → ${formatDate(e.dateTo)}`);
          if (e.highlights) parts.push(escapeHtml(e.highlights));
          detail = parts.join(" · ");
        } else {
          const parts = [];
          if (e.mediaType) parts.push(e.mediaType === "series" ? "Series" : "Movie");
          if (e.rating) parts.push("★".repeat(e.rating));
          detail = parts.join(" · ");
        }

        html += `
          <div class="timeline-item cat-${cat}">
            <div class="timeline-card">
              <div class="timeline-date">${d ? escapeHtml(formatDate(d)) : "No date"} ${icon}</div>
              ${badge}
              <div class="timeline-title">${escapeHtml(name)}</div>
              ${detail ? `<div class="timeline-detail">${detail}</div>` : ""}
              ${e.notes ? `<div class="timeline-detail" style="margin-top:0.2rem;color:#888;font-style:italic">${escapeHtml(e.notes)}</div>` : ""}
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
    }

    function openEdit(entry) {
      currentEditEntry = entry;
      const cat = entry.category;
 
      document.getElementById("editFormRestaurant").style.display = cat === "restaurant" ? "" : "none";
      document.getElementById("editFormTrip").style.display = cat === "trip" ? "" : "none";
      document.getElementById("editFormMedia").style.display = cat === "media" ? "" : "none";
 
      const titles = { restaurant: "✏️ Edit restaurant", trip: "✏️ Edit trip", media: "✏️ Edit movie / series" };
      document.getElementById("editModalTitle").textContent = titles[cat] || "✏️ Edit entry";
      if (cat === "restaurant") {
        document.getElementById("eName").value = entry.name || "";
        document.getElementById("eLocation").value = entry.location || "";
        document.getElementById("eCuisine").value = entry.cuisine || "";
        document.getElementById("eRDate").value = entry.date || "";
        document.getElementById("eRNotes").value = entry.notes || "";
        editStarRatings.eRStars = entry.rating || 0;
        updateStars(document.getElementById("eRStars"), editStarRatings.eRStars);
      } else if (cat === "trip") {
        document.getElementById("eDest").value = entry.destination || "";
        document.getElementById("eDateFrom").value = entry.dateFrom || "";
        document.getElementById("eDateTo").value = entry.dateTo || "";
        document.getElementById("eHighlights").value = entry.highlights || "";
        document.getElementById("eTNotes").value = entry.notes || "";
      } else {
        document.getElementById("eTitle").value = entry.title || "";
        document.getElementById("eType").value = entry.mediaType || "movie";
        document.getElementById("eDateWatched").value = entry.dateWatched || "";
        document.getElementById("eMNotes").value = entry.notes || "";
        editStarRatings.eMStars = entry.rating || 0;
        updateStars(document.getElementById("eMStars"), editStarRatings.eMStars);
      }
      document.getElementById("editModal").style.display = "block";
    }
    function closeEditModal() {
      document.getElementById("editModal").style.display = "none";
      currentEditEntry = null;
    }
 
    document.getElementById("btnEditCancel").addEventListener("click", closeEditModal);
 
    document.getElementById("editModal").addEventListener("click", (e) => {
      if (e.target === document.getElementById("editModal")) closeEditModal();
    });
 
    document.getElementById("btnEditSave").addEventListener("click", () => {
      if (!currentEditEntry) return;
      const cat = currentEditEntry.category;
      const id = currentEditEntry.id;
      let data;
 
      if (cat === "restaurant") {
        data = {
          name: document.getElementById("eName").value.trim(),
          location: document.getElementById("eLocation").value.trim(),
          cuisine: document.getElementById("eCuisine").value.trim(),
          date: document.getElementById("eRDate").value,
          rating: editStarRatings.eRStars,
          notes: document.getElementById("eRNotes").value.trim(),
        };
      } else if (cat === "trip") {
        data = {
          destination: document.getElementById("eDest").value.trim(),
          dateFrom: document.getElementById("eDateFrom").value,
          dateTo: document.getElementById("eDateTo").value,
          highlights: document.getElementById("eHighlights").value.trim(),
          notes: document.getElementById("eTNotes").value.trim(),
        };
      } else {
        data = {
          title: document.getElementById("eTitle").value.trim(),
          mediaType: document.getElementById("eType").value,
          dateWatched: document.getElementById("eDateWatched").value,
          rating: editStarRatings.eMStars,
          notes: document.getElementById("eMNotes").value.trim(),
        };
      }
 
      closeEditModal();
      updateEntry(id, data);
    });
 
    async function updateEntry(id, data) {
      try {
        await callContent({ type: "tracker", action: "update", id, data });
        await loadEntries();
      } catch (err) {
        alert("Could not update: " + err.message);
      }
    }

    // ── Add entry ──
    document.getElementById("btnAdd").addEventListener("click", async () => {
      const btn = document.getElementById("btnAdd");
      btn.disabled = true;

      try {
        let data;

        if (currentCat === "restaurant") {
          const name = document.getElementById("rName").value.trim();
          if (!name) { alert("Please enter a name."); return; }
          data = {
            category: "restaurant",
            name,
            location: document.getElementById("rLocation").value.trim(),
            cuisine: document.getElementById("rCuisine").value.trim(),
            date: document.getElementById("rDate").value,
            rating: starRatings.rStars,
            notes: document.getElementById("rNotes").value.trim(),
          };
        } else if (currentCat === "trip") {
          const dest = document.getElementById("tDest").value.trim();
          if (!dest) { alert("Please enter a destination."); return; }
          data = {
            category: "trip",
            destination: dest,
            dateFrom: document.getElementById("tFrom").value,
            dateTo: document.getElementById("tTo").value,
            highlights: document.getElementById("tHighlights").value.trim(),
            notes: document.getElementById("tNotes").value.trim(),
          };
        } else {
          const title = document.getElementById("mTitle").value.trim();
          if (!title) { alert("Please enter a title."); return; }
          data = {
            category: "media",
            title,
            mediaType: document.getElementById("mType").value,
            dateWatched: document.getElementById("mDate").value,
            rating: starRatings.mStars,
            notes: document.getElementById("mNotes").value.trim(),
          };
        }

        await callContent({ type: "tracker", action: "add", data });
        clearForm();
        await loadEntries();
      } catch (err) {
        alert("Could not add entry: " + err.message);
      } finally {
        btn.disabled = false;
      }
    });

    function clearForm() {
      document.querySelectorAll(".add-card input, .add-card textarea").forEach((el) => { el.value = ""; });
      document.getElementById("mType").value = "movie";
      starRatings.rStars = 0;
      starRatings.mStars = 0;
      document.querySelectorAll(".star-input").forEach((c) => updateStars(c, 0));
    }

    // ── Load ──
    async function loadEntries() {
      try {
        const data = await callContent({ type: "tracker", action: "list" });
        allEntries = Array.isArray(data?.entries) ? data.entries : [];
        allEntries.sort((a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0));
        switchView();
      } catch (err) {
        console.error("Failed to load tracker entries:", err);
        document.getElementById("entriesGrid").innerHTML =
          '<div class="empty-state">Could not load entries.</div>';
      }
    }

    loadEntries();
  </script>
</body>
</html>
